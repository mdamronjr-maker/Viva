---
const path = Astro.url.pathname;
const pathKey = path === '/' ? '/' : path.replace(/\/+$/, '');
const isActive = (p: string) => pathKey === p || (p !== '/' && pathKey.startsWith(p));
const onStart = pathKey === '/start';
const bookingHref = onStart
  ? 'https://vivawellnessco.glossgenius.com/services?utm_source=vivawellnessco&utm_medium=cta&utm_content=header_start'
  : '/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=header_nav';
---

<header class:list={["site-header", path === '/' && 'site-header--home']}>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Viva Wellness Co. · home">
      <img
        src={pathKey === '/' ? '/viva-logo-paper-cropped.png' : '/viva-logo-ink-cropped.png'}
        alt="Viva Wellness Co."
        class="brand__logo"
        width="1130"
        height="212"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      <a href="/" class:list={["nav__link", isActive('/') && 'is-active']} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href="/services/" class:list={["nav__link", isActive('/services') && 'is-active']} aria-current={isActive('/services') ? 'page' : undefined}>Care &amp; pricing</a>
      <a href="/menopause/" class:list={["nav__link", isActive('/menopause') && 'is-active']} aria-current={isActive('/menopause') ? 'page' : undefined}>Menopause</a>
      <a href="/about/" class:list={["nav__link", isActive('/about') && 'is-active']} aria-current={isActive('/about') ? 'page' : undefined}>About Liliana</a>
      <a href="/blog/" class:list={["nav__link", isActive('/blog') && 'is-active']} aria-current={isActive('/blog') ? 'page' : undefined}>Resources</a>
      <a href="/contact/" class:list={["nav__link", isActive('/contact') && 'is-active']} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
    </nav>

    <a href={bookingHref} target={onStart ? '_blank' : undefined} rel={onStart ? 'noopener' : undefined} class="btn btn--bronze nav__cta">
      Book your first visit
    </a>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-mobile-nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(18px) saturate(125%);
    background: rgba(246, 240, 228, 0.94);
    border-bottom: 1px solid var(--rule);
  }
  .site-header--home {
    position: absolute;
    left: 0;
    right: 0;
    color: var(--cream-bright);
    background-color: var(--evergreen-deep);
    background-image: linear-gradient(180deg, rgba(8, 34, 23, 0.42), rgba(8, 34, 23, 0));
    border-bottom-color: transparent;
    backdrop-filter: none;
  }
  .site-header--home .nav__link {
    color: var(--cream-bright);
  }
  .site-header--home .nav__link::after { background: var(--ochre); }
  .site-header--home .nav__link:hover,
  .site-header--home .nav__link.is-active { color: var(--ochre); }
  .site-header--home .nav-toggle span { background: var(--cream-bright); }
  .site-header--home .nav__cta {
    color: var(--evergreen-deep);
    background: var(--ochre);
    border-color: transparent;
  }
  .site-header--home .nav__cta:hover { background: var(--butter-bright); }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 2rem;
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .brand__logo {
    height: 40px;
    width: auto;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  @media (max-width: 540px) {
    .brand__logo { height: 34px; }
  }
  .nav {
    display: flex;
    gap: 1.1rem;
    justify-content: center;
  }
  .nav__link {
    font-family: var(--font-body);
    font-size: 0.83rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    color: var(--paper);
    white-space: nowrap;
    padding: 0.4rem 0;
    position: relative;
    transition: color 200ms var(--ease);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease);
  }
  .nav__link:hover { color: var(--terracotta); }
  .nav__link:hover::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link.is-active { color: var(--evergreen); }
  .nav__cta { padding: 0.75rem 1.1rem; white-space: nowrap; letter-spacing: 0.08em; }

  .nav-toggle { display: none; }

  @media (max-width: 1120px) {
    .site-header__inner { grid-template-columns: auto 1fr auto; }
    .nav { display: none; }
    /* The full-size booking action and hamburger must never share the
       collapsed header. Safari can temporarily report a wider layout
       viewport while its browser chrome is changing; tying both states to
       the same breakpoint keeps the button from being placed off-canvas. */
    .nav__cta { display: none; }
    .nav-toggle {
      display: grid; gap: 5px;
      width: 44px; height: 44px;
      align-content: center; justify-content: center;
    }
    .nav-toggle span {
      display: block; width: 22px; height: 1.5px; background: var(--paper);
      transition: transform 240ms var(--ease), opacity 200ms var(--ease);
      transform-origin: center;
    }
    :global(body.menu-open) .nav-toggle span:first-child {
      transform: translateY(3.25px) rotate(45deg);
    }
    :global(body.menu-open) .nav-toggle span:last-child {
      transform: translateY(-3.25px) rotate(-45deg);
    }
  }
  /* Mobile action layout. The header CTA is already removed at the same
     breakpoint that enables the hamburger above. */
  @media (max-width: 720px) {
    .site-header__inner { grid-template-columns: auto 1fr auto; }
  }

  /* Mobile menu open */
  :global(body.menu-open) .site-mobile-nav {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
</style>

<nav class="site-mobile-nav" id="site-mobile-nav" aria-label="Mobile" inert>
  <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
  <a href="/services/" aria-current={isActive('/services') ? 'page' : undefined}>Care &amp; pricing</a>
  <a href="/menopause/" aria-current={isActive('/menopause') ? 'page' : undefined}>Menopause</a>
  <a href="/about/" aria-current={isActive('/about') ? 'page' : undefined}>About Liliana</a>
  <a href="/partners/" aria-current={isActive('/partners') ? 'page' : undefined}>Partners</a>
  <a href="/blog/" aria-current={isActive('/blog') ? 'page' : undefined}>Resources</a>
  <a href="/contact/" aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
  <a href={bookingHref} target={onStart ? '_blank' : undefined} rel={onStart ? 'noopener' : undefined} class="mobile-cta">Book your first visit</a>
</nav>

<style>
  .site-mobile-nav {
    position: fixed;
    inset: 76px 0 0 0;
    z-index: 90;
    background: var(--evergreen-deep);
    color: var(--cream-bright);
    /* Moving this panel by -110% did not guarantee that it cleared the top
       of a short iOS visual viewport because the panel itself begins 76px
       below the viewport. A hidden state must also prevent painting and hit
       testing; the larger translation is a defensive geometry fallback. */
    transform: translateY(calc(-100% - 76px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 360ms var(--ease),
      opacity 180ms var(--ease),
      visibility 0s linear 360ms;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 2.5rem var(--gutter);
    border-bottom: 1px solid rgba(255, 250, 241, 0.18);
    /* Scroll when the links + CTA are taller than the viewport (short/landscape
       phones), so the bottom links and the Start CTA stay reachable. */
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .site-mobile-nav a {
    font-family: var(--font-display);
    font-size: 1.9rem;
    letter-spacing: -0.018em;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(255, 250, 241, 0.14);
  }
  .mobile-cta {
    margin-top: 1.5rem;
    color: var(--evergreen-deep);
    background: var(--ochre);
    border: 0 !important;
    border-radius: var(--radius-pill);
    font-family: var(--font-body) !important;
    font-size: 1rem !important;
    font-weight: 650;
    text-align: center;
    padding: 0.9rem 1.2rem !important;
  }
  @media (min-width: 1121px) { .site-mobile-nav { display: none; } }
</style>

<script>
  // Re-bind on every page navigation so view transitions work cleanly.
  // Element-level listeners die with the DOM; document-level keydown is bound
  // once via a module-scoped flag to avoid accumulating duplicates.
  let escBound = false;

  function bindHeader() {
    const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
    const mobileNav = document.getElementById('site-mobile-nav');
    if (!toggle || !mobileNav) return;

    // Background regions to make inert while the full-screen menu is open, so
    // keyboard/SR focus can't escape behind the opaque overlay.
    const bg = () => [document.querySelector('main'), document.querySelector('.site-footer')];

    function setOpen(open: boolean) {
      document.body.classList.toggle('menu-open', open);
      toggle!.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        mobileNav!.removeAttribute('inert');
        bg().forEach((el) => el?.setAttribute('inert', ''));
      } else {
        mobileNav!.setAttribute('inert', '');
        bg().forEach((el) => el?.removeAttribute('inert'));
      }
    }

    toggle.addEventListener('click', () => {
      setOpen(!document.body.classList.contains('menu-open'));
    });
    mobileNav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );

    if (!escBound) {
      escBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !document.body.classList.contains('menu-open')) return;
        document.body.classList.remove('menu-open');
        const t = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
        t?.setAttribute('aria-expanded', 'false');
        document.getElementById('site-mobile-nav')?.setAttribute('inert', '');
        // Mirror setOpen's cleanup: this handler bypasses setOpen (stale-closure
        // guard), so clear the background inert here too or the page stays locked.
        document.querySelector('main')?.removeAttribute('inert');
        document.querySelector('.site-footer')?.removeAttribute('inert');
        t?.focus();
      });
    }
  }

  // Astro fires astro:page-load on initial load AND every router navigation
  document.addEventListener('astro:page-load', bindHeader);
</script>
