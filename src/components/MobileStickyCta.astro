---
// Mobile-only sticky bottom CTA. Hides on routes where it would
// duplicate the page's primary action.
// Strip trailing slash for matching (Astro emits both /contact and /contact/)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideOn = ['/privacy', '/terms'];
const hide = hideOn.includes(path);
// On /start the bar used to link back to /start (a loop). Send the primary
// action straight to the scheduler there instead.
const onStart = path === '/start';
const primaryHref = onStart
  ? 'https://vivawellnessco.glossgenius.com/services?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky_start'
  : '/start?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky';
---

{!hide && (
  <div class="msc" aria-label="Quick actions">
    <a
      href={primaryHref}
      target={onStart ? '_blank' : undefined}
      rel={onStart ? 'noopener' : undefined}
      class="msc__btn msc__btn--bronze"
    >
      {onStart ? 'Schedule now' : 'Book a visit'}
    </a>
    <a href="/#quiz" class="msc__btn msc__btn--ghost">Take the quiz</a>
  </div>
)}

<style>
  .msc {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 80;
    padding: 0.7rem var(--gutter) calc(0.7rem + env(safe-area-inset-bottom));
    gap: 0.6rem;
    background: rgba(247, 242, 233, 0.92);
    backdrop-filter: blur(14px) saturate(140%);
    border-top: 1px solid var(--rule-strong);
  }
  @media (max-width: 720px) {
    .msc { display: flex; }
    /* Reserve space at page bottom so the CTA never covers final content.
       Must match the bar's rendered height (~80px: 0.7rem top pad + ~55px
       button row + 0.7rem bottom pad + 1px border) or the bar overlaps the
       last sliver of footer content. The env() term mirrors the bar's own
       bottom padding so the reserve tracks the safe-area inset too. */
    /* Only reserve space when the bar is actually rendered (it's hidden on
       /privacy and /terms) — otherwise those pages get an empty bottom band. */
    :global(body:has(.msc)) { padding-bottom: calc(84px + env(safe-area-inset-bottom)); }
  }
  .msc__btn {
    flex: 1;
    text-align: center;
    padding: 0.85rem 0.6rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    letter-spacing: 0.01em;
    font-weight: 500;
    border: 1px solid currentColor;
    transition: background 220ms var(--ease), color 220ms var(--ease);
  }
  .msc__btn--bronze {
    background: var(--butter);
    color: var(--paper);
    border-color: var(--bronze-bright);
  }
  .msc__btn--ghost {
    background: transparent;
    color: var(--paper);
    border-color: rgba(43, 37, 29, 0.55);
  }
  /* Tap states */
  .msc__btn--bronze:active { background: var(--butter-bright); border-color: var(--bronze-bright); }
  .msc__btn--ghost:active { background: rgba(43, 37, 29, 0.08); }

  /* Hide when mobile nav is open so it doesn't fight the menu */
  :global(body.menu-open) .msc { display: none; }
</style>
