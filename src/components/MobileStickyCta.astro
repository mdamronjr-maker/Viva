---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideOn = ['/contact', '/privacy', '/terms', '/notice', '/accessibility', '/unsubscribe', '/404'];
const hide = hideOn.some((route) => path === route || path.startsWith(`${route}/`));
const onStart = path === '/start';
const primaryHref = onStart
  ? 'https://vivawellnessco.glossgenius.com/services?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky_start'
  : '/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky';
---

{!hide && (
  <div class="msc" role="region" aria-label="Book a visit" aria-hidden="true" inert>
    <a href={primaryHref} target={onStart ? '_blank' : undefined} rel={onStart ? 'noopener' : undefined} class="msc__btn msc__btn--bronze">
      {onStart ? 'Schedule my visit' : 'Book a visit'}
    </a>
  </div>
)}

<style>
  .msc {
    display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 80;
    padding: 0.5rem var(--gutter) calc(0.5rem + env(safe-area-inset-bottom, 0px));
    background: var(--surface-page); color: var(--text-primary);
    border-top: 1px solid var(--border-control);
    visibility: hidden; opacity: 0; pointer-events: none;
    /* Hidden controls never paint or participate in hit testing. Avoid a
       translated offscreen panel that can surface beneath Safari chrome. */
  }
  @media (max-width: 720px) {
    .msc { display: flex; }
    .msc.is-visible { opacity: 1; visibility: visible; pointer-events: auto; }
  }
  .msc__btn {
    flex: 1; display: flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0.75rem 1rem; text-align: center;
    font-family: var(--font-body); font-size: 1rem; line-height: 1.4;
    letter-spacing: 0; font-weight: 600; border: 1px solid transparent;
    border-radius: var(--radius-pill, 999px); background: var(--action-primary); color: var(--text-primary);
  }
  .msc__btn:hover, .msc__btn:active { background: var(--action-hover); }
  :global(body.menu-open) .msc, :global(body.quiz-focus) .msc { visibility: hidden; opacity: 0; pointer-events: none; }
  :global(html) { scroll-padding-bottom: 5rem; }
</style>

<script>
  let cleanupSticky: (() => void) | undefined;

  function initMobileStickyCta() {
    cleanupSticky?.();
    const bar = document.querySelector<HTMLElement>('.msc');
    if (!bar) return;
    const media = window.matchMedia('(max-width: 720px)');
    const footer = document.querySelector<HTMLElement>('.site-footer');
    const header = document.querySelector<HTMLElement>('.site-header');
    const inlineActions = [...document.querySelectorAll<HTMLAnchorElement>('main a[href]')].filter((link) => {
      const url = new URL(link.href, window.location.href);
      return (url.origin === window.location.origin && /^\/start\/?$/.test(url.pathname)
        || url.hostname === 'vivawellnessco.glossgenius.com')
        && (link.classList.contains('btn') || link.hasAttribute('data-booking-action') || Boolean(link.closest('[data-final-cta]')));
    });
    const controller = new AbortController();
    const { signal } = controller;
    let frame = 0;

    const update = () => {
      frame = 0;
      const viewport = window.visualViewport;
      const top = viewport?.offsetTop ?? 0;
      const height = viewport?.height ?? window.innerHeight;
      const bottom = top + height;
      const headerRect = header?.getBoundingClientRect();
      const contentTop = headerRect && headerRect.bottom > top && headerRect.top <= top
        ? headerRect.bottom : top;
      const inlineUsable = inlineActions.find((link) => {
        const rect = link.getBoundingClientRect();
        const style = getComputedStyle(link);
        return style.display !== 'none' && style.visibility !== 'hidden' && !link.closest('[inert], [hidden]')
          && rect.width > 0 && rect.height >= 40 && rect.top >= contentTop
          && rect.bottom <= bottom && rect.left >= 0 && rect.right <= window.innerWidth;
      });
      const footerRect = footer?.getBoundingClientRect();
      const footerNear = Boolean(footerRect && footerRect.top <= bottom + 72 && footerRect.bottom > top);
      const activeElement = document.activeElement;
      const inputFocused = activeElement instanceof HTMLElement && activeElement.matches('input, textarea, select, [contenteditable="true"]');
      const interacting = document.body.classList.contains('menu-open') || document.body.classList.contains('quiz-focus')
        || Boolean(document.querySelector('dialog[open], [aria-modal="true"]:not([hidden]):not([aria-hidden="true"])'));
      const threshold = Math.min(540, height * 0.65);
      const visible = media.matches && window.scrollY >= threshold && !footerNear && !inlineUsable && !interacting && !inputFocused;
      if (!visible && bar.contains(activeElement) && inlineUsable) inlineUsable.focus({ preventScroll: true });
      bar.classList.toggle('is-visible', visible);
      bar.setAttribute('aria-hidden', String(!visible));
      bar.inert = !visible;
    };
    const scheduleUpdate = () => { if (!frame) frame = window.requestAnimationFrame(update); };
    const bodyObserver = new MutationObserver(scheduleUpdate);
    bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
    window.addEventListener('resize', scheduleUpdate, { passive: true, signal });
    window.addEventListener('pageshow', scheduleUpdate, { signal });
    document.addEventListener('focusin', scheduleUpdate, { signal });
    document.addEventListener('focusout', scheduleUpdate, { signal });
    media.addEventListener('change', scheduleUpdate, { signal });
    window.visualViewport?.addEventListener('resize', scheduleUpdate, { passive: true, signal });
    window.visualViewport?.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
    document.addEventListener('astro:before-swap', () => { bar.inert = true; bar.setAttribute('aria-hidden', 'true'); bar.classList.remove('is-visible'); }, { signal });
    update();
    bar.dataset.stickyReady = 'true';
    cleanupSticky = () => { if (frame) window.cancelAnimationFrame(frame); bodyObserver.disconnect(); controller.abort(); delete bar.dataset.stickyReady; };
  }

  document.addEventListener('astro:page-load', initMobileStickyCta);
</script>
