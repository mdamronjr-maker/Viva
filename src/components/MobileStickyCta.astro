---
// Mobile-only sticky bottom CTA. Hides on routes where it would
// duplicate the page's primary action.
// Strip trailing slash for matching (Astro emits both /contact and /contact/)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideOn = ['/contact', '/privacy', '/terms', '/unsubscribe'];
const hide = hideOn.includes(path);
// On /start the bar used to link back to /start (a loop). Send the primary
// action straight to the scheduler there instead.
const onStart = path === '/start';
const primaryHref = onStart
  ? 'https://vivawellnessco.glossgenius.com/services?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky_start'
  : '/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=mobile_sticky';
---

{!hide && (
  <div class="msc" aria-label="Quick actions" aria-hidden="true" inert>
    <a
      href={primaryHref}
      target={onStart ? '_blank' : undefined}
      rel={onStart ? 'noopener' : undefined}
      class="msc__btn msc__btn--bronze"
    >
      {onStart ? 'Schedule now' : 'Book first visit'}
    </a>
    <a href="/services/" class="msc__btn msc__btn--ghost">Explore care</a>
  </div>
)}

<style>
  .msc {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 80;
    padding: 0.45rem var(--gutter) calc(0.45rem + env(safe-area-inset-bottom));
    gap: 0.5rem;
    background: rgba(248, 246, 240, 0.96);
    backdrop-filter: blur(14px) saturate(140%);
    border-top: 1px solid var(--rule-strong);
    box-shadow: 0 -10px 32px rgba(12, 51, 35, 0.09);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(calc(100% + env(safe-area-inset-bottom)));
    transition:
      opacity 220ms var(--ease),
      transform 280ms var(--ease),
      visibility 0s linear 280ms;
  }
  @media (max-width: 720px) {
    .msc { display: flex; }
    .msc.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }
  }
  .msc__btn {
    flex: 1;
    text-align: center;
    min-height: 48px;
    padding: 0.68rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    font-weight: 500;
    border: 1px solid currentColor;
    transition: background 220ms var(--ease), color 220ms var(--ease);
  }
  .msc__btn--bronze {
    background: var(--ochre);
    color: var(--evergreen-deep);
    border-color: transparent;
  }
  .msc__btn--ghost {
    background: transparent;
    color: var(--paper);
    border-color: var(--evergreen);
  }
  /* Tap states */
  .msc__btn--bronze:active { background: var(--bronze-deep); border-color: transparent; }
  .msc__btn--ghost:active { background: rgba(23, 75, 51, 0.08); }

  /* Menu state is also enforced in JS so the hidden links leave the focus
     order. This selector prevents a one-frame flash during menu animation. */
  :global(body.menu-open) .msc {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(calc(100% + env(safe-area-inset-bottom)));
  }
</style>

<script>
  // The mobile bar is a continuation action, not part of the opening hero.
  // It appears only after meaningful scroll, leaves the focus tree while
  // hidden, and clears the footer and full-screen navigation.
  function initMobileStickyCta() {
    const previousCleanup = (window as any).__vivaStickyCtaCleanup;
    if (typeof previousCleanup === 'function') previousCleanup();

    const bar = document.querySelector('.msc') as HTMLElement | null;
    if (!bar) return;

    const media = window.matchMedia('(max-width: 720px)');
    const footer = document.querySelector('.site-footer');
    let footerNear = false;
    let frame = 0;

    const setVisible = (visible: boolean) => {
      bar.classList.toggle('is-visible', visible);
      bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
      if (visible) bar.removeAttribute('inert');
      else bar.setAttribute('inert', '');
    };

    const update = () => {
      frame = 0;
      const threshold = Math.min(540, window.innerHeight * 0.65);
      const visible = media.matches
        && window.scrollY >= threshold
        && !footerNear
        && !document.body.classList.contains('menu-open');
      setVisible(visible);
    };

    const scheduleUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };

    const footerObserver = footer
      ? new IntersectionObserver(([entry]) => {
          footerNear = entry.isIntersecting;
          scheduleUpdate();
        }, { rootMargin: '0px 0px 72px 0px' })
      : null;
    if (footer && footerObserver) footerObserver.observe(footer);

    const bodyObserver = new MutationObserver(scheduleUpdate);
    bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    media.addEventListener('change', scheduleUpdate);
    update();

    (window as any).__vivaStickyCtaCleanup = () => {
      if (frame) window.cancelAnimationFrame(frame);
      footerObserver?.disconnect();
      bodyObserver.disconnect();
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
      media.removeEventListener('change', scheduleUpdate);
    };
  }

  document.addEventListener('astro:page-load', initMobileStickyCta);
</script>
