---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <a href="/" class="footer-brand" aria-label="Viva Wellness Co. · home" data-viva-wordmark="full">
          <img
            src="/viva-logo-paper-cropped.png"
            alt="Viva Wellness Co."
            class="footer-brand__logo"
            width="1130"
            height="212"
          />
        </a>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Care</h2>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Care &amp; pricing</a></li>
          <li><a href="/peptide-therapy/">Peptide Therapy</a></li>
          <li><a href="/weight-management/">Weight Management</a></li>
          <li><a href="/menopause/">Menopause Care</a></li>
          <li><a href="/testosterone/">Testosterone Care</a></li>
          <li><a href="/recovery/">Recovery &amp; Longevity</a></li>
          <li><a href="/about/">About Liliana</a></li>
          <li><a href="/partners/">Partners</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Patient resources</h2>
        <ul>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/unsubscribe/">Email Preferences</a></li>
          <li><a href="/notice/">Notice of Privacy Practices</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Contact</h2>
        <ul>
          <li><a href="tel:+17372107283">(737) 210-7283</a></li>
          <li><a href="mailto:info&#64;vivawellnessco.com">info&#64;vivawellnessco.com</a></li>
          <li><a href="https://www.instagram.com/vivawellnessatx" target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Service area</h2>
        <ul class="footer-states">
          <li>Texas</li>
          <li>Colorado</li>
          <li>Florida</li>
          <li>Iowa</li>
        </ul>
        <p class="footer-addr">
          5900 Balcones Dr #19640<br/>
          Austin, TX 78731
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Viva Wellness Co.</span>
      <span class="footer-disclaimer">
        Not medical advice. All therapies require provider review and approval.
        Clinical care happens in the HIPAA-compliant patient portal, not this website.
        Not for emergencies. Call 911.
      </span>
    </div>

    <div class="footer-provider">
      <span class="footer-provider__line">
        <strong>Provider:</strong> Liliana Damron, APRN, FNP-BC
        {/* SHIP BLOCKER: real license numbers required from Liliana before this branch reaches main. Do not invent numbers. */}
        {/* · TX RN License #XXXXXXXX · APRN #XXXXX · NPI #XXXXXXXXXX */}
      </span>
      <span class="footer-provider__line">
        Licensed to practice in Texas, Colorado, Florida, and Iowa. Patients must
        be physically located in a licensure state at the time of visit.
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-inverse); color: var(--text-inverse);
    border-top: 1px solid rgb(247 247 242 / 20%);
    padding: clamp(2rem, 4vw, 3.5rem) 0 1.5rem; margin-top: 0;
    --focus-ring: var(--action-primary);
  }
  .footer-grid {
    display: grid; grid-template-columns: 1.1fr 1.1fr 1.15fr 1.25fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2.5rem); padding-bottom: 2rem;
    border-bottom: 1px solid rgb(247 247 242 / 20%);
  }
  .footer-col { min-width: 0; }
  .footer-brand { display: inline-flex; align-items: center; line-height: 0; max-width: 100%; }
  .footer-brand__logo { width: 160px; height: auto; max-width: 100%; display: block; }
  .footer-h {
    font-family: var(--font-body); font-size: 0.9375rem; line-height: 1.5;
    letter-spacing: 0; text-transform: none; color: var(--text-inverse);
    margin-bottom: 0.65rem; font-weight: 600;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.15rem; }
  .footer-col a {
    display: inline-flex; align-items: center; min-height: 32px;
    color: var(--text-inverse); font-size: 0.9375rem; line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .footer-col a:hover { color: var(--action-primary); text-decoration: underline; text-underline-offset: 0.2em; }
  .footer-states { color: var(--text-inverse); font-size: 0.9375rem; line-height: 1.6; }
  .footer-addr { color: var(--text-inverse); font-size: 0.875rem; line-height: 1.6; margin-top: 1rem; }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap;
    padding-top: 1.5rem; gap: 1rem; font-family: var(--font-body);
    font-size: 0.8125rem; line-height: 1.65; letter-spacing: 0; text-transform: none;
    color: var(--text-inverse);
  }
  .footer-disclaimer { max-width: 65ch; text-align: left; }
  .footer-provider {
    margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgb(247 247 242 / 20%);
    display: flex; flex-direction: column; gap: 0.4rem; font-family: var(--font-body);
    font-size: 0.8125rem; letter-spacing: 0; color: var(--text-inverse); line-height: 1.65;
  }
  .footer-provider__line strong { color: var(--text-inverse); font-weight: 600; margin-right: 0.25rem; }
  @media (max-width: 1120px) {
    .footer-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .footer-col--brand { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.25rem; }
    .footer-col a { min-height: 44px; }
  }
</style>
