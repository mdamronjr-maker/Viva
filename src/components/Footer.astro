---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-col--brand">
        <a href="/" class="footer-brand" aria-label="Viva Wellness Co. · home">
          <img
            src="/viva-logo-powder-v2.png"
            alt="Viva Wellness Co."
            class="footer-brand__logo"
            width="1200"
            height="258"
          />
        </a>
        <div class="footer-badge">
          <span class="footer-badge__ring" aria-hidden="true">VW</span>
          <p class="footer-badge__line">Health is personal.<br/>Your care should be, too.</p>
        </div>
        <a href="/start?utm_source=vivawellnessco&utm_medium=cta&utm_content=footer" class="btn btn--bronze">Book a visit</a>
      </div>

      <div class="footer-col">
        <h4 class="footer-h">Site</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">Provider</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/menopause">Menopause Care</a></li>
          <li><a href="/partners">Partners</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-h">Compliance</h4>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/notice">Notice of Privacy Practices</a></li>
          <li><a href="/accessibility">Accessibility</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-h">Contact</h4>
        <ul>
          <li><a href="tel:+17372107283">(737) 210-7283</a></li>
          <li><a href="mailto:info&#64;vivawellnessco.com">info&#64;vivawellnessco.com</a></li>
          <li><a href="https://www.instagram.com/vivawellnessatx" target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-h">Service Area</h4>
        <ul class="footer-states">
          <li>Texas</li>
          <li>Colorado</li>
          <li>Florida</li>
          <li>Iowa</li>
        </ul>
        <p class="footer-addr">
          5900 Balcones Dr #19640<br/>
          Austin, TX 78731
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Viva Wellness Co.</span>
      <span class="footer-disclaimer">
        Not medical advice. All therapies require provider review and approval.
        Clinical care happens in the HIPAA-compliant patient portal, not this website.
        Not for emergencies. Call 911.
      </span>
    </div>

    <div class="footer-provider">
      <span class="footer-provider__line">
        <strong>Provider:</strong> Liliana Damron, APRN, FNP-BC
        {/* SHIP BLOCKER: real license numbers required from Liliana before this branch reaches main. Do not invent numbers. */}
        {/* · TX RN License #XXXXXXXX · APRN #XXXXX · NPI #XXXXXXXXXX */}
      </span>
      <span class="footer-provider__line">
        Licensed to practice in Texas, Colorado, Florida, and Iowa. Patients must
        be physically located in a licensure state at the time of visit.
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--sky);
    border-top: 1px solid var(--rule-strong);
    padding: clamp(3rem, 7vw, 5rem) 0 2rem;
    margin-top: 0;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 1000px) {
    .footer-grid { grid-template-columns: 1fr 1fr 1fr; gap: 2.5rem; }
    .footer-col--brand { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  .footer-brand {
    display: inline-flex;
    align-items: center;
    margin-bottom: 1.4rem;
    line-height: 0;
  }
  .footer-brand__logo {
    height: 32px;
    width: auto;
    display: block;
  }
  .footer-badge { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .footer-badge__ring {
    width: 64px; height: 64px; border-radius: 50%;
    border: 1.5px solid var(--sky-deep);
    display: grid; place-items: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--paper);
    flex-shrink: 0;
  }
  .footer-badge__line {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--paper);
    margin: 0;
    max-width: 20ch;
  }
  .footer-h {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.55rem; }
  .footer-col a {
    color: rgba(46, 52, 56, 0.85);
    transition: color 180ms var(--ease);
    font-size: 0.95rem;
  }
  .footer-col a:hover { color: var(--paper); }
  .footer-states { color: rgba(46, 52, 56, 0.85); font-size: 0.95rem; }
  .footer-addr {
    color: rgba(46, 52, 56, 0.75);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .footer-disclaimer { max-width: 56ch; text-align: right; }
  @media (max-width: 720px) {
    .footer-disclaimer { text-align: left; }
  }
  .footer-provider {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: rgba(46, 52, 56, 0.68);
    line-height: 1.6;
    text-transform: none;
  }
  .footer-provider__line strong {
    color: rgba(46, 52, 56, 0.78);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 0.4rem;
  }
</style>
