---
interface Props {
  variant?: 'solid' | 'outline';
}

const { variant = 'outline' } = Astro.props;
---

<svg
  class:list={['viva-monogram', `viva-monogram--${variant}`]}
  viewBox="0 0 128 128"
  aria-hidden="true"
  focusable="false"
  data-viva-monogram={variant}
>
  <circle class="viva-monogram__field" cx="64" cy="64" r="60" />
  <circle class="viva-monogram__outer" cx="64" cy="64" r="59" />
  <circle class="viva-monogram__inner" cx="64" cy="64" r="51" />
  <path class="viva-monogram__v" d="M25 38 43 92 64 38" />
  <path class="viva-monogram__w" d="M56 38 68 92 80 61 91 92 104 38" />
  <circle class="viva-monogram__dot" cx="101" cy="26" r="4.5" />
</svg>

<style>
  .viva-monogram {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    shape-rendering: geometricPrecision;
  }
  .viva-monogram__outer,
  .viva-monogram__inner,
  .viva-monogram__v,
  .viva-monogram__w {
    fill: none;
  }
  .viva-monogram__outer,
  .viva-monogram__inner {
    stroke-width: 2;
  }
  .viva-monogram__v,
  .viva-monogram__w {
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .viva-monogram__v { stroke-width: 7; }
  .viva-monogram__w { stroke-width: 5; }

  .viva-monogram--solid .viva-monogram__field { fill: var(--terracotta); }
  .viva-monogram--solid .viva-monogram__outer { stroke: rgba(255, 253, 248, 0.88); }
  .viva-monogram--solid .viva-monogram__inner { stroke: rgba(12, 51, 35, 0.34); }
  .viva-monogram--solid .viva-monogram__v { stroke: var(--evergreen-deep); }
  .viva-monogram--solid .viva-monogram__w { stroke: var(--cream-bright); }
  .viva-monogram--solid .viva-monogram__dot { fill: var(--cream-bright); }

  .viva-monogram--outline .viva-monogram__field { fill: rgba(255, 253, 248, 0.025); }
  .viva-monogram--outline .viva-monogram__outer { stroke: var(--terracotta); }
  .viva-monogram--outline .viva-monogram__inner { stroke: rgba(255, 253, 248, 0.24); }
  .viva-monogram--outline .viva-monogram__v { stroke: var(--cream-bright); }
  .viva-monogram--outline .viva-monogram__w { stroke: var(--terracotta); }
  .viva-monogram--outline .viva-monogram__dot { fill: var(--terracotta); }
</style>
