---
import Layout from '../layouts/Layout.astro';

type ContentItem = { title: string; body: string };
type Plan = { name: string; price: string; href: string; note: string };
type Source = { label: string; href: string };
type Faq = { q: string; a: string };
type RelatedResource = { title: string; href: string; description: string };

interface Props {
  path: string;
  serviceName: string;
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  accent: string;
  intro: string;
  decisionTitle: string;
  decisions: ContentItem[];
  visitItems: ContentItem[];
  safetyTitle: string;
  safetyItems: string[];
  plans: Plan[];
  sources?: Source[];
  faqEyebrow?: string;
  faqTitle?: string;
  faqs?: Faq[];
  relatedResources?: RelatedResource[];
}

const {
  path,
  serviceName,
  title,
  description,
  eyebrow,
  headline,
  accent,
  intro,
  decisionTitle,
  decisions,
  visitItems,
  safetyTitle,
  safetyItems,
  plans,
  sources = [],
  faqEyebrow = 'Common questions',
  faqTitle = 'Questions to ask before deciding.',
  faqs = [],
  relatedResources = [],
} = Astro.props;

const absolute = `https://vivawellnessco.com${path}/`;
const resolvedServiceName = serviceName;
const schemaGraph = [
    {
      '@type': 'Service',
      '@id': `${absolute}#service`,
      name: resolvedServiceName,
      description,
      url: absolute,
      provider: { '@id': 'https://vivawellnessco.com/#organization' },
      areaServed: [
        { '@type': 'State', name: 'Texas' },
        { '@type': 'State', name: 'Colorado' },
        { '@type': 'State', name: 'Florida' },
        { '@type': 'State', name: 'Iowa' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${absolute}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Care and pricing', item: 'https://vivawellnessco.com/services/' },
        { '@type': 'ListItem', position: 3, name: resolvedServiceName, item: absolute },
      ],
    },
    ...(faqs.length > 0 ? [{
      '@type': 'FAQPage',
      '@id': `${absolute}#faq`,
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    }] : []),
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---

<Layout title={title} description={description} schema={schema}>
  <section class="care-hero">
    <div class="container care-hero__inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Care and pricing</a><span aria-hidden="true">/</span><span aria-current="page">{serviceName}</span>
      </nav>
      <span class="eyebrow">{eyebrow}</span>
      <h1>{headline}</h1>
      <p class="care-hero__subhead">{accent}</p>
      <p class="care-hero__intro">{intro}</p>
      <p class="care-hero__cost">First visit $199 · $50 deposit due at booking · Membership separate</p>
      <div class="care-hero__ctas">
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=care_detail_hero" class="btn btn--bronze">Book a visit</a>
        <a href="/services/#plans" class="btn">Compare all pricing</a>
      </div>
      <p class="care-hero__boundary">A website cannot determine diagnosis, eligibility, or treatment. Those decisions require an individual visit with Liliana.</p>
    </div>
  </section>

  <section class="section care-decisions">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Make a clear decision</span>
        <h2>{decisionTitle}</h2>
      </div>
      <ul class="care-grid" role="list">
        {decisions.map((item, index) => (
          <li>
            <span class="care-grid__num">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container visit">
      <div class="visit__head">
        <span class="eyebrow">Your first visit</span>
        <h2>What Liliana reviews with you.</h2>
        <p>Bring questions and context. Keep clinical details in the secure intake and patient portal—not the public contact form or regular email.</p>
      </div>
      <ol class="visit__list">
        {visitItems.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3>{item.title}</h3><p>{item.body}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section care-safety">
    <div class="container care-safety__inner">
      <div>
        <span class="eyebrow">Safety and eligibility</span>
        <h2>{safetyTitle}</h2>
      </div>
      <ul>
        {safetyItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container plan-links">
      <div class="section-head">
        <span class="eyebrow">Published pricing</span>
        <h2>Know the price before you book.</h2>
        <p class="lead">These are current monthly membership prices. The first visit is a separate $199 appointment with a $50 deposit due at booking.</p>
      </div>
      <ul role="list">
        {plans.map((plan) => (
          <li>
            <div><h3>{plan.name}</h3><p>{plan.note}</p></div>
            <strong>{plan.price}<small>/mo</small></strong>
            <a href={plan.href}>See full inclusions <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {sources.length > 0 && (
    <section class="sources">
      <div class="container sources__inner">
        <h2>Information sources</h2>
        <p>These links support the general educational and regulatory information on this page. They do not replace individualized medical advice.</p>
        <ul>
          {sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener">{source.label}</a></li>)}
        </ul>
      </div>
    </section>
  )}

  {faqs.length > 0 && (
    <section class="section care-faq" aria-labelledby="care-faq-title">
      <div class="container care-faq__inner">
        <div class="section-head">
          <span class="eyebrow">{faqEyebrow}</span>
          <h2 id="care-faq-title">{faqTitle}</h2>
        </div>
        <dl class="care-faq__list">
          {faqs.map((faq) => (
            <div>
              <dt>{faq.q}</dt>
              <dd>{faq.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {relatedResources.length > 0 && (
    <section class="section care-reading" aria-labelledby="care-reading-title">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Explore your questions</span>
          <h2 id="care-reading-title">Related reading and resources.</h2>
        </div>
        <ul class="care-reading__list" role="list">
          {relatedResources.map((resource) => (
            <li><h3><a href={resource.href}>{resource.title} <span aria-hidden="true">→</span></a></h3><p>{resource.description}</p></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="care-end" data-final-cta>
    <div class="container care-end__inner">
      <div><span class="eyebrow">Your next step</span><h2>Bring your questions to Liliana.</h2></div>
      <div class="care-end__action">
        <p>Liliana reviews whether Viva fits, what information is needed, and what happens if a requested option is not appropriate.</p>
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=care_detail_end" class="btn btn--bronze">Book a visit</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .care-hero { background: var(--surface-page); color: var(--text-primary); border-bottom: 1px solid var(--border-subtle); padding: clamp(2.5rem, 5vw, 4.5rem) 0; }
  .care-hero__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .9375rem; color: var(--text-secondary); margin-bottom: .5rem; }
  .breadcrumbs a, .sources a { text-decoration: underline; text-underline-offset: .2em; }
  .care-hero h1 { max-width: 23ch; font-size: var(--text-h1); line-height: 1.1; }
  .care-hero__subhead { font-size: clamp(1.25rem, 2.2vw, 1.625rem); font-weight: 600; max-width: 44ch; line-height: 1.35; }
  .care-hero__intro { max-width: 66ch; color: var(--text-secondary); font-size: 1.0625rem; line-height: 1.6; }
  .care-hero__cost { font-size: .9375rem; font-weight: 600; margin-top: .5rem; }
  .care-hero__ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .care-hero__boundary { font-size: .9375rem; color: var(--text-secondary); border-top: 1px solid var(--border-subtle); padding-top: 1rem; max-width: 72ch; }
  .section-head { max-width: 760px; margin-bottom: 2rem; }
  .section-head h2 { margin: .5rem 0 .75rem; }
  .care-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .care-grid li { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius); padding: clamp(1.25rem, 2.5vw, 2rem); }
  .care-grid__num { color: var(--text-secondary); font-weight: 600; font-size: .9375rem; }
  .care-grid h3 { margin: 1rem 0 .65rem; font-size: var(--text-h3); }
  .care-grid p, .visit p { color: var(--text-secondary); line-height: 1.6; }
  .visit { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); }
  .visit__head h2 { margin: .5rem 0 1rem; }
  .visit__list { display: grid; gap: 0; }
  .visit__list li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--border-subtle); }
  .visit__list > li > span { color: var(--text-secondary); font-weight: 600; }
  .visit__list h3 { font-size: 1.25rem; margin-bottom: .5rem; }
  .care-safety { background: var(--surface-subtle); }
  .care-safety__inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); }
  .care-safety h2 { margin-top: .5rem; }
  .care-safety ul { display: grid; gap: 1rem; padding-left: 1.25rem; list-style: disc; }
  .care-safety li { color: var(--text-primary); line-height: 1.6; }
  .plan-links > ul { display: grid; gap: 1rem; }
  .plan-links > ul > li { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 1.5rem; align-items: center; background: var(--surface-card); border: 1px solid var(--border-subtle); padding: 1.5rem; border-radius: var(--radius); }
  .plan-links h3 { font-size: 1.25rem; margin-bottom: .35rem; }
  .plan-links p { color: var(--text-secondary); }
  .plan-links strong { font-size: 2rem; font-weight: 600; white-space: nowrap; }
  .plan-links small { font-size: 1rem; font-weight: 400; color: var(--text-secondary); }
  .plan-links a { font-weight: 600; text-decoration: underline; text-underline-offset: .2em; }
  .sources { padding: 2rem 0; background: var(--surface-page); border-top: 1px solid var(--border-subtle); }
  .sources h2 { font-size: 1.25rem; }
  .sources p { color: var(--text-secondary); margin: .75rem 0 1rem; max-width: 72ch; }
  .sources ul { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; font-size: .9375rem; }
  .care-faq { background: var(--surface-page); }
  .care-faq__list { border-top: 1px solid var(--border-subtle); }
  .care-faq__list > div { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 3rem); padding: 1.5rem 0; border-bottom: 1px solid var(--border-subtle); }
  .care-faq dt { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .care-faq dd { color: var(--text-secondary); line-height: 1.6; }
  .care-reading { border-top: 1px solid var(--border-subtle); }
  .care-reading__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .care-reading__list li { padding: 1.5rem; border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .care-reading__list h3 { font-size: 1.25rem; line-height: 1.4; margin-bottom: .5rem; }
  .care-reading__list a { text-decoration: underline; text-underline-offset: .2em; }
  .care-reading__list p { color: var(--text-secondary); }
  .care-end { background: var(--surface-inverse); color: var(--text-inverse); padding: var(--section-pad) 0; --focus-ring: var(--action-primary); }
  .care-end .eyebrow { color: var(--action-primary); }
  .care-end__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .care-end h2 { margin-top: .5rem; }
  .care-end__action p { color: var(--text-inverse); margin-bottom: 1.5rem; }
  @media (max-width: 820px) {
    .care-grid, .visit, .care-safety__inner, .care-end__inner { grid-template-columns: 1fr; }
    .care-faq__list > div { grid-template-columns: 1fr; gap: .75rem; }
    .plan-links > ul > li { grid-template-columns: minmax(0, 1fr) auto; }
    .plan-links a { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .care-hero { padding: 2rem 0 2.5rem; }
    .care-hero__ctas { display: grid; grid-template-columns: 1fr; width: 100%; }
    .care-hero__ctas .btn, .care-end .btn { width: 100%; justify-content: center; }
    .care-reading__list, .plan-links > ul > li { grid-template-columns: 1fr; }
    .plan-links > ul > li { padding: 1.25rem; gap: .75rem; }
    .plan-links a { grid-column: auto; }
  }
</style>
