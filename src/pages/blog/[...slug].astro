---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Table of contents · only show for posts with 3+ h2 sections
const tocItems = headings.filter((h) => h.depth === 2);
const showToc = tocItems.length >= 3;

// Reading time: 200 words per minute (average reader)
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const heroSizes: Record<string, { width: number; height: number }> = {
  '/blog/compare-real.webp': { width: 1600, height: 900 },
  '/blog/glp1.webp': { width: 1024, height: 576 },
  '/blog/perimenopause-starts-earlier.webp': { width: 1216, height: 640 },
  '/blog/telehealth.webp': { width: 1024, height: 576 },
  '/blog/the-parent-tax.webp': { width: 1216, height: 608 },
};
const heroSize = post.data.heroImage ? heroSizes[post.data.heroImage] : undefined;
const articleImage = new URL(post.data.heroImage || `/og/blog/${post.id}.png`, Astro.site).href;

// Related posts: same category, exclude self, most recent 2
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

// Link educational questions to the relevant existing care destination.
const careByArticle: Record<string, { href: string; title: string }> = {
  'glp-1-weight-loss-austin': { href: '/weight-management/', title: 'Medical weight management' },
  'tirzepatide-vs-semaglutide': { href: '/weight-management/', title: 'Medical weight management' },
  'perimenopause-starts-earlier': { href: '/menopause/', title: 'Perimenopause and menopause care' },
  'concierge-telehealth-explained': { href: '/services/', title: 'Care and membership pricing' },
  'the-parent-tax': { href: '/services/', title: 'Explore Viva’s care paths' },
};
const relatedCare = careByArticle[post.id];

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `https://vivawellnessco.com/blog/${post.id}/#article`,
      headline: post.data.title,
      description: post.data.description,
      url: `https://vivawellnessco.com/blog/${post.id}/`,
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.modifiedDate || post.data.publishDate).toISOString(),
      image: articleImage,
      articleSection: post.data.category,
      author: {
        '@type': 'Person',
        '@id': 'https://vivawellnessco.com/about/#liliana',
        name: post.data.author,
      },
      publisher: { '@id': 'https://vivawellnessco.com/#organization' },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': `https://vivawellnessco.com/blog/${post.id}/`,
      },
      inLanguage: 'en-US',
      keywords: post.data.keywords,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `https://vivawellnessco.com/blog/${post.id}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://vivawellnessco.com/blog/' },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: `https://vivawellnessco.com/blog/${post.id}/` },
      ],
    },
  ],
};

const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'
});

// Show an "Updated" badge only when modifiedDate is meaningfully after publishDate
const hasUpdate =
  post.data.modifiedDate &&
  post.data.modifiedDate.valueOf() > post.data.publishDate.valueOf();
const formattedUpdate = hasUpdate
  ? post.data.modifiedDate!.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : null;
---

<Layout
  title={`${post.data.title} | Viva`}
  description={post.data.description}
  ogType="article"
  publishDate={post.data.publishDate.toISOString()}
  modifiedDate={(post.data.modifiedDate || post.data.publishDate).toISOString()}
  author={post.data.author}
  schema={articleSchema}
>

  <div class="reading-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-hero">
      <div class="container post-hero__inner">
        <a href="/blog/" class="post-back">← Back to all articles</a>
        <span class="eyebrow">{post.data.category}</span>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
        <div class="post-meta">
          <span class="post-meta__author">{post.data.author}</span>
          <span class="post-meta__sep">·</span>
          <time class="post-meta__date" datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
          <span class="post-meta__sep">·</span>
          <span class="post-meta__read">{readingMinutes} min read</span>
          {hasUpdate && (
            <>
              <span class="post-meta__sep">·</span>
              <span class="post-meta__updated" title={`Updated ${formattedUpdate}`}>Updated {formattedUpdate}</span>
            </>
          )}
        </div>
        <p class="post-disclosure">General education only · Sources are linked in the article · Not individualized medical advice</p>
      </div>
    </header>

    {post.data.heroImage && (
      <div class="container">
        <figure class="post-banner">
          <img
            src={post.data.heroImage}
            alt=""
            width={heroSize?.width}
            height={heroSize?.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </div>
    )}


    {showToc && (
      <nav class="post-toc" aria-label="Article contents">
        <div class="container post-toc__inner">
          <details open>
            <summary class="post-toc__summary">
              <span class="eyebrow">Contents</span>
              <span class="post-toc__count">{tocItems.length} sections</span>
            </summary>
            <ol class="post-toc__list">
              {tocItems.map((h, i) => (
                <li class="post-toc__item">
                  <a href={`#${h.slug}`} class="post-toc__link">
                    <span class="post-toc__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="post-toc__text">{h.text}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </div>
      </nav>
    )}

    <div class="post-body">
      <div class="container post-body__inner">
        <Content />
      </div>
    </div>

    {relatedCare && (
      <aside class="post-care" aria-label="Related care">
        <div class="container post-care__inner">
          <div><span class="eyebrow">Explore care at Viva</span><h2>{relatedCare.title}</h2></div>
          <a href={relatedCare.href} class="btn">See the care path <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    )}

    {related.length > 0 && (
      <aside class="post-related">
        <div class="container post-related__inner">
          <span class="eyebrow">Keep reading</span>
          <h2 class="post-related__title">Related articles</h2>
          <ul class="post-related__list">
            {related.map((r) => (
              <li class="post-related__item">
                <a href={`/blog/${r.id}/`} class="post-related__link">
                  <span class="post-related__cat">{r.data.category}</span>
                  <h3 class="post-related__h">{r.data.title}</h3>
                  <p class="post-related__desc">{r.data.description}</p>
                  <span class="post-related__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}

    <aside class="post-author">
      <div class="container post-author__inner">
        <div class="post-author__media">
          <img
            src="/liliana-founder-portrait-sm.webp"
            alt="Liliana Damron, APRN, FNP-BC"
            width="640"
            height="962"
            loading="lazy"
          />
        </div>
        <div class="post-author__body">
          <span class="eyebrow">About the author</span>
          <p class="post-author__name">
            {post.data.author}
          </p>
          <p class="post-author__bio">
            Liliana Damron is the founder and named provider at Viva Wellness
            Co. Her background includes geriatric medicine. Viva currently
            serves adults in Texas, Colorado, Florida, and Iowa.
          </p>
          <a href="/about/" class="post-author__link">Read about Liliana →</a>
        </div>
      </div>
    </aside>

    <footer class="post-foot" data-final-cta>
      <div class="container post-foot__inner">
        <h2 class="post-foot__title">
          Bring your questions to a visit.
        </h2>
        <p class="lead">
          The first visit is a provider-led evaluation. It does not guarantee
          eligibility, a prescription, or enrollment in a membership.
        </p>
        <div class="post-foot__ctas">
          <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=blog_post_foot" class="btn btn--bronze">Book a visit</a>
        </div>
      </div>
    </footer>
  </article>

</Layout>

<script>
  // Remove prior listeners on every navigation, including routes without an article.
  let rpScroll: (() => void) | undefined;
  function initReadingProgress() {
    if (rpScroll) { window.removeEventListener('scroll', rpScroll); window.removeEventListener('resize', rpScroll); rpScroll = undefined; }
    const bar = document.querySelector('.reading-progress') as HTMLElement | null;
    const article = document.querySelector('.post-body') as HTMLElement | null;
    if (!bar || !article) return;
    let raf = 0;
    function update() {
      const rect = article!.getBoundingClientRect();
      const total = Math.max(1, article!.offsetHeight - window.innerHeight);
      const scrolled = -rect.top;
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      bar!.style.width = pct + '%';
    }
    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(() => { update(); raf = 0; });
    }
    rpScroll = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  document.addEventListener('astro:page-load', initReadingProgress);
</script>

<style is:global>
  .reading-progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: var(--action-primary); z-index: 200; pointer-events: none; }
  .post-hero { padding: clamp(2.5rem, 5vw, 4rem) 0 2rem; }
  .post-hero__inner { max-width: 900px; }
  .post-back { display: inline-block; color: var(--text-secondary); font-size: .9375rem; margin-bottom: 1.5rem; text-decoration: underline; text-underline-offset: .2em; }
  .post-hero .eyebrow { display: block; }
  .post-title { font-size: var(--text-h1); font-weight: 600; line-height: 1.1; letter-spacing: -.025em; margin: .75rem 0 1.25rem; }
  .post-lede { font-size: 1.125rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 66ch; }
  .post-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .6rem; font-size: .9375rem; line-height: 1.5; color: var(--text-secondary); padding-top: 1.25rem; border-top: 1px solid var(--border-subtle); }
  .post-meta__author { color: var(--text-primary); }
  .post-meta__updated { color: var(--text-secondary); }
  .post-disclosure { margin-top: .75rem; color: var(--text-secondary); font-size: .9375rem; max-width: 68ch; }
  .post-banner { margin: 0 auto; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 7; max-width: 820px; }
  .post-banner img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-toc { padding-top: 2rem; }
  .post-toc__inner, .post-body__inner { max-width: 800px; margin: 0 auto; }
  .post-toc details { background: var(--surface-subtle); border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .post-toc__summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.25rem; }
  .post-toc__summary::-webkit-details-marker { display: none; }
  .post-toc__count { font-size: .9375rem; color: var(--text-secondary); white-space: nowrap; }
  .post-toc details[open] .post-toc__count::after { content: ' −'; }
  .post-toc details:not([open]) .post-toc__count::after { content: ' +'; }
  .post-toc__list { margin: 0 1.25rem; padding-bottom: 1rem; border-top: 1px solid var(--border-subtle); }
  .post-toc__item { border-bottom: 1px solid var(--border-subtle); }
  .post-toc__item:last-child { border-bottom: 0; }
  .post-toc__link { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .75rem; padding: .875rem 0; align-items: baseline; }
  .post-toc__link:hover .post-toc__text { text-decoration: underline; text-underline-offset: .2em; }
  .post-toc__num { font-size: .9375rem; color: var(--text-secondary); }
  .post-toc__text { font-size: 1rem; line-height: 1.4; }
  .post-body { padding: 2.5rem 0 var(--section-pad); }
  .post-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.25; margin: 2.5rem 0 1rem; }
  .post-body h2:first-child { margin-top: 0; }
  .post-body h3 { font-size: 1.25rem; font-weight: 600; line-height: 1.3; margin: 2rem 0 .75rem; }
  .post-body p { font-size: 1.0625rem; line-height: 1.7; color: var(--text-primary); margin-bottom: 1.25rem; }
  .post-body p strong { font-weight: 600; }
  .post-body ul, .post-body ol { margin: 1rem 0 1.5rem; padding-left: 1.5rem; }
  .post-body li { font-size: 1.0625rem; line-height: 1.65; margin-bottom: .65rem; }
  .post-body a { text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  .post-body blockquote { border-left: 3px solid var(--border-control); padding: .5rem 0 .5rem 1.25rem; margin: 1.5rem 0; }
  .post-body table { display: block; overflow-x: auto; max-width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  .post-body th, .post-body td { padding: .75rem; border: 1px solid var(--border-subtle); text-align: left; }
  .post-body th { background: var(--surface-subtle); font-weight: 600; }
  .post-care { padding: 2rem 0; background: var(--surface-subtle); }
  .post-care__inner { max-width: 900px; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
  .post-care h2 { font-size: 1.5rem; line-height: 1.3; margin-top: .5rem; }
  .post-care .btn { flex-shrink: 0; }
  .post-related, .post-author { padding: var(--section-pad) 0; border-top: 1px solid var(--border-subtle); }
  .post-related__inner { max-width: 900px; margin: 0 auto; }
  .post-related__title { font-size: var(--text-h2); line-height: 1.2; margin: .5rem 0 1.5rem; }
  .post-related__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .post-related__item { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .post-related__item:hover { border-color: var(--border-control); }
  .post-related__link { display: grid; grid-template-rows: auto auto 1fr auto; gap: .65rem; padding: 1.5rem; height: 100%; }
  .post-related__cat { font-size: .9375rem; color: var(--text-secondary); }
  .post-related__h { font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
  .post-related__desc { color: var(--text-secondary); font-size: 1rem; line-height: 1.6; max-width: 48ch; }
  .post-related__arrow { font-size: 1.4rem; align-self: end; }
  .post-author__inner { max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .post-author__media img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 53%; border-radius: var(--radius); }
  .post-author__body .eyebrow { display: block; margin-bottom: .5rem; }
  .post-author__name { font-size: 1.25rem; font-weight: 600; line-height: 1.4; margin-bottom: .75rem; }
  .post-author__bio { color: var(--text-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: .75rem; }
  .post-author__link { font-size: 1rem; text-decoration: underline; text-underline-offset: .2em; }
  .post-foot { padding: var(--section-pad) 0; background: var(--surface-inverse); color: var(--text-inverse); --focus-ring: var(--action-primary); }
  .post-foot__title { font-size: var(--text-h2); line-height: 1.2; margin-bottom: 1rem; max-width: 26ch; }
  .post-foot .lead { margin-bottom: 1.5rem; max-width: 60ch; color: var(--text-inverse); }
  .post-foot__ctas { display: flex; gap: .75rem; flex-wrap: wrap; }
  @media (max-width: 700px) {
    .post-hero { padding: 2rem 0; }
    .post-related__list { grid-template-columns: 1fr; }
    .post-care__inner { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 480px) {
    .post-author__inner { grid-template-columns: 80px minmax(0, 1fr); gap: 1rem; }
    .post-foot__ctas .btn, .post-care .btn { width: 100%; justify-content: center; }
    .post-body p, .post-body li { font-size: 1rem; }
  }
</style>
