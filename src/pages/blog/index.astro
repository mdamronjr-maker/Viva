---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const heroSizes: Record<string, { width: number; height: number }> = {
  '/blog/compare-real.webp': { width: 1600, height: 900 },
  '/blog/glp1.webp': { width: 1024, height: 576 },
  '/blog/perimenopause-starts-earlier.webp': { width: 1216, height: 640 },
  '/blog/telehealth.webp': { width: 1024, height: 576 },
  '/blog/the-parent-tax.webp': { width: 1216, height: 608 },
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': 'https://vivawellnessco.com/blog/#blog',
      name: 'Viva Wellness Co. Blog',
      description: 'Source-led patient education on telehealth, weight management, menopause, and everyday health.',
      publisher: { '@id': 'https://vivawellnessco.com/#organization' },
      blogPost: posts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `https://vivawellnessco.com/blog/${p.id}/`,
        datePublished: p.data.publishDate.toISOString(),
        author: { '@type': 'Person', name: p.data.author },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://vivawellnessco.com/blog/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://vivawellnessco.com/blog/' },
      ],
    },
  ],
};
---

<Layout
  title="Patient Education | Viva Wellness Co. Blog"
  description="Source-led patient education on concierge telehealth, medical weight management, menopause, medication safety, and realistic care for busy adults."
  schema={blogSchema}
>

  <section class="blog-hero">
    <div class="container blog-hero__inner">
      <span class="eyebrow">Patient education</span>
      <h1 class="blog-hero__title">
        Real answers,<br/>
        <span class="italic-display">written by a clinician.</span>
      </h1>
      <p class="lead">
        Source-led guides to help you ask better questions about telehealth,
        weight management, menopause, medication status, and everyday health.
        General education only, not individualized medical advice.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="post-list">
        {posts.map((post, i) => (
          <li class="post-card">
            <a href={`/blog/${post.id}/`} class="post-card__link">
              <span class="post-card__num">{String(i + 1).padStart(2, '0')}</span>
              <div class="post-card__thumb">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt=""
                    width={heroSizes[post.data.heroImage]?.width}
                    height={heroSizes[post.data.heroImage]?.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <div class="post-card__body">
                <span class="post-card__cat">{post.data.category}</span>
                <h2 class="post-card__title">{post.data.title}</h2>
                <p class="post-card__desc">{post.data.description}</p>
                <div class="post-card__meta">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                  </time>
                  <span class="post-card__author">{post.data.author}</span>
                </div>
              </div>
              <span class="post-card__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .blog-hero {
    padding: var(--section-pad) 0 3rem;
    position: relative;
    overflow: hidden;
  }
  .blog-hero__inner { position: relative; max-width: 900px; }
  .blog-hero__title {
    font-size: var(--text-h1);
    line-height: 1.1;
    letter-spacing: -0.028em;
    margin: 1rem 0 1.5rem;
    max-width: 18ch;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }
  .post-card { border-bottom: 1px solid var(--border-subtle); }
  .post-card__link {
    display: grid;
    grid-template-columns: 2rem 8rem minmax(0, 1fr) 2rem;
    gap: clamp(1rem, 3vw, 2.2rem);
    padding: clamp(1.6rem, 4vw, 2.5rem) 0;
    align-items: center;
    transition: background 220ms var(--ease);
  }
  .post-card__thumb {
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-subtle);
  }
  .post-card__thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 400ms var(--ease);
  }
  .post-card__link:hover .post-card__thumb img { transform: none; }
  .post-card__link:hover { background: var(--surface-subtle); }
  .post-card__num {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-primary);
    letter-spacing: 0;
    align-self: start;
    padding-top: 0.6rem;
  }
  .post-card__cat {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.6rem;
  }
  .post-card__title {
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.8rem;
    max-width: 28ch;
  }
  .post-card__link:hover .post-card__title { color: var(--surface-inverse-hover); }
  .post-card__desc {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0 0 0.8rem;
  }
  .post-card__meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  .post-card__arrow {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--text-primary);
    transition: transform 280ms var(--ease);
    text-align: center;
  }
  .post-card__link:hover .post-card__arrow { transform: translateX(3px); }

  @media (max-width: 600px) {
    .blog-hero { padding: 3rem 0 2.5rem; }
    .blog-hero__title { margin: 0.75rem 0 1.15rem; font-size: var(--text-h1); }
    .post-card__link { grid-template-columns: 1fr; gap: 0.5rem; }
    .post-card__num { padding-top: 0; }
    .post-card__thumb { display: none; }
    .post-card__arrow { display: none; }
  }
</style>
