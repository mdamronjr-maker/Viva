---
import Layout from '../layouts/Layout.astro';

/* ============================================================
   /start · the intake page that should sit between any "Book"
   button and the GlossGenius scheduler. Adds the context that
   concierge customers expect (duration, price, what to bring,
   who their provider is) before they hand over a card.

   To wire this as the universal booking destination, swap every
   GlossGenius href across the site to /start. The Schedule CTA
   below still routes to GlossGenius with a "start_page" UTM tag.
   ============================================================ */

// Mirrors the "New Patient Consult" SKU in GlossGenius. Update both places
// (here + the scheduler) if the price or deposit ever changes.
const FIRST_VISIT_DURATION_MIN = 45;
const FIRST_VISIT_PRICE_USD = 199;
const FIRST_VISIT_DEPOSIT_USD = 50;
const FIRST_VISIT_CREDIT_NOTE =
  `One-time fee, separate from any membership. $${FIRST_VISIT_DEPOSIT_USD} deposit due at booking, balance billed at the visit.`;

// Keep the existing fixed handoff identifier. Never forward visitor-supplied
// query values: campaign names and search text can disclose health interests.
const bookingHref = 'https://vivawellnessco.glossgenius.com/services?utm_source=vivawellnessco&utm_medium=cta&utm_content=start_page';

const whatToBring = [
  'Any labs from the last twelve months, even the ones that came back out of range',
  'A list of what you take right now, prescriptions and supplements, with doses',
  'What you want, in your own words (energy, body comp, performance, recovery, longevity)',
  'A working webcam and a quiet forty-five minutes to yourself',
];

const visitSteps = [
  {
    num: '01',
    title: 'I ask what you have already tried',
    body: 'We start with what you have done, what helped, what flopped, and what changed along the way. No rushing you through a checklist.',
  },
  {
    num: '02',
    title: 'We look at the whole picture',
    body: 'Liliana goes through your labs, your symptoms, and your goals in one conversation. If your labs are missing or out of date, she orders what we need.',
  },
  {
    num: '03',
    title: 'You get a plan in plain English',
    body: 'Liliana explains the options that may fit, what they cost, what remains uncertain, and what the next step would be. If a requested treatment is not appropriate, she tells you that clearly.',
  },
  {
    num: '04',
    title: 'Nobody talks you into anything',
    body: 'You decide about enrolling after the visit. The first-visit fee is a one-time charge, separate from any membership you might choose to start.',
  },
];

// First ninety days · process-clarity timeline shown to prospects right
// before the final Schedule CTA. Generic enough to apply across care paths;
// Liliana can edit the clinical cadence as needed.
const ninetyDays = [
  {
    range: 'Days 0 to 7',
    label: 'First week',
    title: 'Evaluation and next steps',
    body: 'Liliana reviews your history, goals, current care, and available information. If labs or another evaluation are needed, she explains that. If medication is prescribed, pharmacy processing and delivery timing vary.',
  },
  {
    range: 'Days 3 to 30',
    label: 'Weeks 1 to 4',
    title: 'Secure follow-up begins',
    body: 'Complete any ordered labs or follow-up steps and use the secure patient portal for clinical questions. Medication changes, if any, are based on your individual plan and response.',
  },
  {
    range: 'Days 30 to 60',
    label: 'Weeks 5 to 8',
    title: 'Review progress and concerns',
    body: 'Follow-up timing depends on your care plan. Liliana reviews how things are going, answers questions, and decides whether any change or additional information is appropriate.',
  },
  {
    range: 'Days 60 to 90',
    label: 'Weeks 9 to 12',
    title: 'Reassess the plan',
    body: 'By the end of the initial membership period, you and Liliana review the plan, relevant results, next monitoring steps, and whether continuing, changing, or stopping makes sense.',
  },
];
---

<Layout
  title="Book Your First Telehealth Visit | Viva Wellness Co."
  description="See the duration, $199 first-visit price, $50 booking deposit, what to bring, and how to schedule a telehealth visit with Liliana Damron."
>

  <section class="start-hero">
    <div class="container start-hero__inner">
      <span class="eyebrow">Your first visit</span>
      <h1 class="start-hero__title">
        Your first telehealth visit.
      </h1>
      <p class="lead">
        See the first-visit fee, what to bring, and how the visit works.
        Your first visit is separate from any ongoing membership you choose.
      </p>
      <div class="start-hero__ctas">
        <a href={bookingHref} target="_blank" rel="noopener noreferrer" class="btn btn--bronze">Continue to scheduling</a>
        <a href="/services/#plans" class="btn">Compare care &amp; pricing</a>
      </div>
      <p class="start-cta__fine">
        You must be physically located in Texas, Colorado, Florida, or Iowa at the
        time of the visit. Visit fee is paid through GlossGenius.
      </p>
      <p class="start-questions">Questions before booking? <a href="/contact/">Contact Viva</a> for non-clinical help.</p>
    </div>
  </section>

  <section class="start-headline">
    <div class="container">
      <ul class="start-headline__grid">
        <li>
          <span class="eyebrow">Duration</span>
          <strong>{FIRST_VISIT_DURATION_MIN} min</strong>
          <span class="start-headline__note">Secure video. No commute, no waiting room, no old magazines.</span>
        </li>
        <li>
          <span class="eyebrow">Visit fee</span>
          <strong>${FIRST_VISIT_PRICE_USD}</strong>
          <span class="start-headline__note">{FIRST_VISIT_CREDIT_NOTE}</span>
        </li>
        <li>
          <span class="eyebrow">Provider</span>
          <strong>Liliana Damron, APRN, FNP-BC</strong>
          <span class="start-headline__note">Founder. Your first visit is with me, every time, not someone I handed you off to.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container start-grid">
      <div class="start-grid__left">
        <span class="eyebrow">What happens</span>
        <h2 class="start-h2">
          The visit, step by step.
        </h2>
        <ol class="start-steps">
          {visitSteps.map((s) => (
            <li class="start-step">
              <span class="start-step__num">{s.num}</span>
              <div>
                <h3 class="start-step__title">{s.title}</h3>
                <p class="start-step__body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <aside class="start-grid__right">
        <div class="start-card">
          <span class="eyebrow">Bring with you</span>
          <ul class="start-bring">
            {whatToBring.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="start-card__note">
            No recent labs? Don't worry about it. I'll order what we need at the
            first visit, and you can usually run those labs through your insurance.
          </p>
        </div>

        <div class="start-card start-card--quiet">
          <span class="eyebrow">Not ready to book?</span>
          <p>
            Use the anonymous care-path guide first. Three quick questions, and your
            answers stay in your browser. The result is educational;
            Liliana confirms clinical fit during a visit.
          </p>
          <a href="/#quiz" class="start-link">Use the anonymous guide →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section ninety">
    <div class="container">
      <div class="ninety__head">
        <span class="eyebrow">After your first visit</span>
        <h2 class="ninety__title">
          A typical first twelve weeks.
        </h2>
        <p class="lead">
          The exact schedule depends on your care plan, lab needs, pharmacy timing,
          and response. These milestones show the kinds of decisions and follow-up
          that may happen during the initial membership period.
        </p>
      </div>

      <ol class="ninety__list">
        {ninetyDays.map((phase) => (
          <li class="ninety__phase">
            <div class="ninety__phase-head">
              <span class="ninety__phase-label">{phase.label}</span>
              <span class="ninety__phase-range">{phase.range}</span>
            </div>
            <h3 class="ninety__phase-title">{phase.title}</h3>
            <p class="ninety__phase-body">{phase.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* CLOSING CTA · the page used to end after the ninety-day timeline with
      no action left on screen */}
  <section class="start-final" data-final-cta>
    <div class="container start-final__inner">
      <div>
        <h2 class="start-final__line">Ready to choose a time?</h2>
        <p class="start-final__note">Continue to Viva's GlossGenius scheduler to review available appointments and booking details.</p>
      </div>
      <a href={bookingHref} target="_blank" rel="noopener noreferrer" class="btn btn--bronze">Continue to scheduling</a>
    </div>
  </section>

  

</Layout>

<style>
  .start-hero {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--section-pad) 0 2rem;
    position: relative;
    overflow: hidden;
  }
  .start-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .start-hero__inner { position: relative; max-width: 60ch; }
  .start-hero__title {
    font-size: var(--text-h1);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 1rem 0 1.5rem;
  }
  .start-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.7rem; }

  .start-headline {
    padding: 0 0 clamp(2rem, 5vw, 3.5rem);
    padding-top: 1.4rem;
  }
  .start-headline__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    background: var(--border-subtle);
    overflow: hidden;
  }
  @media (max-width: 760px) { .start-headline__grid { grid-template-columns: 1fr; } }
  .start-headline__grid li {
    background: var(--surface-card);
    padding: 1.5rem 1.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .start-headline__grid strong {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }
  .start-headline__note {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 32ch;
  }

  .start-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  @media (max-width: 900px) { .start-grid { grid-template-columns: 1fr; } }

  .start-h2 {
    font-size: var(--text-h2);
    margin: 0.6rem 0 2rem;
    max-width: 18ch;
    line-height: 1.1;
  }

  .start-steps { display: flex; flex-direction: column; border-top: 1px solid var(--border-subtle); }
  .start-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1.2rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: start;
  }
  .start-step__num {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    letter-spacing: 0;
    padding-top: 0.4rem;
  }
  .start-step__title {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
  }
  .start-step__body {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 56ch;
  }

  .start-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-left: 2px solid var(--text-primary);
    padding: 1.6rem 1.7rem;
    margin-bottom: 1.4rem;
    border-radius: var(--radius);
  }
  .start-card .eyebrow { display: block; margin-bottom: 1rem; }
  .start-bring {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }
  .start-bring li {
    padding-left: 1.2rem;
    position: relative;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .start-bring li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--text-secondary);
    font-weight: 600;
  }
  .start-card__note {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  .start-card--quiet { border-left-color: var(--border-subtle); }
  .start-card--quiet p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 0.8rem;
  }
  .start-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-secondary);
    transition: color 200ms var(--ease);
  }
  .start-link:hover { color: var(--text-primary); }

  /* ============ FIRST NINETY DAYS ============ */
  .ninety {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .ninety__head { max-width: 800px; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .ninety__title {
    font-size: var(--text-h2);
    margin: 0.6rem 0 1.2rem;
    max-width: 22ch;
    line-height: 1.1;
  }
  .ninety__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (max-width: 900px) { .ninety__list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .ninety__list { grid-template-columns: 1fr; } }
  .ninety__phase {
    background: var(--surface-page);
    padding: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    position: relative;
    transition: background 240ms var(--ease);
  }
  .ninety__phase:hover { background: var(--surface-card); }
  .ninety__phase-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.8rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.4rem;
  }
  .ninety__phase-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-secondary);
  }
  .ninety__phase-range {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    letter-spacing: 0;
  }
  .ninety__phase-title {
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0;
  }
  .ninety__phase-body {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0;
    max-width: none;
  }

  .start-final {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-inverse);
    color: var(--text-inverse);
    --focus-ring: var(--action-primary);
  }
  .start-final__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .start-final__line {
    font-family: var(--font-body);
    font-size: var(--text-h3);
    margin: 0;
    max-width: 30ch;
  }
  .start-final__note { margin: 0.75rem 0 0; max-width: 52ch; color: inherit; }
  .start-questions { margin-top: 0.75rem; font-size: 0.9375rem; color: var(--text-secondary); }
  .start-questions a { text-decoration: underline; text-underline-offset: 0.2em; }
  .start-cta__fine {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    letter-spacing: 0;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-top: 1.5rem;
  }
  @media (max-width: 720px) {
    .start-hero { padding: 2.75rem 0 2rem; }
    .start-hero__title { margin: 0.75rem 0 1.15rem; }
    .start-hero__ctas { display: grid; grid-template-columns: 1fr; width: 100%; }
    .start-hero__ctas .btn { width: 100%; justify-content: center; }
    .start-headline__grid li { padding: 1.25rem; }
    .start-step { grid-template-columns: 44px 1fr; gap: 0.8rem; padding: 1.2rem 0; }
    .start-card { padding: 1.35rem 1.25rem; }
    .ninety { padding: 2.75rem 0; }
    .ninety__phase { padding: 1.25rem; }
    .start-final__inner { align-items: flex-start; }
    .start-final .btn { width: 100%; }
  }
</style>
