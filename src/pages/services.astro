---
import Layout from '../layouts/Layout.astro';

// Five memberships mirroring the live GlossGenius catalog. The care-path guide routes
// prospects to a starting tier; the metabolic ladder (Essential → Core →
// Advanced) lets the provider step a patient up or down inside the
// metabolic track without a SKU change.
// Pricing and includes match the live GlossGenius catalog
// (https://vivawellnessco.glossgenius.com/shop/memberships?tab=explore).
// GlossGenius is the source of truth — never invent prices. Annual pricing
// is intentionally omitted because GG does not display annual; add it back
// here only when it is configured on GG.
const programs = [
  {
    tier: 'Insurance',
    name: 'Viva Concierge Access',
    price: 99,
    priceLabel: '$99',
    tagline: 'Ongoing provider access with medications handled separately.',
    body: 'A membership for patients who want concierge provider attention while using insurance for eligible retail prescriptions and labs. Monthly evaluations, ongoing medication management, and a Prior Authorization service when your plan needs paperwork. Compounded estradiol and progesterone may be considered as patient-specific add-ons when clinically appropriate and lawful; they are not included in the $99 membership fee.',
    includes: [
      'Monthly evaluation visit',
      'Dosing guidance',
      'Provider-led HRT/TRT management',
      'Ongoing medication management',
      'Prior Authorization service',
      'One acute/sick visit credit per month',
    ],
    rightFor: [
      'You want to use insurance for eligible prescriptions and labs',
      'You want concierge-level provider attention without bundled medication costs',
      'You prefer monthly oversight to a one-off appointment',
    ],
    notRightFor: [
      'You want testosterone medication, supplies, and labs bundled together (see TRT All Inclusive)',
    ],
  },
  {
    tier: 'Hormone',
    name: 'TRT All Inclusive',
    price: 199,
    priceLabel: '$199',
    tagline: 'Provider-led testosterone care with medication, labs, supplies, and delivery.',
    body: 'This membership bundles provider-led testosterone care, compounded testosterone when clinically appropriate and lawfully prescribed, twice-yearly labs, supplies, and home delivery in one monthly fee. Symptoms alone do not establish low testosterone; treatment requires an individual clinical evaluation.',
    includes: [
      'Personalized dosing (topical or injectable)',
      'Compounded testosterone for TRT',
      'Labs twice yearly',
      'Supplies and home delivery',
      'Fully managed, provider-led care',
    ],
    rightFor: [
      'You want a clinical evaluation for possible testosterone care',
      'You want compounded testosterone and labs included in a flat fee',
      'You want ongoing monitoring rather than a one-time prescription',
    ],
    notRightFor: [
      'You need perimenopause or menopause management (see Viva Concierge Access)',
      'You are using insurance for hormones (see Viva Concierge Access)',
      'You are focused on weight loss (see the Metabolic tiers)',
    ],
  },
  {
    tier: 'Metabolic · 01',
    name: 'Metabolic Essential',
    price: 249,
    priceLabel: '$249',
    tagline: 'The lower-cost medical weight-management membership.',
    body: 'This plan lists compounded semaglutide at any dose, or micro-dose tirzepatide under 2.5 mg per week, plus the follow-up, supplies, and delivery shown below. A compounded GLP-1 can be prescribed only when current law permits it and Liliana documents an identified patient-specific need after clinical evaluation.',
    includes: [
      'Compounded semaglutide (any dose) or micro-dose tirzepatide (<2.5 mg/week)',
      'Medication management and follow-up',
      'Supplies and home delivery',
      'Provider follow-ups',
      'One sick visit credit per quarter',
    ],
    rightFor: [
      'You want to discuss the lower-cost weight-management tier',
      'You want medication decisions made with a provider',
      'You want a provider managing titration month to month',
    ],
    notRightFor: [
      'The medication or level of monitoring listed here is not clinically appropriate for you',
    ],
  },
  {
    tier: 'Metabolic · 02',
    name: 'Metabolic Core',
    price: 349,
    priceLabel: '$349',
    tagline: 'A more comprehensive medical weight-management membership.',
    body: 'This plan lists compounded tirzepatide at a low-to-moderate dose with monthly medication management and side-effect review. A compounded GLP-1 can be prescribed only when current law permits it and Liliana documents an identified patient-specific need after clinical evaluation.',
    includes: [
      'Compounded tirzepatide (low-to-moderate dose)',
      'Medication management and side-effect review',
      'Supplies and home delivery',
      'Monthly provider follow-ups',
      'One acute Viva Concierge visit',
    ],
    rightFor: [
      'You want to discuss the Core weight-management tier',
      'You want monthly provider attention to medication management and side effects',
      'You understand that eligibility is determined during clinical evaluation',
    ],
    notRightFor: [
      'You want semaglutide or micro-dose tirzepatide (see Metabolic Essential)',
      'You need a different medication, dose, or level of monitoring',
    ],
  },
  {
    tier: 'Metabolic · 03',
    name: 'Metabolic Advanced',
    price: 499,
    priceLabel: '$499',
    tagline: 'The highest-priced weight-management tier with close follow-up.',
    body: 'A closely managed metabolic tier for patients whose clinical evaluation supports the medication and monitoring included at this level. Any compounded medication requires an identified patient-specific need and must be lawful and available at the time of prescribing.',
    includes: [
      'Provider-titrated compounded medication, selected at your evaluation',
      'Medication management and side-effect review',
      'Supplies and home delivery',
      'Monthly provider follow-ups',
      'Viva Concierge access',
    ],
    rightFor: [
      'You want to discuss the Advanced tier after prior treatment',
      'You want the listed medication and services bundled if clinically appropriate',
      'You want close monthly provider oversight',
    ],
    notRightFor: [
      'A lower-cost tier provides the medication and monitoring you need',
      'The Advanced tier is not clinically appropriate for you',
    ],
  },
];

// Items truly common across every tier above. "Supplies and home delivery"
// is intentionally omitted — it does not apply to Viva Concierge Access,
// which is the insurance-routed tier.
const ICON = {
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  sliders: '<line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>',
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  tag: '<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".75" fill="currentColor" stroke="none"/>',
};
const includedAlways = [
  { label: 'Named-provider oversight', icon: 'calendar' },
  { label: 'Secure clinical messaging', icon: 'message' },
  { label: 'Ongoing follow-up', icon: 'sliders' },
  { label: 'Published plan inclusions', icon: 'zap' },
  { label: 'No automatic prescribing', icon: 'tag' },
];

const pillars = [
  { href: '/menopause/', title: 'Menopause and perimenopause', body: 'For hot flashes, sleep disruption, concentration, mood, or other midlife concerns that deserve evaluation without assuming one cause.' },
  { href: '/weight-management/', title: 'Medical weight management', body: 'For adults who want to review sustainable approaches, medication questions, costs, and safety in context.' },
  { href: '/testosterone/', title: 'Testosterone care', body: 'For adults who want a clinical evaluation of possible low-testosterone symptoms, options, and monitoring.' },
  { href: '/recovery/', title: 'Recovery and long-term health', body: 'For active adults who want an evidence-aware discussion about recovery, function, and when in-person care is needed.' },
];

// Schema.org · each tier emits a Service node so Google can surface a specific
// program in search. Service (not MedicalProcedure) is used because it is the
// type that actually defines `offers` and `provider` — MedicalProcedure does
// not, and validators reject those properties on it, discarding the pricing.
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const areaServed = [
  { '@type': 'State', name: 'Texas' },
  { '@type': 'State', name: 'Colorado' },
  { '@type': 'State', name: 'Florida' },
  { '@type': 'State', name: 'Iowa' },
];
const servicesSchema = {
  '@context': 'https://schema.org',
  '@graph': [...programs.map((prog) => ({
    '@type': 'Service',
    '@id': `https://vivawellnessco.com/services/#${slugify(prog.name)}`,
    name: prog.name,
    description: prog.body,
    provider: { '@id': 'https://vivawellnessco.com/#organization' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: String(prog.price),
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: String(prog.price),
        priceCurrency: 'USD',
        unitText: 'MONTH',
      },
      areaServed,
    },
  })), {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
      { '@type': 'ListItem', position: 2, name: 'Care and pricing', item: 'https://vivawellnessco.com/services/' },
    ],
  }],
};
---

<Layout
  title="Telehealth Care & Membership Pricing | Viva Wellness Co."
  description="Compare Viva memberships from $99 to $499 per month, with exact plan inclusions, terms, and medication boundaries."
  schema={servicesSchema}
>

  {/* HERO */}
  <section class="services-hero">
    <div class="container services-hero__inner">
      <span class="eyebrow">Energy · hormones · metabolism · recovery</span>
      <h1 class="services-hero__title">
        What I treat,<br/>
        <span class="italic-display">and what it costs.</span>
      </h1>
      <p class="lead">
        You may be here because sleep, energy, weight, hormones, or recovery
        changed. I start with your history and goals, decide what information
        may help, and explain which options fall inside Viva's scope.
      </p>
      <p class="services-hero__detail">
        All-inclusive testosterone and metabolic tiers bundle only the medication
        and services listed in that plan. Viva Concierge Access keeps medications
        separate. Every prescription requires an individual clinical evaluation,
        and choosing a price tier does not establish eligibility.
      </p>
      <div class="services-hero__ctas">
        <a href="#plans" class="btn btn--bronze">Compare plans</a>
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=services_hero" class="btn">Book your first visit</a>
      </div>
    </div>
  </section>

  {/* PILLARS · recognizable problems before clinical categories */}
  <section class="section pillars-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Start with what changed</span>
        <h2 class="section-head__title">
          Start with what feels different.
        </h2>
        <p class="lead section-head__lead">
          Bring me what has changed, what you have tried, and what you need your
          health to support. I will connect the symptoms, the labs, and the care
          options with you.
        </p>
      </div>

      <ul class="pillars">
        {pillars.map((p) => (
          <li class="pillar">
            <a class="pillar__link" href={p.href}>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__body">{p.body}</p>
              <span class="pillar__more">See care options →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* INCLUDED-EVERYWHERE STRIP */}
  <section class="included">
    <div class="container">
      <div class="included__inner">
        <div class="included__head">
          <span class="eyebrow">Every membership includes</span>
        </div>
        <ul class="included__list">
          {includedAlways.map((item) => (
            <li>
              <svg class="incl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[item.icon]} />
              <span>{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* QUIZ CTA BANNER */}
  <section class="quiz-banner">
    <div class="container quiz-banner__inner">
      <div class="quiz-banner__copy">
        <span class="eyebrow">Three quick questions</span>
        <h2 class="quiz-banner__title">
          Find your starting point.
        </h2>
        <p>
          Compare Viva's published care paths in about a minute. Your
          answers stay in this browser and do not determine clinical eligibility.
        </p>
      </div>
      <a href="/#quiz" class="btn btn--bronze">Use the anonymous guide</a>
    </div>
  </section>

  {/* PROVIDER STRIP · a beat of warmth before the pricing grid */}
  <section class="section--paper provider-strip">
    <div class="container provider-strip__inner">
      <div class="provider-strip__credential" aria-label="Provider credentials">
        <strong>Liliana Damron</strong>
        <span>APRN, FNP-BC</span>
      </div>
      <div class="provider-strip__copy">
        <span class="eyebrow">One named provider</span>
        <p class="provider-strip__line">
          Every tier on this page is managed by
          <strong>Liliana Damron, APRN, FNP-BC</strong>.
          Your first visit, follow-up decisions, and medication management stay
          connected to the same provider.
        </p>
        <a href="/about/" class="provider-strip__link">Meet your provider →</a>
      </div>
    </div>
  </section>

  {/* PROGRAMS · five memberships, mirrored from GlossGenius */}
  <section class="section programs-section" id="plans">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Care and pricing</span>
        <h2 class="section-head__title">
          Start with one visit. I will help you choose.
        </h2>
        <p class="lead section-head__lead">
          The cards below show exactly what each membership lists as included.
          Viva Concierge Access keeps medication separate. Other plans bundle
          only the medication and services stated on the card, when clinically prescribed.
        </p>
      </div>

      <ul class="prog-grid">
        {programs.map((p, i) => (
          <li class:list={["prog-card", i === programs.length - 1 && 'prog-card--span']} id={slugify(p.name)}>
            <header class="prog-card__head">
              <span class="prog-card__tier">{p.tier}</span>
              <h3 class="prog-card__name">{p.name}</h3>
              <div class="prog-card__price">
                <span class="prog-card__amt">{p.priceLabel}</span>
                <span class="prog-card__cad">/mo</span>
              </div>
              <p class="prog-card__tagline">{p.tagline}</p>
            </header>
            <p class="prog-card__body">{p.body}</p>
            <ul class="prog-card__includes">
              {p.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {(p.rightFor || p.notRightFor) && (
              <div class="prog-card__fit">
                {p.rightFor && (
                  <div class="prog-card__fit-block">
                    <span class="prog-card__fit-label prog-card__fit-label--yes">Worth discussing if</span>
                    <ul class="prog-card__fit-list">
                      {p.rightFor.map((item) => (<li>{item}</li>))}
                    </ul>
                  </div>
                )}
                {p.notRightFor && (
                  <div class="prog-card__fit-block">
                    <span class="prog-card__fit-label prog-card__fit-label--no">Compare another path if</span>
                    <ul class="prog-card__fit-list prog-card__fit-list--no">
                      {p.notRightFor.map((item) => (<li>{item}</li>))}
                    </ul>
                  </div>
                )}
              </div>
            )}
            <a href={`/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=services_tier_${slugify(p.name)}`} class="btn btn--bronze prog-card__cta">
              Book your first visit
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* PRICING NOTE + REVIEW PULLQUOTE */}
  <div class="container services-aside">
    <p class="sidenote services-pricing-note">These prices mirror Viva's current booking system. Review the final booking screen before purchase and contact Viva if anything appears inconsistent.</p>
    <figure class="services-quote">
      <blockquote class="pullquote">Most competent, caring provider. I get personalized care that's effective and timely. The proof is in the results and in how I feel. Just grateful everyday I found her.</blockquote>
      <figcaption class="caption">Tiffany Plaster · <a href="https://www.google.com/maps/place/Viva+Wellness+Co./@30.448506,-93.3099761,5366828m/data=!3m2!1e3!4b1!4m6!3m5!1s0x838a2a09b2fa0069:0x23603b7d6308b72a!8m2!3d30.448506!4d-93.309976!16s%2Fg%2F11x1q1jhw9" target="_blank" rel="noopener">verified Google review</a></figcaption>
    </figure>
  </div>

  {/* POLICIES */}
  <section class="section section--paper">
    <div class="container policies">
      <div>
        <span class="eyebrow">The fine print</span>
        <h2 class="policies__title">Membership policies, plainly stated.</h2>
      </div>
      <ul class="policies__list">
        <li>Provider review and approval required prior to initiating any therapy.</li>
        <li>All programs require a 12-week minimum commitment. Review the full membership terms before enrolling.</li>
        <li>Memberships renew automatically every 30 days. Cancel any time after the initial 12 weeks.</li>
        <li>A valid card on file is required. Payments are securely processed through GlossGenius.</li>
        <li>Medication, supplies, delivery, and labs are included only where the selected plan expressly lists them and only when clinically appropriate.</li>
        <li>FSA and HSA accepted. Insurance not accepted for memberships, but can be applied to labs and non-compounded medications.</li>
        <li>Compounded medications are patient-specific preparations dispensed by 503A compounding pharmacies. They are not FDA-approved finished products, and FDA does not review them for safety, effectiveness, or quality before dispensing. They cannot be marketed as generic or equivalent versions of approved drugs. Each requires individual evaluation, an identified patient-specific need, current legal availability, and a prescription; selecting a membership does not guarantee one. <a href="https://www.fda.gov/drugs/drug-alerts-and-statements/fda-clarifies-policies-compounders-national-glp-1-supply-begins-stabilize" target="_blank" rel="noopener">Read FDA's current GLP-1 compounding update.</a></li>
      </ul>
    </div>
  </section>

  {/* CTA */}
  <section class="services-cta">
    <div class="container services-cta__inner">
      <h2 class="services-cta__title">
        Not sure which tier? Start with a visit.
      </h2>
      <p class="lead">
        Your first telehealth visit is where Liliana reviews your goals, history,
        current care, and any relevant information available. She explains which
        options may fit and what happens if a requested treatment is not appropriate.
      </p>
      <div class="services-cta__ctas">
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=services_cta" class="btn btn--bronze">Book your first visit</a>
        <a href="/contact/" class="btn">Ask a question</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .services-aside { padding: clamp(2rem, 4vw, 3rem) var(--gutter); display: flex; flex-direction: column; gap: 2rem; }
  .services-pricing-note { max-width: 46ch; }
  .services-quote { margin: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .services-hero {
    background: var(--sky);
    border-bottom: 1px solid var(--rule);
    padding: clamp(6rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 6rem);
    position: relative;
    overflow: hidden;
  }
  .services-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .services-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1100px;
  }
  .services-hero__title {
    font-size: clamp(2.6rem, 6.8vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  .services-hero__detail {
    max-width: 70ch;
    margin: 0;
    color: rgba(28, 35, 27, 0.72);
    font-size: 1rem;
    line-height: 1.65;
  }
  .services-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  /* PILLARS */
  .pillars-section { padding: clamp(3rem, 7vw, 5rem) 0; }
  .pillars { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 1px solid var(--rule-strong); }
  .pillar { padding: 1.4rem 1.2rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule-strong); transition: background 240ms var(--ease); }
  .pillars > .pillar:nth-child(2n+1) { padding-left: 0; }
  .pillar:nth-child(2n) { border-right: 0; }
  .pillar:hover { background: rgba(23, 75, 51, 0.1); }
  .pillar__title { font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--paper); line-height: 1.2; }
  .pillar__body { color: rgba(28, 35, 27, 0.75); font-size: 0.9rem; line-height: 1.45; }
  @media (max-width: 600px) { .pillars { grid-template-columns: 1fr; } .pillar { border-right: 0 !important; padding-left: 0; } }
  .pillar__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .pillar__link:focus-visible { outline: 2px solid var(--bronze); outline-offset: 4px; }
  .pillar__more { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--bronze); margin-top: auto; padding-top: 0.9rem; opacity: 0; transform: translateX(-4px); transition: opacity 220ms var(--ease), transform 220ms var(--ease); }
  .pillar:hover .pillar__more, .pillar:focus-within .pillar__more { opacity: 1; transform: none; }
  @media (max-width: 600px) { .pillar__more { opacity: 1; transform: none; } }

  /* INCLUDED */
  .included {
    background: var(--ink-2);
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    padding: 2.5rem 0;
  }
  .included__inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 800px) {
    .included__inner { grid-template-columns: 1fr; }
  }
  .included__head { padding-top: 0.4rem; }
  .included__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem 2rem;
    color: rgba(28, 35, 27, 0.85);
    font-size: 0.95rem;
  }
  @media (max-width: 600px) { .included__list { grid-template-columns: 1fr; } }
  .included__list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .included__list .incl-ico {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    color: var(--bronze);
  }

  /* QUIZ BANNER */
  .quiz-banner {
    padding: clamp(3rem, 6vw, 5rem) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink);
    position: relative;
    overflow: hidden;
  }
  .quiz-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .quiz-banner__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  @media (max-width: 800px) {
    .quiz-banner__inner { grid-template-columns: 1fr; }
  }
  .quiz-banner__title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.7rem 0 1rem;
    max-width: 16ch;
