---
import Layout from '../layouts/Layout.astro';

// Five memberships mirroring the live GlossGenius catalog. The care-path guide routes
// prospects to a starting tier; the metabolic ladder (Essential → Core →
// Advanced) lets the provider step a patient up or down inside the
// metabolic track without a SKU change.
// Pricing and includes match the live GlossGenius catalog
// (https://vivawellnessco.glossgenius.com/shop/memberships?tab=explore).
// GlossGenius is the source of truth — never invent prices. Annual pricing
// is intentionally omitted because GG does not display annual; add it back
// here only when it is configured on GG.
const programs = [
  {
    tier: 'Provider access',
    name: 'Viva Concierge Access',
    price: 99,
    priceLabel: '$99',
    tagline: 'Ongoing provider access with medications handled separately.',
    body: 'A membership for patients who want concierge provider attention while using insurance for eligible retail prescriptions and labs. Monthly evaluations, ongoing medication management, and a Prior Authorization service when your plan needs paperwork. Compounded estradiol and progesterone may be considered as patient-specific add-ons when clinically appropriate and lawful; they are not included in the $99 membership fee.',
    includes: [
      'Monthly evaluation visit',
      'Dosing guidance',
      'Provider-led HRT/TRT management',
      'Ongoing medication management',
      'Prior Authorization service',
      'One acute/sick visit credit per month',
    ],
    rightFor: [
      'You want to use insurance for eligible prescriptions and labs',
      'You want concierge-level provider attention without bundled medication costs',
      'You prefer monthly oversight to a one-off appointment',
    ],
    notRightFor: [
      'You want testosterone medication, supplies, and labs bundled together (see TRT All Inclusive)',
    ],
  },
  {
    tier: 'Hormone',
    name: 'TRT All Inclusive',
    price: 199,
    priceLabel: '$199',
    tagline: 'Provider-led testosterone care with medication, labs, supplies, and delivery.',
    body: 'This membership bundles provider-led testosterone care, compounded testosterone when clinically appropriate and lawfully prescribed, twice-yearly labs, supplies, and home delivery in one monthly fee. Symptoms alone do not establish low testosterone; treatment requires an individual clinical evaluation.',
    includes: [
      'Personalized dosing (topical or injectable)',
      'Compounded testosterone for TRT',
      'Labs twice yearly',
      'Supplies and home delivery',
      'Fully managed, provider-led care',
    ],
    rightFor: [
      'You want a clinical evaluation for possible testosterone care',
      'You want compounded testosterone and labs included in a flat fee',
      'You want ongoing monitoring rather than a one-time prescription',
    ],
    notRightFor: [
      'You need perimenopause or menopause management (see Viva Concierge Access)',
      'You are using insurance for hormones (see Viva Concierge Access)',
      'You are focused on weight loss (see the Metabolic tiers)',
    ],
  },
  {
    tier: 'Metabolic · 01',
    name: 'Metabolic Essential',
    price: 249,
    priceLabel: '$249',
    tagline: 'The lower-cost medical weight-management membership.',
    body: 'This plan lists compounded semaglutide at any dose, or micro-dose tirzepatide under 2.5 mg per week, plus the follow-up, supplies, and delivery shown below. A compounded GLP-1 can be prescribed only when current law permits it and Liliana documents an identified patient-specific need after clinical evaluation.',
    includes: [
      'Compounded semaglutide (any dose) or micro-dose tirzepatide (<2.5 mg/week)',
      'Medication management and follow-up',
      'Supplies and home delivery',
      'Provider follow-ups',
      'One sick visit credit per quarter',
    ],
    rightFor: [
      'You want to discuss the lower-cost weight-management tier',
      'You want medication decisions made with a provider',
      'You want a provider managing titration month to month',
    ],
    notRightFor: [
      'The medication or level of monitoring listed here is not clinically appropriate for you',
    ],
  },
  {
    tier: 'Metabolic · 02',
    name: 'Metabolic Core',
    price: 349,
    priceLabel: '$349',
    tagline: 'A more comprehensive medical weight-management membership.',
    body: 'This plan lists compounded tirzepatide at a low-to-moderate dose with monthly medication management and side-effect review. A compounded GLP-1 can be prescribed only when current law permits it and Liliana documents an identified patient-specific need after clinical evaluation.',
    includes: [
      'Compounded tirzepatide (low-to-moderate dose)',
      'Medication management and side-effect review',
      'Supplies and home delivery',
      'Monthly provider follow-ups',
      'One acute Viva Concierge visit',
    ],
    rightFor: [
      'You want to discuss the Core weight-management tier',
      'You want monthly provider attention to medication management and side effects',
      'You understand that eligibility is determined during clinical evaluation',
    ],
    notRightFor: [
      'You want semaglutide or micro-dose tirzepatide (see Metabolic Essential)',
      'You need a different medication, dose, or level of monitoring',
    ],
  },
  {
    tier: 'Metabolic · 03',
    name: 'Metabolic Advanced',
    price: 499,
    priceLabel: '$499',
    tagline: 'The highest-priced weight-management tier with close follow-up.',
    body: 'A closely managed metabolic tier for patients whose clinical evaluation supports the medication and monitoring included at this level. Any compounded medication requires an identified patient-specific need and must be lawful and available at the time of prescribing.',
    includes: [
      'Provider-titrated compounded medication, selected at your evaluation',
      'Medication management and side-effect review',
      'Supplies and home delivery',
      'Monthly provider follow-ups',
      'Viva Concierge access',
    ],
    rightFor: [
      'You want to discuss the Advanced tier after prior treatment',
      'You want the listed medication and services bundled if clinically appropriate',
      'You want close monthly provider oversight',
    ],
    notRightFor: [
      'A lower-cost tier provides the medication and monitoring you need',
      'The Advanced tier is not clinically appropriate for you',
    ],
  },
];

const pillars = [
  { href: '/menopause/', title: 'Menopause and perimenopause', body: 'For hot flashes, sleep disruption, concentration, mood, or other midlife concerns that deserve evaluation without assuming one cause.' },
  { href: '/weight-management/', title: 'Medical weight management', body: 'For adults who want to review sustainable approaches, medication questions, costs, and safety in context.' },
  { href: '/testosterone/', title: 'Testosterone care', body: 'For adults who want a clinical evaluation of possible low-testosterone symptoms, options, and monitoring.' },
  { href: '/peptide-therapy/', title: 'Peptide therapy', body: 'For adults who want the evidence, medication status, costs, and care boundaries explained before considering an option.' },
  { href: '/recovery/', title: 'Recovery and long-term health', body: 'For active adults who want an evidence-aware discussion about recovery, function, and when in-person care is needed.' },
];

// Represent each published membership and its monthly price as a Service.
// This describes the offer; structured data does not promise search display.
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const areaServed = [
  { '@type': 'State', name: 'Texas' },
  { '@type': 'State', name: 'Colorado' },
  { '@type': 'State', name: 'Florida' },
  { '@type': 'State', name: 'Iowa' },
];
const servicesSchema = {
  '@context': 'https://schema.org',
  '@graph': [...programs.map((prog) => ({
    '@type': 'Service',
    '@id': `https://vivawellnessco.com/services/#${slugify(prog.name)}`,
    name: prog.name,
    description: prog.body,
    provider: { '@id': 'https://vivawellnessco.com/#organization' },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: String(prog.price),
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: String(prog.price),
        priceCurrency: 'USD',
        unitText: 'MONTH',
      },
      areaServed,
    },
  })), {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
      { '@type': 'ListItem', position: 2, name: 'Care and pricing', item: 'https://vivawellnessco.com/services/' },
    ],
  }],
};
---

<Layout
  title="Telehealth Care, Peptide Therapy & Pricing | Viva"
  description="Compare memberships from $99 to $499 per month for weight, hormone, peptide therapy, and recovery care, with clear medication boundaries."
  schema={servicesSchema}
>
  <section class="services-hero">
    <div class="container services-hero__inner">
      <span class="eyebrow">Virtual care · Texas, Colorado, Florida &amp; Iowa</span>
      <h1>Care and pricing.</h1>
      <p class="lead">Explore your care options and the cost of getting started. Your first visit with Liliana comes before choosing a membership.</p>
      <div class="services-actions">
        <a href="/start/" class="btn btn--bronze">Book a visit</a>
        <a href="#plans" class="btn">Compare memberships</a>
      </div>
    </div>
  </section>

  <section class="first-visit" aria-labelledby="first-visit-title">
    <div class="container first-visit__inner">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 id="first-visit-title">One visit. An individual plan.</h2>
        <p>Liliana reviews your history, goals and current care, then explains which options may fit. Choosing a membership does not establish clinical eligibility.</p>
        <a class="text-link" href="/start/">See what to expect at your first visit →</a>
      </div>
      <div class="first-visit__cost">
        <p class="first-visit__price"><strong>$199</strong><span>First telehealth visit</span></p>
        <p>One-time fee, separate from any membership.</p>
        <p><strong>$50 deposit</strong> due at booking. Review the payment and cancellation terms in the booking system before confirming.</p>
      </div>
    </div>
  </section>

  <section class="section programs-section" id="plans" aria-labelledby="plans-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ongoing care</span>
        <h2 id="plans-title">Compare the five memberships.</h2>
        <p class="lead">Viva Concierge Access keeps medications separate. Testosterone and metabolic plans bundle only the medication and services listed, when clinically appropriate and lawfully prescribed.</p>
        <p class="plans-commitment">Every program has a <strong>12-week minimum commitment</strong> and renews every 30 days. <a href="#membership-policies">Read the membership policies.</a></p>
      </div>
      <nav class="plan-jump" aria-label="Jump to a membership">
        {programs.map((p) => <a href={`#${slugify(p.name)}`}>{p.name} <span>{p.priceLabel}/mo</span></a>)}
      </nav>
      <ul class="prog-grid">
        {programs.map((p) => (
          <li class="prog-card" id={slugify(p.name)}>
            <div class="prog-card__overview">
              <header class="prog-card__head">
                <span class="prog-card__tier">{p.tier}</span>
                <h3 class="prog-card__name">{p.name}</h3>
                <p class="prog-card__price"><strong>{p.priceLabel}</strong><span>/ month</span></p>
                <p class="prog-card__tagline">{p.tagline}</p>
              </header>
              <p class="prog-card__body">{p.body}</p>
            </div>
            <div class="prog-card__inclusions">
              <h4>What this membership includes</h4>
              <ul class="prog-card__includes">
                {p.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <details class="prog-card__fit">
              <summary>When to discuss this plan or compare another path</summary>
              <div class="prog-card__fit-content">
                <div>
                  <h4>Worth discussing if</h4>
                  <ul>{p.rightFor.map((item) => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <h4>Compare another path if</h4>
                  <ul>{p.notRightFor.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>
            </details>
            <div class="prog-card__action"><a href="/start/" class="btn">Book a visit</a></div>
          </li>
        ))}
      </ul>
      <p class="services-pricing-note">These prices mirror Viva's current booking system. Review the final booking screen before purchase and contact Viva if anything appears inconsistent.</p>
    </div>
  </section>

  <section class="section section--paper" id="membership-policies" aria-labelledby="policies-title">
    <div class="container policies">
      <div>
        <span class="eyebrow">Before you enroll</span>
        <h2 id="policies-title">Membership policies, plainly stated.</h2>
      </div>
      <ul class="policies__list">
        <li>Provider review and approval required prior to initiating any therapy.</li>
        <li>All programs require a 12-week minimum commitment. Review the full membership terms before enrolling.</li>
        <li>Memberships renew automatically every 30 days. Cancel any time after the initial 12 weeks.</li>
        <li>A valid card on file is required. Payments are securely processed through GlossGenius.</li>
        <li>Medication, supplies, delivery, and labs are included only where the selected plan expressly lists them and only when clinically appropriate.</li>
        <li>FSA and HSA accepted. Insurance not accepted for memberships, but can be applied to labs and non-compounded medications.</li>
        <li>Compounded medications are patient-specific preparations dispensed by 503A compounding pharmacies. They are not FDA-approved finished products, and FDA does not review them for safety, effectiveness, or quality before dispensing. They cannot be marketed as generic or equivalent versions of approved drugs. Each requires individual evaluation, an identified patient-specific need, current legal availability, and a prescription; selecting a membership does not guarantee one. <a href="https://www.fda.gov/drugs/drug-alerts-and-statements/fda-clarifies-policies-compounders-national-glp-1-supply-begins-stabilize" target="_blank" rel="noopener">Read FDA's current GLP-1 compounding update.</a></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="care-paths-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Explore your care</span>
        <h2 id="care-paths-title">Start with what has changed.</h2>
        <p class="lead">Bring what has changed, what you have tried, and what you need your health to support. Explore the care pages for process, safety and scope.</p>
      </div>
      <ul class="pillars">
        {pillars.map((p) => (
          <li><a class="pillar__link" href={p.href}>
            <h3>{p.title}</h3><p>{p.body}</p><span class="text-link">See care options →</span>
          </a></li>
        ))}
      </ul>
      <p class="care-guide">Prefer a guided starting point? <a href="/#quiz">Use the optional anonymous guide.</a> Your answers stay in this browser and do not determine clinical eligibility.</p>
    </div>
  </section>

  <section class="section provider-section" aria-labelledby="provider-title">
    <div class="container provider-grid">
      <div>
        <span class="eyebrow">One named provider</span>
        <h2 id="provider-title">Liliana Damron, APRN, FNP-BC.</h2>
        <p>Every tier on this page is managed by Liliana. Your first visit, follow-up decisions, and medication management stay connected to the same provider.</p>
        <ul class="membership-basics" aria-label="Across every membership">
          <li>Named-provider oversight</li>
          <li>Secure clinical messaging</li>
          <li>Ongoing follow-up</li>
          <li>Published plan inclusions</li>
          <li>No automatic prescribing</li>
        </ul>
        <a class="text-link" href="/about/">Meet your provider →</a>
      </div>
    <figure class="services-quote">
      <blockquote class="pullquote">Most competent, caring provider. I get personalized care that's effective and timely. The proof is in the results and in how I feel. Just grateful everyday I found her.</blockquote>
      <figcaption class="caption">Tiffany Plaster · <a href="https://www.google.com/maps/place/Viva+Wellness+Co./@30.448506,-93.3099761,5366828m/data=!3m2!1e3!4b1!4m6!3m5!1s0x838a2a09b2fa0069:0x23603b7d6308b72a!8m2!3d30.448506!4d-93.309976!16s%2Fg%2F11x1q1jhw9" target="_blank" rel="noopener">verified Google review</a></figcaption>
    </figure>
    </div>
  </section>

  <section class="services-cta" data-final-cta aria-labelledby="services-cta-title">
    <div class="container services-cta__inner">
      <h2 id="services-cta-title">Not sure which membership? Start with a visit.</h2>
      <p>Your first visit is where Liliana reviews your goals, history and current care. She explains which options may fit and what happens if a requested treatment is not appropriate.</p>
      <div class="services-actions">
        <a href="/start/" class="btn btn--bronze">Book a visit</a>
        <a href="/contact/" class="btn">Ask a question</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hero { padding: var(--section-pad) 0 3rem; background: var(--surface-subtle); }
  .services-hero__inner { display: grid; gap: 1.25rem; }
  .services-hero h1 { max-width: 20ch; }
  .services-hero .lead { max-width: 57ch; }
  .services-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .first-visit { padding: 2.5rem 0; background: var(--surface-card); border-bottom: 1px solid var(--border-subtle); }
  .first-visit__inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .first-visit h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0.5rem 0 1rem; }
  .first-visit p { font-size: 1rem; }
  .first-visit__cost { display: grid; gap: 0.75rem; padding: 1.5rem; background: var(--surface-page); border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .first-visit__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; }
  .first-visit__price strong { font-size: 2.25rem; line-height: 1.15; }
  .text-link { display: inline-flex; align-items: center; min-height: 48px; font-size: 1rem; font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; }
  .section-head { display: grid; gap: 0.75rem; margin-bottom: 2rem; max-width: 72ch; }
  .plans-commitment { font-size: 1rem; padding-top: 0.5rem; }
  .plans-commitment a, .care-guide a, .policies__list a { text-decoration: underline; text-underline-offset: 0.2em; }
  .plan-jump { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
  .plan-jump a { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0.35rem; min-height: 48px; padding: 0.625rem 0.875rem; border: 1px solid var(--border-control); border-radius: var(--radius-sm); font-size: 0.9375rem; line-height: 1.4; }
  .plan-jump a span { color: var(--text-secondary); }
  .plan-jump a:hover { background: var(--surface-subtle); }
  .prog-grid { display: grid; gap: 1.5rem; }
  .prog-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.5rem 3rem; padding: clamp(1.25rem, 3vw, 2rem); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .prog-card__overview { display: grid; gap: 1rem; }
  .prog-card__head { display: grid; gap: 0.5rem; }
  .prog-card__tier { font-size: 0.9375rem; font-weight: 600; color: var(--text-secondary); }
  .prog-card__name { font-size: 1.5rem; }
  .prog-card__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.35rem; }
  .prog-card__price strong { font-size: 2.25rem; line-height: 1.15; }
  .prog-card__price span { font-size: 0.9375rem; color: var(--text-secondary); }
  .prog-card__tagline { font-weight: 600; font-size: 1rem; }
  .prog-card__body { font-size: 1rem; line-height: 1.65; color: var(--text-secondary); }
  .prog-card__inclusions { border-left: 1px solid var(--border-subtle); padding-left: 2rem; }
  .prog-card h4 { font-size: 1rem; line-height: 1.5; margin-bottom: 0.75rem; }
  .prog-card__includes { display: grid; gap: 0.75rem; font-size: 1rem; }
  .prog-card__includes li { padding-left: 1.25rem; position: relative; }
  .prog-card__includes li::before { content: '✓'; position: absolute; left: 0; font-weight: 600; }
  .prog-card__fit { grid-column: 1 / -1; border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle); }
  .prog-card__fit summary { padding: 0.875rem 0.25rem; min-height: 48px; cursor: pointer; font-weight: 600; font-size: 1rem; line-height: 1.5; }
  .prog-card__fit-content { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 3rem; padding: 0.5rem 0 1.5rem; }
  .prog-card__fit-content ul { list-style: disc; padding-left: 1.25rem; display: grid; gap: 0.5rem; font-size: 1rem; color: var(--text-secondary); }
  .prog-card__action { grid-column: 1 / -1; }
  .services-pricing-note { padding-top: 1.5rem; font-size: 0.9375rem; color: var(--text-secondary); }
  .policies { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: 2rem 4rem; }
  .policies h2 { margin-top: 0.75rem; }
  .policies__list { list-style: decimal; padding-left: 1.25rem; }
  .policies__list li { padding: 0.75rem 0 0.75rem 0.35rem; border-bottom: 1px solid var(--border-subtle); font-size: 1rem; }
  .policies__list li:first-child { padding-top: 0; }
  .pillars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .pillar__link { display: flex; flex-direction: column; gap: 0.75rem; height: 100%; padding: 1.5rem; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius); }
  .pillar__link:hover { border-color: var(--border-control); }
  .pillar__link h3 { font-size: 1.25rem; }
  .pillar__link p { font-size: 1rem; color: var(--text-secondary); }
  .pillar__link .text-link { margin-top: auto; }
  .care-guide { margin-top: 1.5rem; font-size: 0.9375rem; color: var(--text-secondary); }
  .provider-section { background: var(--surface-subtle); }
  .provider-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 4rem; align-items: center; }
  .provider-grid h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0.75rem 0 1rem; }
  .provider-grid p { font-size: 1rem; }
  .membership-basics { display: grid; gap: 0.5rem; margin: 1rem 0 0.5rem; padding-left: 1.25rem; list-style: disc; font-size: 0.9375rem; }
  .services-quote { display: grid; gap: 1rem; }
  .services-quote .pullquote { font-size: clamp(1.25rem, 2vw, 1.5rem); }
  .services-quote a { text-decoration: underline; text-underline-offset: 0.2em; }
  .services-cta { background: var(--surface-inverse); color: var(--text-inverse); padding: var(--section-pad) 0; --focus-ring: var(--action-primary); }
  .services-cta__inner { display: grid; gap: 1rem; max-width: 960px; }
  .services-cta h2 { max-width: 28ch; }
  .services-cta p { max-width: 64ch; }
  .services-cta .btn:not(.btn--bronze) { color: var(--text-inverse); border-color: var(--text-inverse); }
  .services-cta .btn:not(.btn--bronze):hover { background: var(--text-inverse); color: var(--text-primary); }
  @media (max-width: 800px) {
    .first-visit__inner, .prog-card, .policies, .provider-grid { grid-template-columns: 1fr; }
    .prog-card__inclusions { border-left: 0; border-top: 1px solid var(--border-subtle); padding: 1.25rem 0 0; }
    .prog-card__fit-content { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .services-hero { padding: 3rem 0 2.5rem; }
    .services-actions { display: grid; grid-template-columns: 1fr; }
    .first-visit { padding: 2rem 0; }
    .first-visit__cost { padding: 1.25rem; }
    .plan-jump { display: grid; grid-template-columns: 1fr; }
    .plan-jump a { justify-content: space-between; }
    .prog-card { gap: 1.25rem; }
    .prog-card__action .btn { width: 100%; }
    .pillars { grid-template-columns: 1fr; }
    .pillar__link { padding: 1.25rem; }
  }
</style>
