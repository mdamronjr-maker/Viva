---
import Layout from '../layouts/Layout.astro';
import NoPhiNotice from '../components/NoPhiNotice.astro';
import { TURNSTILE_SITEKEY } from '../lib/turnstile';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://vivawellnessco.com/contact/' },
  ],
};
const sent = Astro.url.searchParams.get('sent') === '1';
---

<Layout
  title="Contact Viva Wellness Co. | Scheduling Questions"
  description="Contact Viva Wellness Co. for scheduling, pricing, partnerships, or other non-clinical questions. Clinical communication belongs in the secure patient portal."
  schema={contactSchema}
>

  <section class="contact-hero">
    <div class="container contact-hero__inner">
      <span class="eyebrow">Non-clinical contact</span>
      <h1 class="contact-hero__title">
        Questions before you book?<br/>
        <span class="italic-display">Ask Viva.</span>
      </h1>
      <p class="lead">
        Use this page for scheduling, pricing, partnerships, or website questions.
        Please keep symptoms, labs, medication details, and other clinical information
        inside the secure patient portal.
      </p>
    </div>
  </section>

  <section class="contact-body">
    <div class="container contact-body__grid">
      <div class="contact-body__form-wrap">
        <NoPhiNotice />
        {sent && <p class="contact-sent" role="status">Viva received your contact request.</p>}
        <form class="contact-form" id="contact-form" method="post" action="/api/lead">
          <input type="hidden" name="source" value="contact" />
          <div class="field">
            <label for="c-name" class="field__label">Your name</label>
            <input
              id="c-name"
              name="name"
              type="text"
              class="field__input"
              autocomplete="name"
              required
              maxlength="200"
              placeholder="First and last"
              aria-describedby="c-name-error"
            />
            <span class="field__error" id="c-name-error" aria-live="polite"></span>
          </div>

          <div class="field">
            <label for="c-email" class="field__label">Email</label>
            <input
              id="c-email"
              name="email"
              type="email"
              class="field__input"
              autocomplete="email"
              required
              maxlength="254"
              placeholder="you@example.com"
              aria-describedby="c-email-error"
            />
            <span class="field__error" id="c-email-error" aria-live="polite"></span>
          </div>

          <div class="field">
            <label for="c-phone" class="field__label">Phone</label>
            <input
              id="c-phone"
              name="phone"
              type="tel"
              class="field__input"
              autocomplete="tel"
              maxlength="40"
              placeholder="(512) 555-0123"
              aria-describedby="c-phone-hint"
            />
            <span class="field__hint" id="c-phone-hint">Optional. Used only to respond to this request.</span>
          </div>

          <div class="field">
            <label for="c-message" class="field__label">What can we help with?</label>
            <select id="c-message" name="message" class="field__select" required aria-describedby="c-message-hint c-message-error">
              <option value="">Choose one</option>
              <option value="Scheduling or first-visit question">Scheduling or first-visit question</option>
              <option value="Pricing or membership question">Pricing or membership question</option>
              <option value="Partnership or media question">Partnership or media question</option>
              <option value="Website or email question">Website or email question</option>
              <option value="Other non-clinical question">Other non-clinical question</option>
            </select>
            <span class="field__hint" id="c-message-hint">No symptoms, diagnoses, labs, or medication details. Liliana can discuss those only through the clinical intake and secure portal.</span>
            <span class="field__error" id="c-message-error" aria-live="polite"></span>
          </div>

          <label class="contact-consent">
            <input type="checkbox" name="marketing_consent" value="yes" />
            <span>Email me occasional Viva practice updates and new educational articles. Optional; you can unsubscribe anytime.</span>
          </label>

          {/* Honeypot · spam trap, hidden from real users */}
          <div class="hp" aria-hidden="true">
            <label>Leave this empty
              <input name="company" type="text" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="light"></div>

          <button type="submit" class="btn btn--bronze" id="c-submit">Send contact request</button>

          <div class="contact-form__status" id="c-status" role="status" aria-live="polite"></div>
        </form>
      </div>

      <aside class="contact-side">
        <div class="contact-side__card">
          <span class="eyebrow">Prefer to skip the form?</span>
          <ul class="contact-side__list">
            <li>
              <span class="contact-side__k">Call or text</span>
              <a href="tel:+17372107283" class="contact-side__v">(737) 210-7283</a>
            </li>
            <li>
              <span class="contact-side__k">Email</span>
              <a href="mailto:info&#64;vivawellnessco.com" class="contact-side__v">info&#64;vivawellnessco.com</a>
            </li>
          </ul>
          <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=contact_side" class="btn btn--bronze contact-side__book">Book your first visit</a>
        </div>

        <div class="contact-side__heading">
          <span class="eyebrow">What happens next</span>
        </div>
        <div class="contact-side__panel">
          <span class="contact-side__num">01</span>
          <h3>Viva receives your request</h3>
          <p>Your contact details and selected non-clinical topic go to the practice. Educational emails are sent only when you opt in.</p>
        </div>
        <div class="contact-side__panel">
          <span class="contact-side__num">02</span>
          <h3>A real person reviews it</h3>
          <p>Liliana or the practice follows up about the scheduling, pricing, or general question you selected.</p>
        </div>
        <div class="contact-side__panel">
          <span class="contact-side__num">03</span>
          <h3>Clinical details stay secure</h3>
          <p>Patient care, lab results, and medication questions move to the HIPAA-compliant patient portal.</p>
        </div>
      </aside>
    </div>
  </section>

</Layout>

<script>
  // Re-bound on every astro:page-load so view transitions get fresh listeners.
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('c-status') as HTMLDivElement | null;
    const submit = document.getElementById('c-submit') as HTMLButtonElement | null;
    if (!form || !status || !submit) return;
    const nameInput = document.getElementById('c-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('c-email') as HTMLInputElement | null;
    const topicInput = document.getElementById('c-message') as HTMLSelectElement | null;
    const nameError = document.getElementById('c-name-error');
    const emailError = document.getElementById('c-email-error');
    const topicError = document.getElementById('c-message-error');
    const tsEl = form.querySelector('.cf-turnstile') as HTMLElement | null;
    const ts = () => (window as any).turnstile;
    if (tsEl && ts() && !tsEl.querySelector('iframe')) {
      try { ts().render(tsEl, { sitekey: tsEl.getAttribute('data-sitekey') }); } catch (e) {}
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'contact-form__status';
      for (const input of [nameInput, emailInput, topicInput]) input?.removeAttribute('aria-invalid');
      for (const error of [nameError, emailError, topicError]) if (error) error.textContent = '';

      const data = new FormData(form);
      const utm: Record<string, string> = {};
      const params = new URLSearchParams(window.location.search);
      for (const k of ['utm_source','utm_medium','utm_campaign','utm_content'] as const) {
        const v = params.get(k);
        if (v && v.length <= 120) utm[k] = v;
      }
      const payload = {
        source: 'contact',
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        phone: String(data.get('phone') || '').trim(),
        message: String(data.get('message') || '').trim(),
        company: String(data.get('company') || '').trim(), // honeypot
        marketingConsent: data.get('marketing_consent') === 'yes',
        turnstileToken: String(data.get('cf-turnstile-response') || ''),
        utm,
      };

      let firstInvalid: HTMLInputElement | HTMLSelectElement | null = null;
      if (!payload.name) {
        nameInput?.setAttribute('aria-invalid', 'true');
        if (nameError) nameError.textContent = 'Enter your name.';
        firstInvalid = nameInput;
      }
      if (!payload.email || !emailInput?.validity.valid) {
        emailInput?.setAttribute('aria-invalid', 'true');
        if (emailError) emailError.textContent = 'Enter a valid email address.';
        firstInvalid ||= emailInput;
      }
      if (!payload.message) {
        topicInput?.setAttribute('aria-invalid', 'true');
        if (topicError) topicError.textContent = 'Choose a non-clinical topic.';
        firstInvalid ||= topicInput;
      }
      if (firstInvalid) {
        status.textContent = 'Check the highlighted fields.';
        status.classList.add('is-error');
        firstInvalid.focus();
        return;
      }

      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = 'Sending';

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) {
          throw new Error(json.error || 'Something went wrong. Try again or email info@vivawellnessco.com.');
        }
        status.textContent = payload.marketingConsent
          ? 'Sent. Your contact request is in, and your email preference is saved.'
          : 'Sent. Viva received your contact request.';
        status.classList.add('is-success');
        form.reset();
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Send failed. Try again.';
        status.classList.add('is-error');
        try { if (tsEl && ts()) ts().reset(tsEl); } catch (e) {}
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.textContent = 'Send contact request';
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-hero {
    padding: clamp(5rem, 12vw, 9rem) 0 clamp(2rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .contact-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .contact-hero__inner {
    position: relative;
    max-width: 60ch;
  }
  .contact-hero__title {
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 1rem 0 1.5rem;
  }

  .contact-body {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(5rem, 10vw, 8rem);
  }
  .contact-body__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-body__grid { grid-template-columns: 1fr; }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 540px;
  }
  .contact-form .btn { align-self: flex-start; margin-top: 0.5rem; }
  .contact-sent { background: var(--sage); border-left: 4px solid var(--evergreen); padding: 1rem 1.2rem; margin-bottom: 1.5rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-consent {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.75rem;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--mute);
    cursor: pointer;
  }
  .contact-consent input { width: 1.1rem; height: 1.1rem; margin-top: 0.2rem; }

  .contact-form__status {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    min-height: 1.2em;
    padding: 0.4rem 0;
  }
  .contact-form__status.is-success { color: var(--bronze-bright); }
  .contact-form__status.is-error { color: #e76e6e; }

  .contact-side {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .contact-side__book { display: block; margin-top: 1.3rem; text-align: center; }
  .contact-side__card {
    background: var(--ink-2);
    border: 1px solid var(--rule-strong);
    padding: 1.8rem 1.6rem;
    border-radius: 2px;
  }
  .contact-side__card .eyebrow { display: block; margin-bottom: 1.2rem; }
  .contact-side__list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .contact-side__list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .contact-side__k {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .contact-side__v {
    font-family: var(--font-display-italic);
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease), color 200ms var(--ease);
    align-self: flex-start;
  }
  .contact-side__v:hover {
    color: var(--bronze-bright);
    border-bottom-color: var(--bronze);
  }

  .contact-side__heading {
    margin-top: 0.2rem;
    padding-top: 0.4rem;
  }
  .contact-side__panel {
    padding: 1.2rem 0;
    border-top: 1px solid var(--rule);
  }
  .contact-side__heading + .contact-side__panel { border-top: 0; padding-top: 0.8rem; }
  .contact-side__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--bronze);
    display: block;
    margin-bottom: 0.6rem;
  }
  .contact-side__panel h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
    color: var(--paper);
  }
  .contact-side__panel p {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.93rem;
    line-height: 1.55;
    max-width: 36ch;
  }
  @media (max-width: 720px) {
    .contact-hero { padding: 3.75rem 0 2.25rem; }
    .contact-hero__title { margin: 0.75rem 0 1.15rem; }
    .contact-body { padding: 1.75rem 0 4rem; }
    .contact-form { gap: 1.3rem; }
    .contact-side__card { padding: 1.4rem 1.25rem; }
  }
</style>
