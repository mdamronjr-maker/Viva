---
import Layout from '../layouts/Layout.astro';

const standards = [
  { num: '01', title: 'Liliana reviews your care', body: 'Your history, goals, options, and follow-up decisions are reviewed by the named provider you meet. A website questionnaire never determines eligibility or produces a prescription.' },
  { num: '02', title: 'Medication status is stated plainly', body: 'When a compounded medication is considered, Viva explains that it is not FDA-approved and discusses the exact product, dispensing pharmacy, alternatives, and limitations. No compounded product is presented as a generic or equivalent version of an FDA-approved drug.' },
  { num: '03', title: 'Follow-up is part of the plan', body: 'Ongoing memberships include the provider access and check-ins listed for that tier. Clinical messages move through the secure patient portal.' },
  { num: '04', title: 'Prices spell out the inclusions', body: 'Each plan lists what is included and what remains separate. Medication, supplies, delivery, and labs are bundled only where the plan specifically says so.' },
];
---

<Layout
  title="About Liliana Damron, APRN, FNP-BC | Viva Wellness Co."
  description="Meet Liliana Damron, APRN, FNP-BC, the founder and named provider behind Viva's telehealth care for adults in Texas, Colorado, Florida, and Iowa."
  schema={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': 'https://vivawellnessco.com/about/#liliana',
        name: 'Liliana Damron',
        honorificSuffix: 'APRN, FNP-BC',
        jobTitle: 'Family Nurse Practitioner, Founder',
        description: 'Founder and named provider of Viva Wellness Co., an Austin-based telehealth practice serving adults in Texas, Colorado, Florida, and Iowa.',
        worksFor: { '@id': 'https://vivawellnessco.com/#organization' },
        image: 'https://vivawellnessco.com/liliana-founder-portrait-v2.webp',
        url: 'https://vivawellnessco.com/about/',
        knowsAbout: ['Weight Management', 'Menopause Care', 'Hormone Therapy', 'Telehealth', 'Geriatric Medicine'],
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
          { '@type': 'ListItem', position: 2, name: 'Provider', item: 'https://vivawellnessco.com/about/' },
        ],
      },
    ],
  }}
>

  {/* HERO */}
  <section class="about-hero">
    <div class="container about-hero__inner">
      <span class="eyebrow">The provider</span>
      <h1 class="about-hero__title">
        Meet your<br/>
        <span class="italic-display">provider.</span>
      </h1>
      <p class="lead">
        I'm Liliana Damron, APRN, FNP-BC. My background caring for older adults
        made me want to help people ask better questions earlier, while they are
        balancing work, family, training, and their own health. Your first visit
        is with me, not a delegate.
      </p>
    </div>
  </section>

  {/* FOUNDER */}
  <section class="section section--paper">
    <div class="container founder">
      <div class="founder__media">
        <div class="founder__frame" transition:name="provider-photo">
          <img
            src="/liliana-founder-portrait-v2.webp"
            srcset="/liliana-founder-portrait-sm.webp 640w, /liliana-founder-portrait-v2.webp 2048w"
            sizes="(max-width: 900px) min(100vw - 40px, 512px), min(42vw, 512px)"
            alt="Liliana Damron, APRN, FNP-BC"
            width="2048"
            height="3072"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="founder__caption">
          <div>Liliana Damron</div>
          <div class="founder__creds">APRN, FNP-BC · Founder</div>
        </div>
      </div>
      <div class="founder__copy">
        <span class="eyebrow">The founder</span>
        <h2 class="founder__title">
          Viva grew from a simple question: what if care started earlier?
        </h2>
        <p class="lead">
          In geriatric care, I saw how health changes can affect strength,
          independence, and the texture of everyday life. I also heard a common
          frustration: people wished they had understood their options and paid
          attention to changing symptoms sooner.
        </p>
        <p>
          That experience shaped Viva. This is a place for adults who want a
          thoughtful evaluation without adding another waiting room to an
          already full week. The work starts with listening, reviewing the
          relevant history, and separating a plausible care option from a good
          marketing story.
        </p>
        <p>
          My goal is straightforward: explain the tradeoffs, make the next step
          manageable, and stay involved when ongoing care is appropriate.
          Telehealth makes access easier; it does not replace clinical judgment,
          guarantee a prescription, or promise an outcome.
        </p>
      </div>
    </div>
  </section>

  {/* STANDARDS */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The standards</span>
        <h2 class="section-head__title">
          What concierge means here.
        </h2>
        <p class="lead section-head__lead">
          Concierge should describe how care works, not serve as a vague premium
          label. Here is what patients can expect from Viva in practice.
        </p>
      </div>

      <ol class="standards">
        {standards.map((s) => (
          <li class="standard">
            <span class="standard__num">{s.num}</span>
            <div class="standard__content">
              <h3 class="standard__title">{s.title}</h3>
              <p class="standard__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* SERVICE AREA */}
  <section class="section">
    <div class="container service-area">
      <div>
        <span class="eyebrow">The reach</span>
        <h2 class="service-area__title">
          Licensed where you already are.
        </h2>
        <p class="lead">
          Viva is 100% telehealth. We meet by secure video, follow-ups happen by
          message or video, and eligible medications or supplies may be delivered
          when the selected plan includes them. No commute, waiting room, or parking garage.
        </p>
        <p>
          I am currently licensed to see patients in Texas, Colorado, Florida,
          and Iowa. You must be physically located in a supported state at the
          time of a clinical visit.
        </p>
      </div>
      <div class="states">
        <div class="state state--active">
          <div class="state__abbrev">TX</div>
          <div class="state__name">Texas</div>
          <div class="state__status">Active</div>
        </div>
        <div class="state state--active">
          <div class="state__abbrev">CO</div>
          <div class="state__name">Colorado</div>
          <div class="state__status">Active</div>
        </div>
        <div class="state state--active">
          <div class="state__abbrev">FL</div>
          <div class="state__name">Florida</div>
          <div class="state__status">Active</div>
        </div>
        <div class="state state--active">
          <div class="state__abbrev">IA</div>
          <div class="state__name">Iowa</div>
          <div class="state__status">Active</div>
        </div>
        <a class="state state--add" href="/contact/">
          <div class="state__abbrev">?</div>
          <div class="state__name">Outside these states?</div>
          <div class="state__status">Contact Viva</div>
        </a>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="about-cta">
    <div class="container about-cta__inner">
      <h2 class="about-cta__title">
        It starts with one visit.
      </h2>
      <div class="about-cta__ctas">
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=about_cta" class="btn btn--bronze">Book your first visit</a>
        <a href="/#quiz" class="btn">Use the care-path guide</a>
        <a href="/services/" class="btn">Compare care &amp; pricing</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .about-hero {
    padding: clamp(6rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .about-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1100px;
  }
  .about-hero__title {
    font-size: clamp(2.6rem, 6.8vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
    max-width: 14ch;
  }

  /* FOUNDER */
  .founder {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  @media (max-width: 900px) { .founder { grid-template-columns: 1fr; } }
  .founder__media {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: min(100%, 32rem);
  }
  @media (max-width: 900px) { .founder__media { position: static; } }
  .founder__frame {
    aspect-ratio: 2/3;
    background: linear-gradient(135deg, var(--bronze-deep) 0%, var(--ink-3) 100%);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem 1.25rem 6rem 1.25rem;
    border-left: 8px solid var(--terracotta);
  }
  .founder__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    position: relative;
    z-index: 2;
  }
  .founder__mono {
    font-family: var(--font-display);
    font-size: clamp(8rem, 16vw, 16rem);
    font-style: italic;
    color: var(--paper);
    font-variation-settings: 'opsz' 144, 'SOFT' 70;
    position: relative;
    z-index: 1;
  }
  .founder__caption {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--paper);
    line-height: 1.4;
  }
  .founder__creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-top: 0.4rem;
  }
  .founder__title {
    font-size: clamp(2rem, 4.8vw, 3.5rem);
    margin-bottom: 1.8rem;
    max-width: 20ch;
  }
  .founder__copy p { margin-bottom: 1.3rem; max-width: 62ch; }

  /* STANDARDS */
  .standards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .standard {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .standard__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--bronze);
    letter-spacing: 0.12em;
    padding-top: 0.5rem;
  }
  .standard__title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    margin-bottom: 0.7rem;
    line-height: 1.1;
  }
  .standard__body {
    color: rgba(28, 35, 27, 0.75);
    max-width: 60ch;
    font-size: 1.05rem;
  }
  @media (max-width: 600px) {
    .standard { grid-template-columns: 1fr; gap: 0.8rem; padding: 2rem 0; }
  }

  /* SERVICE AREA */
  .service-area {
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  @media (max-width: 900px) { .service-area { grid-template-columns: 1fr; } }
  .service-area__title {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    margin: 1rem 0 1.2rem;
    max-width: 18ch;
  }
  .service-area p { margin-bottom: 1.2rem; max-width: 56ch; }
  .states {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--rule-strong);
    border: 1px solid var(--rule-strong);
  }
  .state[hidden] { display: none; }
  .state {
    background: var(--ink);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: background 220ms var(--ease);
  }
  .state__abbrev {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 360;
    line-height: 1;
    color: var(--paper);
  }
  .state--active .state__abbrev { color: var(--bronze); }
  .state__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--paper);
    margin-top: 0.3rem;
  }
  .state__status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .state--active .state__status { color: var(--bronze); }

  /* CTA */
  .about-cta {
    padding: clamp(5rem, 10vw, 9rem) 0;
    text-align: center;
    background: var(--evergreen);
    color: var(--cream-bright);
    position: relative;
    overflow: hidden;
    border-top: 6px solid var(--terracotta);
  }
  .about-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .about-cta__inner { position: relative; }
  .about-cta__title {
    font-size: clamp(2rem, 5vw, 4rem);
    margin-bottom: 2rem;
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }
  .about-cta__ctas { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
  .about-cta .btn:not(.btn--bronze) { color: var(--cream-bright); border-color: var(--cream-bright); }
  .about-cta .btn:not(.btn--bronze):hover { background: var(--cream-bright); color: var(--evergreen-deep); }
  @media (max-width: 720px) {
    .about-hero { padding: 3.75rem 0 3rem; }
    .about-hero__inner { gap: 1.4rem; }
    .about-hero__title { font-size: clamp(2.25rem, 10.5vw, 2.8rem); }
    .standard { padding: 1.5rem 0; }
    .state { padding: 1.5rem 1.2rem; }
    .about-cta { padding: 4rem 0; }
    .about-cta__ctas { display: grid; grid-template-columns: 1fr; }
    .about-cta__ctas .btn { width: 100%; justify-content: center; }
  }
</style>
