<script>
  // Testimonial carousel · prev/next arrows + longer interval for reading.
  let tRotatorTimer: number | undefined;
  // Document-level visibilitychange handler, kept at module scope so each
  // astro:page-load can remove the previous (stale-closure) one before rebinding.
  let tVisHandler: (() => void) | undefined;

  function initTestimonialsRotator() {
    const rotator = document.querySelector('[data-trotator]') as HTMLElement | null;
    if (!rotator) return;
    const slides = rotator.querySelectorAll('[data-tslide]');
    const dots = rotator.querySelectorAll('[data-tdot]');
    const prev = rotator.querySelector('[data-tprev]') as HTMLButtonElement | null;
    const next = rotator.querySelector('[data-tnext]') as HTMLButtonElement | null;
    const playPause = rotator.querySelector('[data-tplaypause]') as HTMLButtonElement | null;
    if (slides.length === 0) return;
    let i = 0;
    let paused = true; // autoplay OFF by default (Lights On motion budget)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVAL = 6000;
    function show(idx: number) {
      const safe = ((idx % slides.length) + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const on = n === safe;
        s.classList.toggle('is-active', on);
        // keep inactive reviews out of the a11y tree so SR users hear one at a time
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((d, n) => {
        const on = n === safe;
        d.classList.toggle('is-active', on);
        if (on) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
      i = safe;
    }
    function go(delta: number) { show(i + delta); start(); }
    // autoplay is suppressed when the user paused or prefers reduced motion (WCAG 2.2.2)
    function start() { stop(); if (paused || reduceMotion) return; tRotatorTimer = window.setInterval(() => show(i + 1), INTERVAL); }
    function stop() { if (tRotatorTimer) clearInterval(tRotatorTimer); tRotatorTimer = undefined; }
    function setPaused(p: boolean) {
      paused = p;
      if (playPause) {
        // aria-pressed represents whether automatic rotation is active, so it
        // is the inverse of the internal paused flag.
        playPause.setAttribute('aria-pressed', String(!p));
        playPause.setAttribute('aria-label', p ? 'Play automatic review rotation' : 'Pause automatic review rotation');
        playPause.textContent = p ? '▶' : '⏸';
      }
      if (p) stop(); else start();
    }
    dots.forEach((d, n) => d.addEventListener('click', () => { show(n); start(); }));
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    playPause?.addEventListener('click', () => setPaused(!paused));
    rotator.addEventListener('mouseenter', stop);
    rotator.addEventListener('mouseleave', start);
    // keyboard users: pause while focus is inside the rotator, resume when it leaves
    rotator.addEventListener('focusin', stop);
    rotator.addEventListener('focusout', (e) => { if (!rotator.contains(e.relatedTarget as Node)) start(); });
    if (tVisHandler) document.removeEventListener('visibilitychange', tVisHandler);
    tVisHandler = () => { if (document.hidden) stop(); else start(); };
    document.addEventListener('visibilitychange', tVisHandler);
    show(0);
    // Autoplay stays off until the visitor explicitly starts it; the play
    // control and the reduced-motion preference share the same paused state.
    setPaused(true);
  }

  document.addEventListener('astro:page-load', initTestimonialsRotator);
  document.addEventListener('astro:before-swap', () => {
    if (tRotatorTimer) { clearInterval(tRotatorTimer); tRotatorTimer = undefined; }
    // Always exit quiz focus mode before navigation so the next page renders normally
    document.body.classList.remove('quiz-focus');
  });
</script>

<script>
  import { match, type Answers } from '../lib/quiz';

  // Document-level Escape handler for quiz focus mode, kept at module scope so
  // each astro:page-load removes the previous binding before re-adding it.
  let qxKeyHandler: ((e: KeyboardEvent) => void) | undefined;

  // Wrapped in an init function and rebound on every astro:page-load so
  // view transitions reset quiz state and rebind to the freshly-rendered DOM.
  function initQuiz() {
  const TOTAL = 3;
  const state = { step: 1, answers: {} as Answers };

  const stepEls = document.querySelectorAll('.qx__step') as NodeListOf<HTMLDivElement>;
  const bar = document.getElementById('qx-bar') as HTMLDivElement | null;
  const meta = document.getElementById('qx-step-label') as HTMLSpanElement | null;
  const back = document.getElementById('qx-back') as HTMLButtonElement | null;
  const section = document.getElementById('quiz') as HTMLElement | null;

  // Only run on pages that have the quiz markup (home only)
  if (stepEls.length === 0) return;

  function render() {
    stepEls.forEach((el) => {
      el.classList.toggle('is-active', Number(el.dataset.step) === state.step);
    });
    const pct = state.step <= TOTAL ? ((state.step - 1) / TOTAL) * 100 : 100;
    if (bar) bar.style.width = `${pct}%`;
    if (meta) {
      if (state.step <= TOTAL) meta.textContent = `Question ${state.step} of ${TOTAL}`;
      else meta.textContent = 'Your starting point';
    }
    if (back) back.hidden = state.step <= 1 || state.step > TOTAL;
    // In focus mode the body is locked with overflow:hidden, so scrollIntoView
    // on the section is a no-op. The .qx element itself is the scroll container
    // there — reset its scrollTop so every new step starts at the top. Outside
    // focus mode (first click hasn't happened yet), fall back to scrolling the
    // page so the quiz block lines up under the sticky header.
    if (document.body.classList.contains('quiz-focus')) {
      section?.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    // Move keyboard + SR focus to the active step on every advance so users
    // don't get dumped on <body> (the clicked option is display:none'd) and
    // screen readers voice the new question / result. render() only runs after
    // a user action, so this never steals focus on initial load.
    const activeStep = stepEls[state.step - 1] as HTMLElement | undefined;
    if (state.step === TOTAL + 1) {
      activeStep?.focus({ preventScroll: true });
    } else {
      (activeStep?.querySelector('.qx__q') as HTMLElement | null)?.focus({ preventScroll: true });
    }
  }

  // Focus mode · entered when the user clicks their first answer, exited via
  // X / Escape / navigation. Idempotent class toggle.
  function enterFocus() {
    if (document.body.classList.contains('quiz-focus')) return;
    document.body.classList.add('quiz-focus');
    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
  }
  function exitFocus() {
    if (!document.body.classList.contains('quiz-focus')) return;
    document.body.classList.remove('quiz-focus');
    document.getElementById('quiz')?.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });
  }

  document.querySelectorAll('.qx__opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = (btn as HTMLElement).dataset.q as keyof Answers;
      const v = (btn as HTMLElement).dataset.v as string;
      if (!q || !v) return;
      state.answers[q] = v;
      if (state.step === TOTAL) {
        const m = match(state.answers);
        document.getElementById('qx-r-name')!.textContent = m.name;
        document.getElementById('qx-r-price')!.textContent = m.price;
        document.getElementById('qx-r-body')!.textContent = m.body;
        document.getElementById('qx-r-list')!.innerHTML = m.bullets.map((b) => `<li>${b}</li>`).join('');
        document.getElementById('qx-r-discuss')!.innerHTML = m.discuss.map((b) => `<li>${b}</li>`).join('');
        state.step = TOTAL + 1;
      } else {
        state.step += 1;
      }
      enterFocus();
      render();
    });
  });

  back?.addEventListener('click', () => {
    if (state.step > 1) { state.step -= 1; render(); }
  });

  document.getElementById('qx-exit')?.addEventListener('click', exitFocus);
  if (qxKeyHandler) document.removeEventListener('keydown', qxKeyHandler);
  qxKeyHandler = (e) => {
    if (e.key === 'Escape' && document.body.classList.contains('quiz-focus')) exitFocus();
  };
  document.addEventListener('keydown', qxKeyHandler);

  } // end initQuiz

  document.addEventListener('astro:page-load', initQuiz);
</script>

