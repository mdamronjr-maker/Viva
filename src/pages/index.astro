---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'Is Viva Wellness Co. accepting new patients?',
    a: "Yes. I'm licensed in Texas, Colorado, Florida, and Iowa and currently accepting new patients in all four states. The booking page shows current appointment availability.",
  },
  {
    q: 'Which states are you licensed in?',
    a: 'Texas, Colorado, Florida, and Iowa. Viva is a one-hundred-percent telehealth practice, so visits happen by secure video wherever you are physically located in one of those states at the time of the appointment.',
  },
  {
    q: 'Do you accept insurance?',
    a: 'Memberships are not billed to insurance. I accept FSA and HSA cards for membership fees. For labs and non-compounded medications outside the membership, insurance can be applied. Many patients use the Viva Concierge tier specifically to keep their existing insurance for labs and prescriptions.',
  },
  {
    q: 'Where are your medications sourced from?',
    a: 'When a compounded medication is prescribed, the prescription is sent to a 503A compounding pharmacy for an individually identified patient. Compounded medications are not FDA-approved finished products. Ask Liliana to identify the dispensing pharmacy and explain product status, alternatives, and current availability before you decide.',
  },
  {
    q: 'Are compounded GLP-1 medications the same as FDA-approved brands?',
    a: 'No. FDA-approved brand medications and compounded medications are different products. Compounded drugs are not FDA-approved, and FDA does not review them for safety, effectiveness, or quality before they are dispensed. Whether any medication is available and appropriate depends on current law, supply, and an individual clinical evaluation. Liliana reviews the options, limitations, and costs with you before anything is prescribed.',
  },
  {
    q: 'Does Viva offer peptide therapy consultations?',
    a: 'Yes. Viva evaluates adults who are considering peptide therapy, but there is no automatic prescription or guaranteed product menu. Liliana reviews the exact option, evidence, regulatory status, alternatives, and current availability during an individual visit. Compounded drugs are not FDA-approved.',
  },
  {
    q: 'Do you treat perimenopause and menopause?',
    a: 'Yes. Liliana evaluates perimenopause and menopause concerns including hot flashes, sleep disruption, concentration, mood, and weight changes without assuming they all have one cause. Treatment is individualized after clinical review and may include prescription or non-prescription options when appropriate.',
    aHtml: 'Yes. Liliana evaluates perimenopause and menopause concerns including hot flashes, sleep disruption, concentration, mood, and weight changes without assuming they all have one cause. See the <a href="/menopause/">menopause care page</a> for the process, pricing, sources, and important limitations.',
  },
  {
    q: 'Does the contact form sign me up for marketing?',
    a: 'No. Viva replies to the non-clinical request you submit. Occasional practice updates and new educational articles are sent only when you select the separate optional email checkbox. Every marketing email includes an unsubscribe option.',
  },
  {
    q: 'Can I cancel my membership?',
    a: 'Yes. Memberships require an initial twelve-week commitment. After that, you can cancel any time with no penalty. Memberships renew automatically every thirty days until you cancel.',
  },
  {
    q: 'What does Viva Concierge at $99 actually include?',
    a: 'Viva Concierge includes direct provider messaging, a monthly evaluation visit, one acute or sick-visit credit each month, lab-order coordination, ongoing medication management, and member pricing on eligible add-ons. Medication is not included unless the plan says it is. Compounded estradiol and progesterone are not included in the $99 membership fee.',
  },
  {
    q: 'Is my health information private?',
    a: "The care-path guide runs in your browser and does not send your answers to Viva. The contact form is for non-clinical questions only. Please do not submit symptoms, lab results, diagnoses, medication details, or other clinical information through this website or regular email. Once you become a patient, clinical communication moves into the HIPAA-compliant patient portal.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const PICON = {
  key: '<path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/>',
  pulse: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  person: '<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/>',
  video: '<path d="m16 13 5 3V8l-5 3"/><rect width="13" height="14" x="3" y="5" rx="2"/>',
  flask: '<path d="M9 3h6"/><path d="M10 9V3h4v6l5 9a2 2 0 0 1-1.74 3H6.74A2 2 0 0 1 5 18z"/><path d="M7 15h10"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5V3h6v1.5"/><path d="m8.5 10 1.3 1.3 2.2-2.5"/><path d="M13.5 10h2.5"/><path d="m8.5 15 1.3 1.3 2.2-2.5"/><path d="M13.5 15h2.5"/>',
  package: '<path d="m16.5 9.4-9-5.19"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/>',
};
const programs = [
  { tier: 'Entry', name: 'Viva Concierge', price: '$99', cadence: '/mo', icon: 'key', href: '/services/#viva-concierge-access', body: 'Monthly provider access, care coordination, and member pricing. Medication is billed separately unless a plan specifically includes it.' },
  { tier: 'Foundational', name: 'TRT All Inclusive', price: '$199', cadence: '/mo', icon: 'pulse', href: '/services/#trt-all-inclusive', body: 'Provider-led testosterone care with the listed medication, supplies, home delivery, follow-up, and twice-yearly labs included.' },
  { tier: 'Essential', name: 'Metabolic Essential', price: '$249', cadence: '/mo', icon: 'leaf', href: '/services/#metabolic-essential', body: 'A lower-cost medical weight-management tier with ongoing provider oversight and the medication listed in the plan when prescribed.' },
  { tier: 'Core', name: 'Metabolic Core', price: '$349', cadence: '/mo', icon: 'flame', href: '/services/#metabolic-core', body: 'A more comprehensive medical weight-management tier with ongoing evaluation, medication management, and follow-up.', featured: true },
];

const testimonials = [
  {
    quote: "The telehealth setup is incredibly convenient and made everything so easy. The care was professional, personal, and I felt truly supported throughout the process.",
    name: 'Nancy Flores',
    role: '',
  },
  {
    quote: "Liliana has cared for my elderly parents since I moved them urgently from Florida. She has been amazing. She picked up on things the docs missed in the hospital and I did as well. She is very smart, capable, and super nice. As a physician, the best reference is that she cares for my family.",
    name: 'Dr. Matt Phillips',
    role: 'Physician',
  },
  {
    quote: "This company and Liliana have changed my life. As a medical provider myself, I can ensure you are in trustworthy hands.",
    name: 'Kaitlin Trevino',
    role: 'Medical provider',
  },
  {
    quote: "Lili has been an exceptional provider throughout my wellness treatment journey. From our very first consultation, she truly understood my needs. She carefully listened as I explained my symptoms.",
    name: 'Priscilla Moraes',
    role: '',
  },
  {
    quote: "I am so very cautious when choosing medical providers to guide me through my own health journey. Liliana exceeded every expectation.",
    name: 'Tobiah Vega',
    role: '',
  },
  {
    quote: "Most competent, caring provider. I get personalized care that's effective and timely. The proof is in the results and in how I feel. Just grateful everyday I found her.",
    name: 'Tiffany Plaster',
    role: '',
  },
];

---

<Layout
  title="Concierge Weight, Hormone & Peptide Telehealth | Viva"
  description="Virtual weight management, menopause, testosterone, peptide consultations, and recovery care with Liliana Damron, APRN, FNP-BC. Serving TX, CO, FL, and IA."
  schema={faqSchema}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <div class="hero__eyebrows">
          <span class="eyebrow" aria-label="Concierge telehealth in Texas, Colorado, Florida, and Iowa">Concierge telehealth · TX · CO · FL · IA</span>
          <span class="hero__eyebrow-secondary">Austin-based · Virtual care</span>
        </div>
        <h1 class="hero__title">Medical weight and hormone care.<span class="hero__title-line">Built around your life.</span></h1>
        <p class="hero__lead">I'm Liliana Damron, APRN, FNP-BC. Get connected care for weight management, hormones, and recovery through virtual visits, local labs when appropriate, and clear self-pay plans.</p>
        <div class="hero__ctas">
          <a href="/start/" class="btn btn--bronze" data-primary-booking>Book a visit</a>
          <a href="#care" class="btn">Explore care</a>
        </div>
        <p class="hero__cost">First visit $199 · $50 deposit at booking</p>
      </div>
      <figure class="hero__media">
        <img src="/liliana-founder-portrait.webp" srcset="/liliana-founder-portrait-sm.webp 640w, /liliana-founder-portrait.webp 1023w" sizes="(max-width: 720px) calc(100vw - 2.5rem), (max-width: 1280px) 40vw, 480px" width="1023" height="1537" alt="Liliana Damron, APRN, FNP-BC, founder of Viva Wellness Co." loading="eager" fetchpriority="high" decoding="async" />
        <figcaption>Liliana Damron <span>APRN, FNP-BC · Your Viva provider</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="section care-paths" id="care" aria-labelledby="care-title">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Care that connects</span><h2 id="care-title">Start with what you need.</h2><p class="lead">A place to discuss what has changed, what you've tried, and what you want your health to support.</p></div>
      <ul class="care-grid" role="list">
        <li><a href="/weight-management/"><h3>Medical weight management</h3><p>Explore metabolic care, GLP-1 questions, and ongoing follow-up.</p><span>Explore weight care →</span></a></li>
        <li><a href="/menopause/"><h3>Menopause &amp; hormone health</h3><p>Discuss perimenopause, changing symptoms, and care options.</p><span>Explore menopause care →</span></a></li>
        <li><a href="/testosterone/"><h3>Testosterone care</h3><p>Understand evaluation, monitoring, and whether treatment fits.</p><span>Explore testosterone care →</span></a></li>
        <li><a href="/peptide-therapy/"><h3>Peptide consultations</h3><p>Bring your questions about evidence, risks, and available options.</p><span>Understand peptide care →</span></a></li>
        <li><a href="/recovery/"><h3>Recovery &amp; active living</h3><p>Discuss training, recovery, and when another kind of care is needed.</p><span>Explore recovery care →</span></a></li>
      </ul>
      <p class="care-boundary">Every prescription requires clinical evaluation. Compounded medications are not FDA-approved. Telehealth does not replace in-person primary, urgent, emergency, or specialist care when those services are needed.</p>
    </div>
  </section>

  <section class="section provider-band section--paper">
    <div class="container provider-band__inner">
      <div class="provider-band__copy"><span class="eyebrow">One named provider</span><h2>Your history stays connected to your care.</h2><p class="lead">Your first visit is with Liliana. She reviews your relevant history, explains options and limitations, and remains the named provider for ongoing Viva care.</p><a href="/about/" class="btn">Meet Liliana</a></div>
      <div class="provider-band__facts" aria-label="Provider facts"><strong>Liliana Damron, APRN, FNP-BC</strong><ul role="list"><li>Board-certified family nurse practitioner</li><li>Licensed in Texas, Colorado, Florida, and Iowa</li><li>Virtual visits with one named provider</li><li>Clinical communication in the secure patient portal</li></ul></div>
    </div>
  </section>
  <section class="testimonials">
    <div class="container">
      <div class="testimonials__head">
        <span class="eyebrow">In their words</span>
        <h2 class="testimonials__title">
          Patient experiences.
        </h2>
        <a href="https://www.google.com/maps/place/Viva+Wellness+Co./@30.448506,-93.3099761,5366828m/data=!3m2!1e3!4b1!4m6!3m5!1s0x838a2a09b2fa0069:0x23603b7d6308b72a!8m2!3d30.448506!4d-93.309976!16s%2Fg%2F11x1q1jhw9" target="_blank" rel="noopener" class="testimonials__rating">
          <span class="testimonials__stars" aria-label="5 out of 5 stars">
            <span class="star"></span><span class="star"></span><span class="star"></span><span class="star"></span><span class="star"></span>
          </span>
          <span class="testimonials__rating-meta">
            <strong>Google reviews</strong>
            <span class="testimonials__rating-link">Verify on Google →</span>
          </span>
        </a>
        <p class="testimonials__disclaimer">
          Individual results vary. Testimonials reflect each reviewer's personal
          experience and are not guarantees of outcome.
        </p>
      </div>

      <div class="t-rotator" data-trotator>
        <div class="t-rotator__track" data-trotator-track>
          {testimonials.map((t, i) => (
            <article class:list={["t-slide", i === 0 && 'is-active']} data-tslide aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="t-slide__stars" role="img" aria-label="5 stars">
                <span class="star"></span><span class="star"></span><span class="star"></span><span class="star"></span><span class="star"></span>
              </div>
              <blockquote class="t-slide__quote">"{t.quote}"</blockquote>
              <footer class="t-slide__author">
                <strong>{t.name}</strong>
                {t.role && <span>{t.role}</span>}
              </footer>
            </article>
          ))}
        </div>

        <div class="t-rotator__controls">
          <button class="t-rotator__nav t-rotator__nav--prev" data-tprev aria-label="Previous review">←</button>
          <div class="t-rotator__dots" data-tdots role="group" aria-label="Customer reviews">
            {testimonials.map((t, i) => (
              <button class:list={["t-dot", i === 0 && 'is-active']} data-tdot={i} aria-label={`Show review from ${t.name}`} aria-current={i === 0 ? 'true' : undefined}></button>
            ))}
          </div>
          <button class="t-rotator__nav t-rotator__nav--next" data-tnext aria-label="Next review">→</button>
          <button class="t-rotator__nav t-rotator__playpause" data-tplaypause aria-label="Play automatic review rotation" aria-pressed="false">▶</button>
        </div>
      </div>

      <div class="testimonials__foot">
        <a href="https://www.google.com/maps/place/Viva+Wellness+Co./@30.448506,-93.3099761,5366828m/data=!3m2!1e3!4b1!4m6!3m5!1s0x838a2a09b2fa0069:0x23603b7d6308b72a!8m2!3d30.448506!4d-93.309976!16s%2Fg%2F11x1q1jhw9" target="_blank" rel="noopener" class="btn">
          Read reviews on Google
        </a>
      </div>
    </div>
  </section>


  <section class="section process" aria-labelledby="process-title">
    <div class="container"><div class="section-head"><span class="eyebrow">How care works</span><h2 id="process-title">A clear first step. A plan you understand.</h2></div>
      <ol class="process-grid" role="list"><li><span class="process-number" aria-hidden="true">1</span><h3>Book a virtual visit</h3><p>Choose a time in the booking system. You must be physically in Texas, Colorado, Florida, or Iowa for your visit.</p></li><li><span class="process-number" aria-hidden="true">2</span><h3>Review your options</h3><p>Discuss your history and goals with Liliana. Labs may be recommended when appropriate; treatment depends on individual evaluation.</p></li><li><span class="process-number" aria-hidden="true">3</span><h3>Agree on ongoing care</h3><p>Review what your plan includes, its cost, and follow-up before choosing a membership.</p></li></ol>
      <div class="visit-summary"><div><span class="eyebrow">Your first visit</span><h3>$199 consultation</h3><p>A $50 deposit is required at booking. Review the booking terms before confirming.</p></div><a href="/start/" class="btn btn--bronze">See booking details</a></div>
    </div>
  </section>
  <section class="section membership-summary">
    <div class="container"><div class="section-head"><span class="eyebrow">Ongoing care</span><h2>Compare the published plans.</h2><p class="lead">Memberships range from $99 to $499 per month. Medication, supplies, delivery, and labs are included only where expressly listed and clinically appropriate.</p></div>
      <ul class="programs" role="list">
        {programs.map((p) => (
          <li class:list={["program", p.featured && 'program--featured']}>
            <svg class="program__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PICON[p.icon]} />
            <span class="program__tier">{p.tier}</span>
            <h3 class="program__name">{p.name}</h3>
            <div class="program__price">
              <span class="program__price-amt">{p.price}</span>
              <span class="program__price-cad">{p.cadence}</span>
            </div>
            <p class="program__body">{p.body}</p>
            <a href={p.href} class="program__link">Learn more →</a>
          </li>
        ))}
      </ul>

      <p class="programs-terms">
        Individual results vary. Memberships include an initial 12-week commitment, then renew
        automatically every 30 days; cancel anytime after the first 12 weeks · <a href="/terms/">membership terms</a>.
      </p>

      <div class="programs-foot">
        <a href="/services/" class="btn">Compare all care &amp; pricing</a>
      </div>

    </div>
  </section>
  <section class="faq">
    <div class="container">
      <div class="faq__head">
        <span class="eyebrow">Common questions</span>
        <h2 class="faq__title">
          The questions I get most.
        </h2>
        <p class="lead">
          If yours is not here, send a non-clinical question or book a visit for
          an individual clinical discussion.
        </p>
      </div>

      <ul class="faq__list" role="list">
        {faqs.map((f, i) => (
          <li class="faq__item">
            <details>
              <summary class="faq__q">
                <span class="faq__q-text">{f.q}</span>
                <span class="faq__q-icon" aria-hidden="true">+</span>
              </summary>
              {f.aHtml ? <p class="faq__a" set:html={f.aHtml} /> : <p class="faq__a">{f.a}</p>}
            </details>
          </li>
        ))}
      </ul>

      <div class="faq__foot">
        <a href="/contact/" class="btn">Ask a non-clinical question</a>
      </div>
    </div>
  </section>


  <section class="section resources" aria-labelledby="resources-title"><div class="container"><div class="section-head"><span class="eyebrow">Read at your pace</span><h2 id="resources-title">Practical information for the next step.</h2></div><div class="resource-grid"><a href="/blog/the-parent-tax/"><h3>A health reset for busy caregivers</h3><p>Read The Parent Tax →</p></a><a href="/blog/concierge-telehealth-explained/"><h3>What concierge telehealth involves</h3><p>Understand the care model →</p></a><a href="/partners/"><h3>Viva Perks &amp; resources</h3><p>Explore partner resources and offers →</p></a></div></div></section>
  <section class="qx" id="quiz">
    <div class="container qx__inner">

      <div class="qx__head">
        <span class="eyebrow">Private, in-browser guide</span>
        <h2 class="qx__title" id="qx-title">
          Find your starting point.
        </h2>
        <p class="qx__intro">Optional, anonymous, and educational. You can book directly without completing this guide.</p>
        <div class="qx__meta">
          <span class="eyebrow" id="qx-step-label" role="status" aria-live="polite" aria-atomic="true">Question 1 of 3</span>
          <div class="qx__progress" aria-hidden="true">
            <div class="qx__progress-bar" id="qx-bar"></div>
          </div>
        </div>
      </div>

      {/* Step 1 */}
      <div class="qx__step is-active" data-step="1">
        <p class="qx__q" id="qx-q1" role="heading" aria-level="3" tabindex="-1">What feels most different right now?</p>
        <div class="qx__options" role="group" aria-labelledby="qx-q1">
          <button class="qx__opt" data-q="goal" data-v="weight"><span class="qx__opt-label">Weight or appetite feels harder to manage</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="goal" data-v="hormones"><span class="qx__opt-label">My energy, mood, or libido feels off</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="goal" data-v="recovery"><span class="qx__opt-label">I have questions about recovery and training</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="goal" data-v="longevity"><span class="qx__opt-label">I want to protect my health for the long term</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="goal" data-v="performance"><span class="qx__opt-label">I want better strength, performance, or body composition</span><span class="qx__opt-arrow">→</span></button>
        </div>
      </div>

      {/* Step 2 · preference, not a demographic or clinical intake question */}
      <div class="qx__step" data-step="2">
        <p class="qx__q" id="qx-q2" role="heading" aria-level="3" tabindex="-1">Which care path would you like to compare?</p>
        <div class="qx__options" role="group" aria-labelledby="qx-q2">
          <button class="qx__opt" data-q="path" data-v="menopause"><span class="qx__opt-label">Menopause or other hormone care</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="path" data-v="testosterone"><span class="qx__opt-label">Testosterone evaluation and follow-up</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="path" data-v="metabolic"><span class="qx__opt-label">Medical weight-management care</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="path" data-v="concierge"><span class="qx__opt-label">General concierge or recovery questions</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="path" data-v="unsure"><span class="qx__opt-label">I am not sure yet</span><span class="qx__opt-arrow">→</span></button>
        </div>
      </div>

      {/* Step 3 */}
      <div class="qx__step" data-step="3">
        <p class="qx__q" id="qx-q3" role="heading" aria-level="3" tabindex="-1">Which published monthly range would you like to compare?</p>
        <div class="qx__options" role="group" aria-labelledby="qx-q3">
          <button class="qx__opt" data-q="budget" data-v="b99"><span class="qx__opt-label">Up to $99 a month</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="budget" data-v="b199"><span class="qx__opt-label">Up to $199 a month</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="budget" data-v="b249"><span class="qx__opt-label">Up to $249 a month</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="budget" data-v="b349"><span class="qx__opt-label">Up to $349 a month</span><span class="qx__opt-arrow">→</span></button>
          <button class="qx__opt" data-q="budget" data-v="bmax"><span class="qx__opt-label">Show me every published tier</span><span class="qx__opt-arrow">→</span></button>
        </div>
      </div>

      {/* Step 4 · anonymous result */}
      <div class="qx__step" data-step="4" tabindex="-1">
        <span class="eyebrow">Your starting point</span>
        <h2 class="qx__result-title">
          A place to begin:<br/>
          <span id="qx-r-name">Viva Concierge</span>
        </h2>
        <div class="qx__result-card">
          <div class="qx__result-price">
            <span class="qx__result-amt" id="qx-r-price">$99</span>
            <span class="qx__result-cad">/mo</span>
          </div>
          <p class="qx__result-body" id="qx-r-body">A starting point based on your answers.</p>
