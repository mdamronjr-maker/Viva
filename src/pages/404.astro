---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const recent = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<Layout
  title="Page not found · Viva Wellness Co."
  description="The page you were looking for isn't here. Explore care and pricing, book a visit, or head back home."
  noindex={true}
>

  <section class="notfound">
    <div class="container notfound__inner">
      <span class="eyebrow">404</span>
      <h1 class="notfound__title">
        Page not found.
      </h1>
      <p class="lead">
        The link may have changed. Choose a destination below to continue.
      </p>

      <div class="notfound__cards">
        <a class="nf-card" href="/">
          <span class="nf-card__num">01</span>
          <span class="nf-card__title">Back to home</span>
          <span class="nf-card__desc">Start over from the top.</span>
        </a>
        <a class="nf-card nf-card--featured" href="/#quiz">
          <span class="nf-card__num">02</span>
          <span class="nf-card__title">Explore care options</span>
          <span class="nf-card__desc">Three questions, about a minute.</span>
        </a>
        <a class="nf-card" href="/services/">
          <span class="nf-card__num">03</span>
          <span class="nf-card__title">See programs</span>
          <span class="nf-card__desc">Explore care and pricing.</span>
        </a>
        <a class="nf-card" href="/contact/">
          <span class="nf-card__num">04</span>
          <span class="nf-card__title">Get in touch</span>
          <span class="nf-card__desc">Call, message, or email.</span>
        </a>
      </div>

      {recent.length > 0 && (
        <div class="nf-recent">
          <span class="eyebrow">Or read something useful</span>
          <ul class="nf-recent__list">
            {recent.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`} class="nf-recent__link">
                  <span class="nf-recent__cat">{p.data.category}</span>
                  <span class="nf-recent__title">{p.data.title}</span>
                  <span class="nf-recent__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

</Layout>

<style>
  .notfound { padding: var(--section-pad) 0; min-height: 65vh; }
  .notfound__title { font-size: var(--text-h1); line-height: 1.1; margin: .75rem 0 1rem; }
  .notfound__cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  .nf-card { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius); padding: 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  .nf-card:hover { border-color: var(--border-control); }
  .nf-card__num { font-size: .9375rem; color: var(--text-secondary); font-weight: 600; }
  .nf-card__title { font-size: 1.25rem; line-height: 1.3; font-weight: 600; }
  .nf-card__desc { font-size: 1rem; color: var(--text-secondary); line-height: 1.5; }
  .nf-recent { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-subtle); }
  .nf-recent .eyebrow { display: block; margin-bottom: 1.25rem; }
  .nf-recent__list { border-top: 1px solid var(--border-subtle); }
  .nf-recent__list li { border-bottom: 1px solid var(--border-subtle); }
  .nf-recent__link { display: grid; grid-template-columns: 180px minmax(0, 1fr) 24px; gap: 1.25rem; align-items: center; padding: 1.25rem 0; }
  .nf-recent__cat { font-size: .9375rem; color: var(--text-secondary); }
  .nf-recent__title { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .nf-recent__arrow { font-size: 1.25rem; }
  @media (max-width: 900px) { .notfound__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .nf-recent__link { grid-template-columns: minmax(0, 1fr) 24px; gap: .5rem; } .nf-recent__cat { grid-column: 1 / -1; } }
  @media (max-width: 400px) { .notfound__cards { grid-template-columns: 1fr; } }
</style>
