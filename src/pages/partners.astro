---
import Layout from '../layouts/Layout.astro';
import { partners, perks } from '../lib/partners';

const partnerCount = partners.length;

const partnersSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Austin Care and Wellness Directory',
      description: 'An Austin-area directory of physical therapy, training, fitness, recovery, and meal-prep resources outside Viva Wellness Co.’s telehealth scope.',
      url: 'https://vivawellnessco.com/partners/',
      isPartOf: { '@id': 'https://vivawellnessco.com/#organization' },
      about: partners.map((p) => ({
        '@type': 'LocalBusiness',
        name: p.name,
        description: p.description,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Austin',
          addressRegion: 'TX',
          addressCountry: 'US',
        },
        url: p.links[0]?.href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Partners', item: 'https://vivawellnessco.com/partners/' },
      ],
    },
  ],
};
---

<Layout
  title="Austin Care & Wellness Directory | Viva Wellness Co."
  description="Austin-area physical therapy, training, fitness, recovery, and meal-prep resources for needs outside Viva’s telehealth scope."
  schema={partnersSchema}
>

  {/* HERO */}
  <section class="partners-hero">
    <div class="container partners-hero__inner">
      <span class="eyebrow">Local resources · Austin</span>
      <h1 class="partners-hero__title">
        Care does not all happen<br/>
        <span class="italic-display">through a screen.</span>
      </h1>
      <p class="lead">
        Viva is a telehealth practice. This directory gives Austin-area patients
        a starting point for services that may require in-person facilities or
        hands-on care. Confirm fit, credentials, availability, and cost directly
        with each independent business.
      </p>
      <div class="partners-hero__meta">
        <span class="eyebrow">{partnerCount} partners · Austin, TX</span>
      </div>
    </div>
  </section>

  {/* HOW THIS WORKS · short strip framing the why */}
  <section class="how-strip">
    <div class="container how-strip__inner">
      <div class="how-strip__col">
        <h3 class="how-strip__title">Independent businesses</h3>
        <p class="how-strip__body">Directory listings are informational and do not make a business part of Viva. Ask each business about its services, credentials, privacy practices, and fees.</p>
      </div>
      <div class="how-strip__col">
        <h3 class="how-strip__title">A video visit can't do everything</h3>
        <p class="how-strip__body">Physical therapy, training, and facility-based services may require in-person evaluation. A listing here is not a clinical recommendation for every patient.</p>
      </div>
      <div class="how-strip__col">
        <h3 class="how-strip__title">Review before booking</h3>
        <p class="how-strip__body">Descriptions summarize available information and may change. Directory last reviewed September 5, 2026; verify current details with the business.</p>
      </div>
    </div>
  </section>

  {/* PARTNERS · single flat grid, no categories */}
  <section class="part-section">
    <div class="container">
      <header class="part-section__head">
        <span class="eyebrow">The directory</span>
        <h2 class="part-section__title">
          The directory.
        </h2>
      </header>

      <ul class="part-grid">
        {partners.map((p) => (
          <li class="part-card">
            <a
              href={p.links[0]?.href || '#'}
              target="_blank"
              rel="noopener"
              class="part-card__link"
              aria-label={p.name}
            >
              <div class="part-card__top">
                <div class="part-card__head">
                  <h3 class="part-card__name">{p.name}</h3>
                  <span class="part-card__operator">{p.operator}</span>
                </div>

                <span class="part-card__arrow" aria-hidden="true">↗</span>
              </div>

              <p class="part-card__body">{p.description}</p>

              {p.links.length > 0 && (
                <ul class="part-card__links">
                  {p.links.map((l) => (
                    <li>{l.label}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* VIVA PERKS · brand discount codes */}
  <section class="part-section" id="viva-perks">
    <div class="container">
      <header class="part-section__head">
        <span class="eyebrow">Viva Perks</span>
        <h2 class="part-section__title">
          Optional products and discounts.
        </h2>
        <p class="perks-lead">
          These independent products, services, links, and codes are optional
          and are not a condition of care. Any potential benefit to Viva is
          disclosed on the relevant card. Vendor availability and terms can change.
        </p>
      </header>

      <ul class="part-grid">
        {perks.map((p) => (
          <li class="part-card perk-card">
            {p.pending ? (
              <div class="part-card__link perk-card__static">
                <div class="part-card__top perk-card__top">
                  <div class="part-card__head">
                    <h3 class="part-card__name">{p.name}</h3>
                    <span class="part-card__operator">{p.pendingNote}</span>
                  </div>
                </div>
                <p class="part-card__body">{p.blurb}</p>
              </div>
            ) : (
              <div class="part-card__link perk-card__content">
                <div class="part-card__top perk-card__top">
                  <div class="part-card__head">
                    <h3 class="part-card__name">{p.name}</h3>
                    {p.reviewed && <span class="part-card__operator">{p.reviewed}</span>}
                  </div>
                </div>
                <p class="part-card__body">{p.blurb}</p>
                {p.offer && <p class="perk-offer">{p.offer}</p>}
                {p.code && (
                  <span class="perk-code">Code · <strong>{p.code}</strong></span>
                )}
                {p.links && p.links.length > 0 && (
                  <ul class="perk-card__actions" aria-label={`${p.name} links`}>
                    {p.links.map((link, index) => (
                      <li>
                        <a
                          href={link.href}
                          target="_blank"
                          rel={link.sponsored ? 'sponsored noopener' : 'noopener'}
                          class:list={['perk-link', { 'perk-link--primary': index === 0 }]}
                        >
                          {link.label}<span aria-hidden="true"> ↗</span>
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {p.relationshipDisclosure && (
                  <p class="perk-disclosure">{p.relationshipDisclosure}</p>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
      <p class="perks-note">
        Supplements are not a substitute for medical care. Review labels,
        allergens, possible interactions, and current vendor terms before purchasing.
      </p>
    </div>
  </section>

  {/* REFERRAL CTA */}
  <section class="part-cta">
    <div class="container part-cta__inner">
      <span class="eyebrow">For practitioners</span>
      <h2 class="part-cta__title">
        Run a practice<br/>
        we should know about?
      </h2>
      <p class="lead">
        If you run a licensed clinical practice or an established training or
        recovery business in Austin, you can send Viva a non-clinical note for
        directory consideration. Do not include patient information.
      </p>
      <div class="part-cta__ctas">
        <a href="/contact/" class="btn btn--bronze">Get in touch</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .partners-hero {
    background: var(--surface-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: var(--section-pad) 0 3rem;
    position: relative;
    overflow: hidden;
  }
  .partners-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    max-width: 1100px;
  }
  .partners-hero__title {
    font-size: var(--text-h1);
    line-height: 1.1;
    letter-spacing: -0.028em;
  }
  .partners-hero__meta { margin-top: 0.4rem; }

  /* HOW STRIP */
  .how-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-card);
    padding: clamp(2rem, 4vw, 3rem) 0;
  }
  .how-strip__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 800px) {
    .how-strip__inner { grid-template-columns: 1fr; gap: 0; }
  }
  .how-strip__col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  @media (max-width: 800px) {
    .how-strip__col {
      padding: 1.4rem 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .how-strip__col:first-child { padding-top: 0.2rem; }
    .how-strip__col:last-child { padding-bottom: 0.2rem; border-bottom: 0; }
  }
  .how-strip__num {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--text-primary);
  }
  .how-strip__title {
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .how-strip__body {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 38ch;
  }

  /* PARTNER SECTION */
  .part-section {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .part-section:last-of-type { border-bottom: 0; }
  .part-section__head {
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
    max-width: 800px;
  }
  .part-section__title {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.7rem 0 0;
  }

  /* PARTNER GRID · 2-up, expanded cards with description visible */
  .part-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 760px) { .part-grid { grid-template-columns: 1fr; } }

  .part-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
    transition: background 240ms var(--ease), border-color 240ms var(--ease);
  }
  .part-card:hover { background: var(--surface-card); border-color: var(--border-control); }

  .part-card__link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.4rem, 2.6vw, 1.8rem);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .part-card__top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.1rem;
    align-items: center;
  }
  @media (max-width: 540px) {
    .part-card__top {
      grid-template-columns: 1fr auto;
      gap: 0.95rem;
      align-items: center;
    }
  }

  .part-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }
  .part-card__cat {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-primary);
  }
  .part-card__name {
    font-family: var(--font-heading);
    font-style: normal;
    font-size: 1.375rem;
    line-height: 1.18;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin: 0.05rem 0;
  }
  @media (max-width: 540px) {
    .part-card__name { font-size: 1.375rem; }
  }
  .part-card__operator {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--text-secondary);
  }
  .part-card__body {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 58ch;
  }
  @media (max-width: 540px) {
    .part-card__body { font-size: 0.95rem; line-height: 1.55; }
  }
  .part-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .part-card__links li {
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    color: var(--text-secondary);
    padding-left: 0;
  }
  .part-card__links li::before { content: none; }

  .part-card__arrow {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: var(--text-primary);
    opacity: 0.55;
    transition: opacity 220ms var(--ease), transform 220ms var(--ease);
    align-self: start;
    padding-top: 0.1rem;
  }
  .part-card:hover .part-card__arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* VIVA PERKS */
  .perks-lead {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0.9rem 0 0;
  }
  .perk-card__top { grid-template-columns: 1fr auto; }
  .perk-card__content { height: 100%; }
  .perk-card__static { cursor: default; }
  .perk-offer {
    margin: 0;
    padding: 0.8rem 0.9rem;
    border-left: 3px solid var(--action-primary);
    background: var(--surface-subtle);
    color: var(--text-primary);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .perk-code {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-primary);
    border: 1px solid var(--border-control);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.7rem;
  }
  .perk-code strong { font-weight: 600; }
  .perk-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
  }
  .perk-card__actions li { display: flex; }
  .perk-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.7rem 1rem;
    border: 1px solid var(--text-primary);
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    transition: background 180ms var(--ease), color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .perk-link:hover {
    background: var(--text-primary);
    color: var(--text-inverse);
  }
  .perk-link--primary {
    background: var(--surface-inverse);
    border-color: var(--surface-inverse);
    color: var(--text-inverse);
  }
  .perk-link--primary:hover {
    background: var(--surface-inverse-hover);
    border-color: var(--surface-inverse-hover);
  }
  .perk-disclosure {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.45;
    max-width: 62ch;
  }
  .perks-note {
    margin: 1.1rem 0 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 72ch;
  }

  /* CTA */
  .part-cta {
    padding: var(--section-pad) 0;
    text-align: center;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--border-control);
    --focus-ring: var(--action-primary);
  }
  .part-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .part-cta__inner .lead { text-align: center; max-width: 56ch; color: var(--text-inverse); }
  .part-cta .eyebrow { color: var(--action-primary); }
  .part-cta__title {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0.4rem 0 0.4rem;
  }
  .part-cta__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.8rem;
  }
  @media (max-width: 720px) {
    .partners-hero { padding: 3rem 0 2.5rem; }
    .partners-hero__inner { gap: 1.25rem; }
    .partners-hero__title { font-size: var(--text-h1); }
    .how-strip { padding: 1.75rem 0; }
    .how-strip__col { padding: 1.1rem 0; }
    .part-section { padding: 2.75rem 0; }
    .part-card__link { gap: 0.8rem; padding: 1.25rem; }
    .perk-card__actions { display: grid; grid-template-columns: 1fr; }
    .perk-card__actions li,
    .perk-link { width: 100%; }
    .part-cta { padding: 3rem 0; }
  }
</style>
