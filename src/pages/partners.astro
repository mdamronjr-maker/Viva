---
import Layout from '../layouts/Layout.astro';
import { partners, perks } from '../lib/partners';

const partnerCount = partners.length;

const partnersSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Austin Care and Wellness Directory',
      description: 'An Austin-area directory of physical therapy, training, fitness, recovery, and meal-prep resources outside Viva Wellness Co.’s telehealth scope.',
      url: 'https://vivawellnessco.com/partners/',
      isPartOf: { '@id': 'https://vivawellnessco.com/#organization' },
      about: partners.map((p) => ({
        '@type': 'LocalBusiness',
        name: p.name,
        description: p.description,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Austin',
          addressRegion: 'TX',
          addressCountry: 'US',
        },
        url: p.links[0]?.href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Partners', item: 'https://vivawellnessco.com/partners/' },
      ],
    },
  ],
};
---

<Layout
  title="Austin Care & Wellness Directory | Viva Wellness Co."
  description="Austin-area physical therapy, training, fitness, recovery, and meal-prep resources for needs outside Viva’s telehealth scope."
  schema={partnersSchema}
>

  {/* HERO */}
  <section class="partners-hero">
    <div class="container partners-hero__inner">
      <span class="eyebrow">Local resources · Austin</span>
      <h1 class="partners-hero__title">
        Care does not all happen<br/>
        <span class="italic-display">through a screen.</span>
      </h1>
      <p class="lead">
        Viva is a telehealth practice. This directory gives Austin-area patients
        a starting point for services that may require in-person facilities or
        hands-on care. Confirm fit, credentials, availability, and cost directly
        with each independent business.
      </p>
      <div class="partners-hero__meta">
        <span class="eyebrow">{partnerCount} partners · Austin, TX</span>
      </div>
    </div>
  </section>

  {/* HOW THIS WORKS · short strip framing the why */}
  <section class="how-strip">
    <div class="container how-strip__inner">
      <div class="how-strip__col">
        <h3 class="how-strip__title">Independent businesses</h3>
        <p class="how-strip__body">Directory listings are informational and do not make a business part of Viva. Ask each business about its services, credentials, privacy practices, and fees.</p>
      </div>
      <div class="how-strip__col">
        <h3 class="how-strip__title">A video visit can't do everything</h3>
        <p class="how-strip__body">Physical therapy, training, and facility-based services may require in-person evaluation. A listing here is not a clinical recommendation for every patient.</p>
      </div>
      <div class="how-strip__col">
        <h3 class="how-strip__title">Review before booking</h3>
        <p class="how-strip__body">Descriptions summarize available information and may change. Directory last reviewed September 5, 2026; verify current details with the business.</p>
      </div>
    </div>
  </section>

  {/* PARTNERS · single flat grid, no categories */}
  <section class="part-section">
    <div class="container">
      <header class="part-section__head">
        <span class="eyebrow">The directory</span>
        <h2 class="part-section__title">
          The directory.
        </h2>
      </header>

      <ul class="part-grid">
        {partners.map((p) => (
          <li class="part-card">
            <a
              href={p.links[0]?.href || '#'}
              target="_blank"
              rel="noopener"
              class="part-card__link"
              aria-label={p.name}
            >
              <div class="part-card__top">
                <div class="part-card__head">
                  <h3 class="part-card__name">{p.name}</h3>
                  <span class="part-card__operator">{p.operator}</span>
                </div>

                <span class="part-card__arrow" aria-hidden="true">↗</span>
              </div>

              <p class="part-card__body">{p.description}</p>

              {p.links.length > 0 && (
                <ul class="part-card__links">
                  {p.links.map((l) => (
                    <li>{l.label}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* VIVA PERKS · brand discount codes */}
  <section class="part-section" id="viva-perks">
    <div class="container">
      <header class="part-section__head">
        <span class="eyebrow">Viva Perks</span>
        <h2 class="part-section__title">
          Optional products and discounts.
        </h2>
        <p class="perks-lead">
          These links and codes are optional and are not a condition of care.
          Discount terms can change. Some referral links or codes may provide a
          benefit to Viva; confirm current terms with the vendor before purchasing.
        </p>
      </header>

      <ul class="part-grid">
        {perks.map((p) => (
          <li class="part-card perk-card">
            {p.pending ? (
              <div class="part-card__link perk-card__static">
                <div class="part-card__top perk-card__top">
                  <div class="part-card__head">
                    <h3 class="part-card__name">{p.name}</h3>
                    <span class="part-card__operator">{p.pendingNote}</span>
                  </div>
                </div>
                <p class="part-card__body">{p.blurb}</p>
              </div>
            ) : (
              <a
                href={p.href}
                target="_blank"
                rel="noopener"
                class="part-card__link"
                aria-label={p.name}
              >
                <div class="part-card__top perk-card__top">
                  <div class="part-card__head">
                    <h3 class="part-card__name">{p.name}</h3>
                    {p.linkLabel && <span class="part-card__operator">{p.linkLabel}</span>}
                  </div>
                  <span class="part-card__arrow" aria-hidden="true">↗</span>
                </div>
                <p class="part-card__body">{p.blurb}</p>
                {p.code && (
                  <span class="perk-code">Code · <strong>{p.code}</strong></span>
                )}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* REFERRAL CTA */}
  <section class="part-cta">
    <div class="container part-cta__inner">
      <span class="eyebrow">For practitioners</span>
      <h2 class="part-cta__title">
        Run a practice<br/>
        we should know about?
      </h2>
      <p class="lead">
        If you run a licensed clinical practice or an established training or
        recovery business in Austin, you can send Viva a non-clinical note for
        directory consideration. Do not include patient information.
      </p>
      <div class="part-cta__ctas">
        <a href="/contact/" class="btn btn--bronze">Get in touch</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .partners-hero {
    background: var(--sky);
    border-bottom: 1px solid var(--rule);
    padding: clamp(4.5rem, 14vw, 10rem) 0 clamp(2.5rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }
  .partners-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .partners-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    max-width: 1100px;
  }
  .partners-hero__title {
    font-size: clamp(2.7rem, 9.5vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  .partners-hero__meta { margin-top: 0.4rem; }

  /* HOW STRIP */
  .how-strip {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink-2);
    padding: clamp(2rem, 4vw, 3rem) 0;
  }
  .how-strip__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 800px) {
    .how-strip__inner { grid-template-columns: 1fr; gap: 0; }
  }
  .how-strip__col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  @media (max-width: 800px) {
    .how-strip__col {
      padding: 1.4rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .how-strip__col:first-child { padding-top: 0.2rem; }
    .how-strip__col:last-child { padding-bottom: 0.2rem; border-bottom: 0; }
  }
  .how-strip__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--bronze);
  }
  .how-strip__title {
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--paper);
    letter-spacing: -0.01em;
  }
  .how-strip__body {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 38ch;
  }

  /* PARTNER SECTION */
  .part-section {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .part-section:last-of-type { border-bottom: 0; }
  .part-section__head {
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
    max-width: 800px;
  }
  .part-section__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0.7rem 0 0;
  }

  /* PARTNER GRID · 2-up, expanded cards with description visible */
  .part-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @media (max-width: 760px) { .part-grid { grid-template-columns: 1fr; } }

  .part-card {
    background: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    overflow: hidden;
    transition: background 240ms var(--ease), border-color 240ms var(--ease);
  }
  .part-card:hover { background: var(--ink-2); border-color: var(--butter-deep); }

  .part-card__link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.4rem, 2.6vw, 1.8rem);
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }
  .part-card__top {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.1rem;
    align-items: center;
  }
  @media (max-width: 540px) {
    .part-card__top {
      grid-template-columns: 1fr auto;
      gap: 0.95rem;
      align-items: center;
    }
  }

  .part-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }
  .part-card__cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
  }
  .part-card__name {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 1.32rem;
    line-height: 1.18;
    color: var(--paper);
    letter-spacing: -0.01em;
    margin: 0.05rem 0;
  }
  @media (max-width: 540px) {
    .part-card__name { font-size: 1.18rem; }
  }
  .part-card__operator {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--mute);
  }
  .part-card__body {
    color: rgba(28, 35, 27, 0.78);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 58ch;
  }
  @media (max-width: 540px) {
    .part-card__body { font-size: 0.95rem; line-height: 1.55; }
  }
  .part-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .part-card__links li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: rgba(28, 35, 27, 0.7);
    padding-left: 0;
  }
  .part-card__links li::before { content: none; }

  .part-card__arrow {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--bronze);
    opacity: 0.55;
    transition: opacity 220ms var(--ease), transform 220ms var(--ease);
    align-self: start;
    padding-top: 0.1rem;
  }
  .part-card:hover .part-card__arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  /* VIVA PERKS */
  .perks-lead {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0.9rem 0 0;
  }
  .perk-card__top { grid-template-columns: 1fr auto; }
  .perk-card__static { cursor: default; }
  .perk-code {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bronze-bright, var(--bronze));
    border: 1px solid var(--butter-deep);
    border-radius: 2px;
    padding: 0.35rem 0.7rem;
  }
  .perk-code strong { letter-spacing: 0.16em; }

  /* CTA */
  .part-cta {
    padding: clamp(4rem, 9vw, 8rem) 0;
    text-align: center;
    background: var(--evergreen);
    color: var(--cream-bright);
    position: relative;
    overflow: hidden;
    border-top: 6px solid var(--terracotta);
  }
  .part-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .part-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .part-cta__inner .lead { text-align: center; max-width: 56ch; color: rgba(255, 253, 248, 0.82); }
  .part-cta .eyebrow { color: var(--ochre); }
  .part-cta__title {
    font-size: clamp(1.9rem, 4.8vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0.4rem 0 0.4rem;
  }
  .part-cta__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.8rem;
  }
</style>
