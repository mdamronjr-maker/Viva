---
import Layout from '../layouts/Layout.astro';

/* ============================================================
   /menopause · perimenopause and menopause care landing page.
   The SEO anchor for the practice's women's-hormone vertical:
   FAQPage schema, keyword-bearing headings, internal links to
   HRT management on /services and the booking flow on /start.
   Copy rules: Liliana's first-person voice, no em or en dashes
   (use the site-standard interpunct), no outcome guarantees.
   ============================================================ */

const symptoms = [
  { name: 'Hot flashes & night sweats', body: 'Common vasomotor symptoms that can disrupt work, sleep, and daily life.' },
  { name: 'Sleep changes', body: 'Trouble falling asleep, waking often, or feeling unrefreshed deserves a broader review of possible causes.' },
  { name: 'Concentration changes', body: 'Word-finding or focus changes can occur during the transition, but they are not specific to menopause.' },
  { name: 'Mood shifts', body: 'Irritability, anxiety, or low mood may overlap with hormonal change, stress, sleep, and other health factors.' },
  { name: 'Weight or body-composition change', body: 'Midlife changes are multifactorial. Hormone therapy is not a stand-alone weight-loss treatment.' },
  { name: 'Sexual-health concerns', body: 'Changes in desire, comfort, or response are valid reasons for a private, individualized conversation.' },
  { name: 'Irregular or heavy cycles', body: 'Cycle changes are common in perimenopause; new, very heavy, or concerning bleeding needs appropriate evaluation.' },
  { name: 'Joint, skin, or hair changes', body: 'These concerns can have many causes. A clinical review helps decide what belongs in the same picture.' },
];

const steps = [
  {
    num: '01',
    title: 'History and goals first',
    body: 'Liliana reviews your symptoms, cycle pattern, medical and family history, current medications, and priorities. Menopause is often identified clinically; testing is ordered when it can inform a decision or monitoring plan.',
  },
  {
    num: '02',
    title: 'Options explained in context',
    body: 'You review potential benefits, limitations, routes, and alternatives. FDA-approved products are considered when available; a compounded preparation is discussed only for an identified patient-specific need and is clearly labeled as not FDA-approved.',
  },
  {
    num: '03',
    title: 'A shared decision',
    body: 'No page, symptom list, or lab value guarantees treatment. If care is appropriate and you choose to proceed, the plan is documented and clinical messages move through the secure patient portal.',
  },
  {
    num: '04',
    title: 'Follow-up matched to the plan',
    body: 'Follow-up considers symptom response, side effects, changing risks, preventive care, and any monitoring appropriate to the medication. Treatment can be adjusted or stopped when the balance changes.',
  },
];

const faqs = [
  {
    q: 'What is the difference between perimenopause and menopause?',
    a: 'Perimenopause is the transition leading up to menopause and can involve cycle and symptom changes. Menopause is identified after twelve consecutive months without a menstrual period when another cause does not explain it. You can ask for an evaluation before periods stop; the right evaluation and options depend on your history.',
  },
  {
    q: 'Can I get perimenopause or menopause treatment online?',
    a: 'Viva provides telehealth visits to adults who are physically located in Texas, Colorado, Florida, or Iowa at the time of care. Whether labs, an in-person exam, a retail prescription, or pharmacy delivery is part of the next step depends on the individual evaluation and applicable requirements.',
  },
  {
    q: 'Do I need labs before starting hormone therapy?',
    a: 'Not every menopause decision depends on a hormone panel. Liliana first reviews symptoms, cycle history, health history, medications, and preventive-care needs, then orders testing when it can answer a relevant question or support safe monitoring. The exact requirements can vary by treatment.',
  },
  {
    q: 'Is hormone replacement therapy safe?',
    a: 'Menopausal hormone therapy can be effective for certain symptoms, but there is no single safety answer for everyone. Age, time since menopause, symptom burden, medical and family history, route, dose, and personal preferences affect the benefit-risk discussion. Some people should use a nonhormonal option or obtain additional evaluation. The first visit is for that individualized review.',
  },
  {
    q: 'What hormones do you actually prescribe?',
    a: 'There is no standard Viva hormone formula. After evaluation, Liliana may discuss FDA-approved hormonal or nonhormonal options and, when a documented patient-specific need cannot be met by an available FDA-approved drug, a compounded preparation. Compounded drugs are not FDA-approved, and FDA does not review their safety, effectiveness, or quality before dispensing.',
  },
  {
    q: 'Can HRT help with midlife weight gain?',
    a: 'Hormone therapy is not prescribed as a stand-alone weight-loss treatment. Midlife weight change can involve sleep, activity, nutrition, medications, health conditions, and body-composition changes. If weight is a primary concern, it should receive its own evaluation rather than being attributed to hormones automatically.',
  },
  {
    q: 'What does menopause care cost at Viva?',
    a: 'The first visit is $199, a one-time fee. Ongoing HRT management starts with Viva Concierge Access at $99 per month. Compounded estradiol and progesterone are available as clinician-selected add-ons and are not included in the membership fee. Eligible retail prescriptions and labs can be routed through insurance.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vivawellnessco.com/' },
        { '@type': 'ListItem', position: 2, name: 'Menopause Care', item: 'https://vivawellnessco.com/menopause/' },
      ],
    },
  ],
};
---

<Layout
  title="Online Menopause Care in TX, CO, FL & IA | Viva"
  description="Telehealth evaluation for perimenopause and menopause symptoms with Liliana Damron, APRN, FNP-BC. Available to adults in Texas, Colorado, Florida, and Iowa."
  schema={faqSchema}
>

  {/* HERO */}
  <section class="meno-hero">
    <div class="container meno-hero__inner">
      <span class="eyebrow">Telehealth · TX · CO · FL · IA</span>
      <h1 class="meno-hero__title">
        Your hormones changed.<br/>
        <span class="italic-display">Your care should too.</span>
      </h1>
      <p class="lead">
        Perimenopause and menopause symptoms can collide with work, parenting,
        sleep, and the rest of an already full life. I'm Liliana Damron, a
        board-certified nurse practitioner. I start with your history and goals,
        explain reasonable options, and stay involved when ongoing care is appropriate.
      </p>
      <div class="meno-hero__ctas">
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=menopause_page" class="btn btn--bronze">Book your first visit</a>
        <a href="/#quiz" class="btn meno-hero__btn-quiet">Use the care-path guide</a>
      </div>
    </div>
  </section>

  {/* SYMPTOMS */}
  <section class="meno-symptoms">
    <div class="container">
      <header class="meno-head">
        <span class="eyebrow">Sound familiar?</span>
        <h2 class="meno-head__title">
          Symptoms worth evaluating, not self-diagnosing.
        </h2>
      </header>
      <ul class="meno-grid">
        {symptoms.map((s) => (
          <li class="meno-cell">
            <h3 class="meno-cell__name">{s.name}</h3>
            <p class="meno-cell__body">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* HOW I TREAT IT */}
  <section class="meno-steps">
    <div class="container">
      <header class="meno-head">
        <span class="eyebrow">The approach</span>
        <h2 class="meno-head__title">
          How a menopause evaluation works.
        </h2>
      </header>
      <ol class="meno-steps__list">
        {steps.map((s) => (
          <li class="meno-step">
            <span class="meno-step__num">{s.num}</span>
            <div>
              <h3 class="meno-step__title">{s.title}</h3>
              <p class="meno-step__body">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* REVIEW PULLQUOTE */}
  <div class="container meno-quote-wrap">
    <figure class="meno-quote">
      <blockquote class="pullquote">Lili has been an exceptional provider throughout my wellness treatment journey. From our very first consultation, she truly understood my needs. She carefully listened as I explained my symptoms.</blockquote>
      <figcaption class="caption">Priscilla Moraes · <a href="https://www.google.com/maps/place/Viva+Wellness+Co./@30.448506,-93.3099761,5366828m/data=!3m2!1e3!4b1!4m6!3m5!1s0x838a2a09b2fa0069:0x23603b7d6308b72a!8m2!3d30.448506!4d-93.309976!16s%2Fg%2F11x1q1jhw9" target="_blank" rel="noopener">verified Google review</a></figcaption>
    </figure>
  </div>

  {/* TIERS */}
  <section class="meno-tiers">
    <div class="container">
      <header class="meno-head">
        <span class="eyebrow">How ongoing care works</span>
        <h2 class="meno-head__title">
          Management first. Medication added when appropriate.
        </h2>
      </header>
      <div class="meno-tiers__row">
        <a href="/services/#viva-concierge-access" class="meno-tier">
          <span class="meno-tier__tag">Management membership</span>
          <h3 class="meno-tier__name">Viva Concierge Access</h3>
          <p class="meno-tier__price"><strong>$99</strong>/mo</p>
          <p class="meno-tier__body">
            Provider-led HRT management, a monthly evaluation, dosing guidance,
            and direct provider access. Medication is handled separately.
          </p>
          <span class="meno-tier__cta">See what's included →</span>
        </a>
        <a href="/services/#viva-concierge-access" class="meno-tier">
          <span class="meno-tier__tag">Medication add-ons</span>
          <h3 class="meno-tier__name">Compounded HRT medication</h3>
          <p class="meno-tier__price"><strong>Added separately</strong></p>
          <p class="meno-tier__body">
            Compounded estradiol and progesterone are selected individually when
            clinically appropriate. They are not included in the $99 membership fee.
          </p>
          <span class="meno-tier__cta">See HRT options →</span>
        </a>
      </div>
      <p class="meno-tiers__note">
        First visit is $199, one time, separate from any membership. You decide
        about enrolling after the visit, on your own time.
      </p>
    </div>
  </section>

  {/* SOURCES */}
  <section class="meno-sources" aria-labelledby="meno-sources-title">
    <div class="container meno-sources__inner">
      <div>
        <span class="eyebrow">Evidence and medication context</span>
        <h2 class="meno-head__title" id="meno-sources-title">Read the source, not just the claim.</h2>
      </div>
      <ul>
        <li><a href="https://www.fda.gov/consumers/womens-health-topics/menopause" target="_blank" rel="noopener">FDA menopause overview</a></li>
        <li><a href="https://menopause.org/patient-education/menopause-topics/hormone-therapy" target="_blank" rel="noopener">The Menopause Society on hormone therapy</a></li>
        <li><a href="https://www.fda.gov/drugs/human-drug-compounding/compounding-and-fda-questions-and-answers" target="_blank" rel="noopener">FDA questions and answers on compounding</a></li>
      </ul>
      <p>This page is general education. It does not diagnose a symptom, establish eligibility, or recommend a medication.</p>
    </div>
  </section>

  {/* FAQ */}
  <section class="meno-faq">
    <div class="container">
      <header class="meno-head">
        <span class="eyebrow">Questions</span>
        <h2 class="meno-head__title">
          Perimenopause & menopause, asked and answered.
        </h2>
      </header>
      <div class="meno-faq__list">
        {faqs.map((f) => (
          <details class="meno-faq__item">
            <summary class="meno-faq__q">{f.q}</summary>
            <p class="meno-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="meno-cta">
    <div class="container meno-cta__inner">
      <span class="eyebrow">Start here</span>
      <h2 class="meno-cta__title">
        You don't have to push through it.
      </h2>
      <p class="lead">
        Three anonymous questions can help you compare Viva's published care
        paths. They do not assess eligibility. You can also book the first visit directly.
      </p>
      <div class="meno-cta__ctas">
        <a href="/start/?utm_source=vivawellnessco&utm_medium=cta&utm_content=menopause_cta" class="btn btn--bronze">Book your first visit</a>
        <a href="/#quiz" class="btn meno-hero__btn-quiet">Use the care-path guide</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* HERO */
  .meno-hero {
    background: var(--sky);
    border-bottom: 1px solid var(--rule);
    padding: clamp(4.5rem, 14vw, 10rem) 0 clamp(2.5rem, 6vw, 5rem);
    position: relative;
    overflow: hidden;
  }
  .meno-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .meno-hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    max-width: 1100px;
  }
  .meno-hero__title {
    font-size: clamp(2.7rem, 9.5vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  .meno-hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .meno-hero__btn-quiet {
    background: transparent;
    border: 1px solid #fff;
    color: #fff;
  }
  .meno-hero__btn-quiet:hover { background: #fff; border-color: #fff; color: var(--paper); }

  .meno-quote-wrap { padding: clamp(2rem, 4vw, 3rem) var(--gutter); }
  .meno-quote { margin: 0; display: flex; flex-direction: column; gap: 0.7rem; }

  /* SECTION HEADS */
  .meno-head { margin-bottom: clamp(1.6rem, 3vw, 2.4rem); max-width: 800px; }
  .meno-head__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0.7rem 0 0;
  }

  /* SYMPTOMS */
  .meno-symptoms {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--ink-2);
  }
  .meno-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 1000px) { .meno-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .meno-grid { grid-template-columns: 1fr; } }
  /* deliberately uneven grid: the most-treated cluster gets the wide cell */
  .meno-grid li:first-child { grid-column: span 2; }
  @media (max-width: 540px) { .meno-grid li:first-child { grid-column: auto; } }
  .meno-cell {
    background: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 1.3rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .meno-cell__name {
    font-size: 1rem;
    line-height: 1.3;
    color: var(--paper);
    letter-spacing: -0.01em;
  }
  .meno-cell__body {
    color: rgba(28, 35, 27, 0.72);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0;
  }

  /* STEPS */
  .meno-steps { padding: clamp(3rem, 7vw, 5rem) 0; }
  .meno-steps__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 860px;
  }
  .meno-step {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1.1rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .meno-step:last-child { border-bottom: 0; }
  .meno-step__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--bronze);
    padding-top: 0.25rem;
  }
  .meno-step__title {
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--paper);
    letter-spacing: -0.01em;
    margin: 0 0 0.35rem;
  }
  .meno-step__body {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }

  /* TIERS */
  .meno-tiers {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-top: 1px solid var(--rule);
    background: var(--ink-2);
  }
  .meno-tiers__row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @media (max-width: 760px) { .meno-tiers__row { grid-template-columns: 1fr; } }
  .meno-tier {
    background: var(--ink);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 2.6vw, 1.8rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background 240ms var(--ease), border-color 240ms var(--ease);
  }
  .meno-tier:hover { background: var(--ink-2); border-color: var(--butter-deep); }
  .meno-tier__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
  }
  .meno-tier__name {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--paper);
    margin: 0;
  }
  .meno-tier__price {
    font-size: 1rem;
    color: var(--paper);
    margin: 0;
  }
  .meno-tier__price strong { font-size: 1.6rem; letter-spacing: -0.02em; }
  .meno-tier__body {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }
  .meno-tier__cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-top: 0.4rem;
  }
  .meno-tiers__note {
    margin: 1.2rem 0 0;
    color: var(--mute);
    font-size: 0.88rem;
    max-width: 60ch;
  }

  .meno-sources {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-top: 1px solid var(--rule);
    background: var(--sky);
  }
  .meno-sources__inner { display: grid; gap: 1.2rem; max-width: 900px; }
  .meno-sources__inner ul { display: grid; gap: 0.7rem; padding-left: 1.2rem; }
  .meno-sources__inner a { color: var(--paper); text-decoration: underline; text-underline-offset: 0.22em; }
  .meno-sources__inner p { color: var(--paper-2); max-width: 68ch; }

  /* FAQ */
  .meno-faq { padding: clamp(3rem, 7vw, 5rem) 0; border-top: 1px solid var(--rule); }
  .meno-faq__list { max-width: 860px; }
  .meno-faq__item { border-bottom: 1px solid var(--rule); }
  .meno-faq__q {
    cursor: pointer;
    padding: 1.1rem 0;
    font-size: 1.05rem;
    color: var(--paper);
    letter-spacing: -0.01em;
    list-style: none;
    position: relative;
    padding-right: 2rem;
  }
  .meno-faq__q::-webkit-details-marker { display: none; }
  .meno-faq__q::after {
    content: '+';
    position: absolute;
    right: 0.2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--bronze);
    font-family: var(--font-mono);
  }
  .meno-faq__item[open] .meno-faq__q::after { content: '·'; }
  .meno-faq__a {
    color: rgba(28, 35, 27, 0.75);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 1.2rem;
    max-width: 68ch;
  }

  /* CTA */
  .meno-cta {
    background: var(--evergreen);
    color: var(--cream-bright);
    padding: clamp(4rem, 9vw, 8rem) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-top: 6px solid var(--terracotta);
  }
  .meno-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* bronze glow removed in p2 */
    pointer-events: none;
  }
  .meno-cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .meno-cta__inner .lead { text-align: center; max-width: 56ch; color: rgba(255, 253, 248, 0.82); }
  .meno-cta .eyebrow { color: var(--ochre); }
  .meno-cta__title {
    font-size: clamp(1.9rem, 4.8vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0.4rem 0;
  }
  .meno-cta__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.8rem;
  }
</style>
